---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// 全站統一版型。每頁只需提供 metadata，<head> 樣板、導覽列、頁尾、
// 分析碼一律在這裡集中宣告。
interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  currentSection?: string | null;
  bodyClass?: string;
}
const {
  title,
  description,
  keywords,
  ogTitle = title,
  ogDescription = description,
  ogImage = 'https://thc1006.github.io/sch001-108platform/picture/thumbnail.png',
  currentSection = null,
  bodyClass = 'bg-gray-50 text-gray-800',
} = Astro.props;

// canonical 與 og:url 直接用 Astro.url.pathname。build.format 是 'preserve'，Astro 7.2.0 起
// pathname 已經對應實際輸出的檔案：一般頁面以 .html 結尾，區段首頁（foo/index.astro）與
// 站台首頁是目錄式網址，不必自己補 .html（#133）。
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// 網站的 AI 功能呼叫的本地 LLM 閘道（public/shared/platform-ai.js 從這個 meta 讀）。
// 由建置環境的 PUBLIC_AI_GATEWAY_URL 決定，CI 從 repository variable AI_GATEWAY_URL 帶入，
// 網址不寫進 repo。沒設定時不輸出，AI 功能（PlatformAI.runTask）會回報「尚未設定」。
// 網址合不合格、是否與建置時的設定一致由 check:site 把關。
const aiGatewayUrl = (import.meta.env.PUBLIC_AI_GATEWAY_URL ?? '').trim();

// <html> 的 scroll-pt-20：header 高 64px，焦點移動與錨點捲動時元素停在它下方 16px，不被它蓋住。
---

<!doctype html>
<html lang="zh-Hant" class="scroll-smooth scroll-pt-20">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WZGCGHZ5FK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-WZGCGHZ5FK');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <!-- 基礎 SEO -->
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="台灣教育處方籤團隊" />
    <link rel="canonical" href={canonical} />
    {aiGatewayUrl && <meta name="ai-gateway-url" content={aiGatewayUrl} />}

    <!-- 社群分享 (Open Graph) -->
    <meta property="og:site_name" content="高中生 108 課綱教育資源整合平台" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter 分享卡片 -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 字體 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans+TC:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- 結構化資料 (JSON-LD) -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: '高中生 108 課綱教育資源整合平台',
        alternateName: '台灣教育處方籤',
        url: 'https://thc1006.github.io/sch001-108platform/',
        description:
          '一個專為108課綱高中生設計的學習路徑導航手冊，提供自主學習、學習歷程、生涯探索的指引、工具與範例，旨在弭平城鄉教育資訊落差。',
        publisher: {
          '@type': 'Organization',
          name: '高中生 108 課綱教育資源整合平台',
          alternateName: '台灣教育處方籤',
          url: 'https://thc1006.github.io/sch001-108platform/',
          sameAs: ['https://www.facebook.com/profile.php?id=61589942915673'],
        },
      })}
    />

    <!-- 頁面可注入額外的 <head> 內容(如頁面專屬 JSON-LD) -->
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <!-- 無障礙:跳至主要內容(鍵盤聚焦時才顯示) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:rounded-lg focus:bg-blue-600 focus:px-4 focus:py-2 focus:text-white"
      >跳至主要內容</a
    >
    <Header currentSection={currentSection} />
    <slot />
    <Footer />

    <!-- 手機上讓 sticky 篩選面板在向下捲動時讓開畫面。
         沒有 [data-autohide-filters] 的頁面會直接 return，不做任何事。 -->
    <script is:inline defer src={`${base}/shared/sticky-filters.js`}></script>

    <!-- GoatCounter 流量統計 -->
    <script
      is:inline
      data-goatcounter="https://sch001.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"></script>
  </body>
</html>
