---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// 字型策略（<head> 裡刻意沒有任何字型 <link>）：
//   拉丁字＝自架的 Inter 子集，以 @font-face 寫在 global.css，隨頁面 CSS 一起送達，
//   不多一次往返；漢字＝使用者裝置上既有的系統字型（見 global.css 的 body 堆疊）。
//   原本的 Google Fonts 樣式表是阻塞渲染的第三方請求，實測首頁要下載 1,240KB 字型、
//   佔整頁傳輸量 73.5%，而且其中幾乎全部是漢字。改法與重現方式見 perf/fonts.md。
//   也刻意不加 rel=preload —— 實測 preload 會跟阻塞渲染的 CSS 搶頻寬，FCP 反而變差。
//   這段說明放在 frontmatter 而不是 HTML 註解：Astro 會把 <!-- --> 原樣輸出到 94 個頁面。

// 全站統一版型。每頁只需提供 metadata,<head> 樣板、導覽列、頁尾、
// 分析碼一律由此集中宣告 —— 取代先前每頁各自重複又不一致的 <head>/nav/footer。
interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  currentSection?: string | null;
  bodyClass?: string;
}
const {
  title,
  description,
  keywords,
  ogTitle = title,
  ogDescription = description,
  ogImage = 'https://thc1006.github.io/sch001-108platform/picture/thumbnail.png',
  currentSection = null,
  bodyClass = 'bg-gray-50 text-gray-800',
} = Astro.props;

// canonical / og:url —— 直接用 Astro.url.pathname,不再自己補 .html。
//
// Astro 6 時期 build.format:'preserve' 下 pathname 給的是「路由路徑」
// (/…/competitions/),指到 GitHub Pages 上不存在的網址,所以這裡曾有一段把非
// .html 結尾的路徑補上 .html 的修補,並用 isSectionIndex 這個 prop 把區段首頁
// (foo/index.astro,要維持目錄式網址)排除在外。
//
// Astro 7.2.0 起上游已修正,pathname 就是實際輸出的檔案路徑。實測方式:在這裡把
// 每一頁的 pathname 與轉換結果印出來建一次,93 頁裡 76 頁本來就以 .html 結尾、
// 16 頁是區段首頁、1 頁是站台首頁,那段 if 一次都沒進去,轉換次數 0。既然分支永遠
// 走不到,連同只為它存在的 isSectionIndex prop(及 7 個呼叫端)一併移除,免得留下
// 一段不會執行、註解還跟現況相反的程式碼。移除前後全站 94 頁的 canonical 與
// og:url 逐字比對 0 差異。
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="zh-Hant" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WZGCGHZ5FK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-WZGCGHZ5FK');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <!-- 基礎 SEO -->
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="台灣教育處方籤團隊" />
    <link rel="canonical" href={canonical} />

    <!-- 社群分享 (Open Graph) -->
    <meta property="og:site_name" content="高中生 108 課綱教育資源整合平台" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 結構化資料 (JSON-LD) -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: '高中生 108 課綱教育資源整合平台',
        alternateName: '台灣教育處方籤',
        url: 'https://thc1006.github.io/sch001-108platform/',
        description:
          '一個專為108課綱高中生設計的學習路徑導航手冊，提供自主學習、學習歷程、生涯探索的指引、工具與範例，旨在弭平城鄉教育資訊落差。',
        publisher: {
          '@type': 'Organization',
          name: '高中生 108 課綱教育資源整合平台',
          alternateName: '台灣教育處方籤',
          url: 'https://thc1006.github.io/sch001-108platform/',
          sameAs: ['https://www.facebook.com/profile.php?id=61589942915673'],
        },
      })}
    />

    <!-- 頁面可注入額外的 <head> 內容(如頁面專屬 JSON-LD) -->
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <!-- 無障礙:跳至主要內容(鍵盤聚焦時才顯示) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:rounded-lg focus:bg-blue-600 focus:px-4 focus:py-2 focus:text-white"
      >跳至主要內容</a
    >
    <Header currentSection={currentSection} />
    <slot />
    <Footer />

    <!-- 手機上讓 sticky 篩選面板在向下捲動時讓開畫面。
         沒有 [data-autohide-filters] 的頁面會直接 return，不做任何事。 -->
    <script is:inline defer src={`${base}/shared/sticky-filters.js`}></script>

    <!-- GoatCounter 流量統計 -->
    <script
      is:inline
      data-goatcounter="https://sch001.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"></script>
  </body>
</html>
