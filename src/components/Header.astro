---
// 全站統一導覽列。
// currentSection 標記目前所在區段,用來套用 active 樣式(全站一致)。
interface Props {
  currentSection?: string | null;
}
const { currentSection = null } = Astro.props;
// BASE_URL 可能帶或不帶尾斜線(視 Astro 版本/設定而定),統一去尾後自補 '/'。
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const navItems = [
  { key: 'autonomous-learning', label: '自主學習', href: `${base}/autonomous-learning/index.html` },
  { key: 'learning-portfolio', label: '學習歷程', href: `${base}/learning-portfolio/index.html` },
  { key: 'career-exploration', label: '生涯探索', href: `${base}/career-exploration/index.html` },
  { key: 'advanced-resources', label: '進階資源', href: `${base}/advanced-resources/index.html` },
  { key: 'about', label: '關於我們', href: `${base}/about.html` },
];
// 選項就是這一頁才用 aria-current="page"；只是在同一區段（例如學群頁之於生涯探索）用 "true"。
const pagePath = (p: string) => p.replace(/(\/index)?\.html$|\/$/, '');
const samePage = (href: string) => pagePath(href) === pagePath(Astro.url.pathname);
const current = (item: (typeof navItems)[number]) =>
  item.key === currentSection ? (samePage(item.href) ? 'page' : 'true') : undefined;
---

<header class="bg-white/80 backdrop-blur-sm shadow-sm sticky top-0 z-50">
  <nav class="container mx-auto px-6 py-4 flex justify-between items-center">
    <div class="text-2xl font-bold text-blue-600">
      <a href={`${base}/index.html`}>台灣教育處方籤</a>
    </div>

    {/* 桌機選單。768～1023px 的版心只有 720px，選項間距 32px 時站名和選單只隔 8px，所以 lg 以下用 24px。 */}
    <div class="hidden md:flex space-x-6 lg:space-x-8 items-center font-semibold">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={current(item)}
          class:list={[
            'transition duration-300',
            item.key === currentSection
              ? 'text-blue-600 font-bold'
              : 'text-gray-600 hover:text-blue-500',
          ]}
        >{item.label}</a>
      ))}
    </div>

    <!-- 手機漢堡鈕 -->
    <button
      id="nav-toggle"
      type="button"
      class="md:hidden text-gray-600 hover:text-blue-500"
      aria-label="開啟導覽選單"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- 手機選單(預設收合)。header 是 sticky，視窗矮的時候選單要能在自己裡面捲動，不然後面的選項到不了。 -->
  <div id="mobile-menu" tabindex="-1" class="hidden md:hidden max-h-[calc(100dvh-4rem)] overflow-y-auto scroll-pt-20 border-t border-gray-100 bg-white">
    {navItems.map((item) => (
      <a
        href={item.href}
        aria-current={current(item)}
        class:list={[
          'block px-6 py-3 font-semibold border-b border-gray-50',
          item.key === currentSection
            ? 'text-blue-600 bg-blue-50'
            : 'text-gray-600 hover:text-blue-500 hover:bg-gray-50',
        ]}
      >{item.label}</a>
    ))}
  </div>
</header>

<script>
  // 手機選單開合
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const close = () => {
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
  };
  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(isHidden === false));
  });
  const header = toggle?.closest('header');
  // 焦點在頁首裡時，Esc 收合選單；焦點在選單裡的話移回漢堡鈕，不然焦點會留在隱藏的連結上。
  // 焦點在別處時不處理，那裡的 Esc 可能是取消 AI 任務或清除搜尋。輸入法選字中的 Esc 也不處理。
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || e.isComposing || e.keyCode === 229) return;
    if (!menu || menu.classList.contains('hidden') || !header?.contains(document.activeElement)) return;
    // 開著的對話框蓋在選單上面，這一下是要關對話框。
    if (document.querySelector('dialog[open]')) return;
    // 這次按鍵用掉了，其他看 defaultPrevented 的 Esc 處理就跳過。在捕獲階段處理，比掛在 document 或
    // window 冒泡階段的處理先跑。
    e.preventDefault();
    const inMenu = menu.contains(document.activeElement);
    close();
    if (inMenu) toggle?.focus();
  }, true);
  // 焦點移到選單和漢堡鈕以外的地方時收合，展開的選單不會蓋住焦點所在的內容。
  header?.addEventListener('focusout', (e) => {
    const next = e.relatedTarget;
    if (next instanceof Node && !header.contains(next)) close();
  });
  // 視窗放大跨過 md 斷點時收合選單並重置狀態,避免桌機版殘留展開狀態、
  // 以及 aria-expanded 與實際可見性脫節。
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) close();
  });
</script>
