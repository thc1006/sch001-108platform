---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="主題書單推薦 - 台灣教育處方籤"
  description="為高中生精選的十二大主題書單，涵蓋人文社會、科學科普、AI 科技、哲學思辨等領域，附推薦理由與標籤，協助規劃自主學習與探索。"
  currentSection="advanced-resources"
  bodyClass="bg-gray-100 text-gray-800"
>
    <!-- Main Content -->
    <main id="main-content" class="container mx-auto px-6 py-12">
        <!-- Page Hero Section -->
        <section class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
                主題書單<span class="gradient-text">推薦</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
                閱讀經典，是與偉大心靈對話的最佳方式。我們依十二大主題，為你精選各領域必讀好書。
            </p>
        </section>

        <!-- Filters -->
        <section class="mb-12 sticky top-[68px] z-40 bg-gray-100/80 backdrop-blur-sm py-4" data-autohide-filters>
            <div class="bg-white p-4 rounded-xl shadow-md">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="search-input" class="font-bold text-gray-700 text-sm">關鍵字搜尋</label>
                        <input type="text" id="search-input" placeholder="書名、作者、標籤……" class="w-full mt-1 p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                    </div>
                    <div>
                        <label for="theme-filter" class="font-bold text-gray-700 text-sm">主題分類</label>
                        <select id="theme-filter" class="w-full mt-1 p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 bg-white">
                            <option value="all">全部主題</option>
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <!-- Reading Lists Section -->
        <section id="reading-lists-container" class="space-y-16">
            <!-- Reading lists will be injected here -->
        </section>

        <!-- Empty / error state -->
        <div id="no-results" class="hidden text-center py-16">
            <svg class="mx-auto h-12 w-12 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">找不到符合的書籍</h3>
            <p class="mt-1 text-sm text-gray-500">試著調整關鍵字或主題篩選條件。</p>
        </div>
    </main>

    <script is:inline>
        // 書單資料改由同目錄的 reading-list.json 載入（見頁尾的 loadBooks）。
        // 要新增或修改書目，請編輯 reading-list.json，不需要動這支 HTML。
        let themesData = [];

        // 將資料欄位安全地嵌入 innerHTML（避免含特殊字元的 JSON 破版或注入）。
        function escapeHtml(value) {
            return String(value).replace(/[&<>"']/g, (c) => (
                { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
            ));
        }

        // 以書名文字產生的封面佔位圖（書封缺漏時的 onerror fallback）。
        // 採自包含的 inline SVG（data URI），不依賴任何外部服務，離線與封鎖外網時皆可正常顯示。
        function placeholderCover(title) {
            // 將書名折成多行，避免長書名超出佔位圖寬度。
            const raw = String(title).slice(0, 36);
            const perLine = 8;
            const lines = [];
            for (let i = 0; i < raw.length; i += perLine) {
                lines.push(raw.slice(i, i + perLine));
            }
            const startY = 220 - (lines.length - 1) * 16;
            const tspans = lines.map((line, idx) =>
                `<tspan x="150" y="${startY + idx * 32}">${escapeHtml(line)}</tspan>`
            ).join('');
            const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="300" height="440" viewBox="0 0 300 440">`
                + `<rect width="300" height="440" fill="#ede9fe"/>`
                + `<rect x="12" y="12" width="276" height="416" fill="none" stroke="#c4b5fd" stroke-width="2"/>`
                + `<text x="150" y="64" font-family="'PingFang TC','Microsoft JhengHei UI','Microsoft JhengHei','Noto Sans TC','Noto Sans CJK TC','Source Han Sans TC',sans-serif" font-size="13" fill="#a78bfa" text-anchor="middle">書封準備中</text>`
                + `<text font-family="'PingFang TC','Microsoft JhengHei UI','Microsoft JhengHei','Noto Sans TC','Noto Sans CJK TC','Source Han Sans TC',sans-serif" font-size="22" font-weight="bold" fill="#6d28d9" text-anchor="middle">${tspans}</text>`
                + `</svg>`;
            return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
        }

        const container = document.getElementById('reading-lists-container');
        const noResultsDiv = document.getElementById('no-results');
        const searchInput = document.getElementById('search-input');
        const themeFilter = document.getElementById('theme-filter');

        function renderBooks() {
            const searchTerm = searchInput.value.trim().toLowerCase();
            const selectedTheme = themeFilter.value;

            container.innerHTML = '';
            let totalShown = 0;

            themesData.forEach((theme) => {
                if (selectedTheme !== 'all' && theme.theme !== selectedTheme) {
                    return;
                }

                const matchedBooks = (theme.books || []).filter((book) => {
                    if (!searchTerm) return true;
                    const corpus = `${book.title || ''} ${book.original_title || ''} ${book.author || ''} ${(book.tags || []).join(' ')}`.toLowerCase();
                    return corpus.includes(searchTerm);
                });

                if (matchedBooks.length === 0) {
                    return;
                }
                totalShown += matchedBooks.length;

                const section = document.createElement('section');
                section.className = 'theme-block';

                let booksHtml = '';
                matchedBooks.forEach((book) => {
                    let tagsHtml = '';
                    (book.tags || []).forEach((tag) => {
                        tagsHtml += `<span class="inline-block bg-indigo-100 text-indigo-800 text-xs font-medium mr-2 mb-2 px-2.5 py-0.5 rounded-full">${escapeHtml(tag)}</span>`;
                    });

                    const isbn = String(book.isbn || '');
                    const coverSrc = encodeURI(`img/books/${isbn}.jpg`);
                    const fallback = placeholderCover(book.title || '書籍');

                    const originalTitleHtml = book.original_title
                        ? `<p class="text-xs text-gray-400 italic mb-1">${escapeHtml(book.original_title)}</p>`
                        : '';

                    booksHtml += `
                        <div class="book-card bg-white rounded-lg shadow-md overflow-hidden flex flex-col">
                            <div class="bg-gray-100 flex items-center justify-center p-3">
                                <img src="${coverSrc}" alt="《${escapeHtml(book.title || '')}》封面" loading="lazy" class="h-56 w-auto object-contain rounded shadow-sm" onerror="this.onerror=null;this.src='${fallback}';">
                            </div>
                            <div class="p-4 flex-grow flex flex-col">
                                <h4 class="font-bold text-lg text-gray-900 mb-1">${escapeHtml(book.title || '')}</h4>
                                ${originalTitleHtml}
                                <p class="text-sm text-purple-600 font-semibold mb-2">${escapeHtml(book.author || '')}</p>
                                <p class="text-sm text-gray-700 flex-grow">${escapeHtml(book.recommendation || '')}</p>
                                <div class="mt-4">
                                    ${tagsHtml}
                                </div>
                            </div>
                        </div>
                    `;
                });

                section.innerHTML = `
                    <div class="mb-6">
                        <h2 class="text-2xl md:text-3xl font-bold text-gray-800">${escapeHtml(theme.theme || '')}</h2>
                        <p class="text-gray-600 mt-2">${escapeHtml(theme.description || '')}</p>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                        ${booksHtml}
                    </div>
                `;
                container.appendChild(section);
            });

            if (totalShown === 0) {
                noResultsDiv.classList.remove('hidden');
            } else {
                noResultsDiv.classList.add('hidden');
            }
        }

        searchInput.addEventListener('input', renderBooks);
        themeFilter.addEventListener('change', renderBooks);

        // 以資料驅動方式產生主題篩選器選項。
        function populateThemeFilter() {
            themesData.forEach((theme) => {
                if (!theme.theme) return;
                const option = document.createElement('option');
                option.value = theme.theme;
                option.textContent = theme.theme;
                themeFilter.appendChild(option);
            });
        }

        // 從 reading-list.json 載入書單資料後再渲染。
        async function loadBooks() {
            try {
                const response = await fetch('reading-list.json', { cache: 'no-cache' });
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }
                const data = await response.json();
                themesData = Array.isArray(data.themes) ? data.themes : [];
                populateThemeFilter();
                renderBooks();
            } catch (error) {
                console.error('書單資料載入失敗：', error);
                container.innerHTML = '';
                noResultsDiv.classList.remove('hidden');
                noResultsDiv.querySelector('h3').textContent = '書單資料載入失敗';
                noResultsDiv.querySelector('p').textContent = '請稍後重新整理頁面，或回報網站管理員。';
            }
        }

        loadBooks();
    </script>

    <style is:global>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'PingFang TC', 'Microsoft JhengHei UI', 'Microsoft JhengHei', 'Noto Sans TC', 'Noto Sans CJK TC', 'Source Han Sans TC', sans-serif;
        }
        .gradient-text {
            background: -webkit-linear-gradient(45deg, #6366f1, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .book-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .book-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        }
    </style>
</BaseLayout>
