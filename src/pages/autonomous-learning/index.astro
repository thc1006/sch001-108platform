---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="自主學習 - 台灣教育處方籤"
  description="AI 學習啟動包，以及找主題、擬計畫、找資源、學研究方法四個步驟的專頁。"
  currentSection="autonomous-learning"
  bodyClass="bg-gray-100 text-gray-800"
>
    <!-- 主要內容 -->
    <main id="main-content" class="container mx-auto px-6 py-12">
        <!-- 主視覺 -->
        <section class="text-center mb-16">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
                自主<span class="gradient-text">學習</span>
            </h1>
        </section>

        <!-- AI 學習啟動包 -->
        <section class="bg-white p-8 rounded-xl shadow-lg mb-16">
             <h2 class="text-2xl font-bold mb-2">AI 學習啟動包</h2>
             <p class="text-gray-600 mb-6">輸入一個初步的想法，AI 會把它聚焦成具體的主題，附 3 個可以開始探索的問題和 3 種適合的資源類型。</p>
             <div class="flex flex-col sm:flex-row gap-3">
                <input type="text" id="coachInput" maxlength="200" aria-label="你的初步想法" class="w-full px-4 py-3 border border-gray-500 rounded-lg focus:outline-hidden focus:ring-2 focus:ring-blue-500" placeholder="例如：我想研究跟「貓咪」有關的主題...">
                <button id="generateCoachBtn" class="w-full sm:w-auto bg-blue-600 text-white font-bold py-3 px-8 rounded-lg hover:bg-blue-700 transition duration-300 flex items-center justify-center space-x-2 flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    <span>產生啟動包</span>
                </button>
            </div>
            {/* 結果有標題與清單，整段放進 live region 會被唸成一長串、聽不出結構，所以結果區不是 live region。
                結果的摘要與各種訊息改由 #coachStatus 唸，它載入時就在、一開始是空的，之後寫入的才會被唸出來。
                進度區塊有自己的 status，也不能放進 live region：WebKit 連 aria-live="off" 子樹的變化也會唸。 */}
            <div class="mt-6">
                <div id="coachProgress"></div>
                <p id="coachStatus" role="status" class="sr-only"></p>
                <div id="coachResult"></div>
            </div>
        </section>

        <!-- 自主學習四步驟 -->
        <section>
            <h2 class="text-2xl font-bold text-center mb-8">自主學習四步驟</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- 步驟 1 -->
                <a href="topic-ideas.html" class="step-card block bg-white p-6 rounded-xl shadow-lg">
                    <div class="flex items-center mb-4">
                        <span class="flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-600 font-bold text-xl mr-4">1</span>
                        <h3 class="text-xl font-bold">靈感探索</h3>
                    </div>
                    <p class="text-gray-600 text-sm">請 AI 依興趣發想，或從社會議題、靈感矩陣和 SDGs 找研究主題。</p>
                </a>
                <!-- 步驟 2 -->
                <a href="plan-templates.html" class="step-card block bg-white p-6 rounded-xl shadow-lg">
                    <div class="flex items-center mb-4">
                        <span class="flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-600 font-bold text-xl mr-4">2</span>
                        <h3 class="text-xl font-bold">計畫擬定</h3>
                    </div>
                    <p class="text-gray-600 text-sm">參考計畫範本，或請 AI 草擬一份 8 週的學習計畫。</p>
                </a>
                <!-- 步驟 3 -->
                <a href="resource-map.html" class="step-card block bg-white p-6 rounded-xl shadow-lg">
                    <div class="flex items-center mb-4">
                        <span class="flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-600 font-bold text-xl mr-4">3</span>
                        <h3 class="text-xl font-bold">資源蒐集</h3>
                    </div>
                    <p class="text-gray-600 text-sm">請 AI 排出學習步驟，或依類型和學科篩選學習資源。</p>
                </a>
                <!-- 步驟 4 -->
                <a href="methodology.html" class="step-card block bg-white p-6 rounded-xl shadow-lg">
                    <div class="flex items-center mb-4">
                        <span class="flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-600 font-bold text-xl mr-4">4</span>
                        <h3 class="text-xl font-bold">方法學習</h3>
                    </div>
                    <p class="text-gray-600 text-sm">文獻探討、問卷、訪談等 6 種研究方法的步驟和常見陷阱。</p>
                </a>
            </div>
        </section>

        <!-- 嵌入的影片資源 -->
        <section class="mt-16">
             <h2 class="text-2xl font-bold text-center mb-8">聽聽專家怎麼說</h2>
             <div class="max-w-4xl mx-auto bg-white p-4 rounded-xl shadow-lg">
                 <div class="aspect-w-16 aspect-h-9">
                     <iframe src="https://www.youtube.com/embed/4w6ytmFCi7g?si=fD1vuNWBpxv37Vbx" title="YouTube 影片：未來大學論壇，談彈性學制" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen class="w-full h-full rounded-lg"></iframe>
                 </div>
                 <div class="p-4">
                     <h3 class="font-bold text-lg">延伸觀點：未來大學論壇「彈性學制——學習的多重樣貌」</h3>
                     <p class="text-sm text-gray-600 mt-1">這是一場關於彈性學制的論壇分享（出自臺灣大學 EDU 頻道），探討當學習不再侷限於單一路徑時，可能呈現的多元樣貌。可作為你思考自主學習方向的延伸素材。</p>
                 </div>
             </div>
        </section>
    </main>

    <script is:inline src="../shared/platform-ai.js"></script>
    <script is:inline>
        // 「學習啟動包」由 AI 閘道的 starter-pack 任務產生：prompt 與輸出格式都在閘道
        // （ai-gateway/src/task-catalog.mjs），驗證過才交給這裡。頁面只送學生的初步想法、
        // 顯示進度與結果
        const generateCoachBtn = document.getElementById('generateCoachBtn');
        const coachInput = document.getElementById('coachInput');
        const coachProgress = document.getElementById('coachProgress');
        const coachResult = document.getElementById('coachResult');
        // 結果區不是 live region，要唸的話用 announce 寫進這裡。
        const coachStatus = document.getElementById('coachStatus');
        let announceTimer = 0;
        // 先清空，約 100 毫秒後才寫入：同一句連著出現兩次（例如連按兩次「請先輸入」）時，第二次
        // 也會被唸出來。text 是空字串時只清空。
        function announce(text) {
            clearTimeout(announceTimer);
            coachStatus.textContent = '';
            if (text) announceTimer = setTimeout(() => { coachStatus.textContent = text; }, 100);
        }
        const coachBtnLabel = generateCoachBtn.querySelector('span');
        // platform-ai.js 沒載入成功（404、被擋）時，PlatformAI 不存在，連 describeError 都沒有，
        // 就退回這一句；字句與 describeError 對未知錯誤的說法相同
        const FALLBACK_ERROR_TEXT = '抱歉，AI 服務發生錯誤，請稍後再試。';

        function showMessage(text, tone = 'error') {
            coachResult.textContent = '';
            const p = document.createElement('p');
            // red-500 對白底只有 3.8:1，不到 WCAG 對一般文字要求的 4.5:1
            p.className = (tone === 'error' ? 'text-red-700' : 'text-gray-600') + ' text-center';
            p.textContent = text;
            coachResult.appendChild(p);
            announce(text);
        }

        generateCoachBtn.addEventListener('click', async () => {
            if (generateCoachBtn.getAttribute('aria-disabled') === 'true') return;
            const topic = coachInput.value.trim();
            if (!topic) {
                showMessage('請先輸入你的初步想法。');
                return;
            }

            // 雙擊防護：進行中停用按鈕；要中途停止用進度區塊裡的「取消」。
            // 停用靠 aria-disabled：disabled 的按鈕會失去焦點，鍵盤使用者的焦點就掉回 <body>。
            // 只換按鈕裡的文字，圖示留著。
            const originalLabel = coachBtnLabel.textContent;
            generateCoachBtn.setAttribute('aria-disabled', 'true');
            generateCoachBtn.classList.add('opacity-50', 'cursor-not-allowed');
            coachBtnLabel.textContent = '產生中…';
            coachResult.textContent = '';
            announce('');

            const controller = new AbortController();
            // mountProgress 也要在 try 裡面：PlatformAI 不存在時它會丟 ReferenceError，放在 try 外面
            // 就走不到 finally，按鈕會永遠卡在「產生中…」。所以 catch 裡的 progress 可能還是 null
            let progress = null;
            try {
                progress = PlatformAI.mountProgress(coachProgress, {
                    onCancel: () => controller.abort(),
                    focusTarget: generateCoachBtn,
                    // 焦點在這一區（輸入框、按鈕、結果）時按 Esc 等於按取消
                    escapeScope: generateCoachBtn.closest('section'),
                });
                const { result } = await PlatformAI.runTask('starter-pack', { topic }, {
                    signal: controller.signal,
                    onProgress: progress.update,
                });
                progress.finish();
                displayAIStarterPack(result);
                announce(`已產生學習啟動包，共 ${result.research_questions.length} 個探索問題。`);
            } catch (error) {
                if (progress) progress.finish();
                const text = typeof PlatformAI === 'undefined' ? FALLBACK_ERROR_TEXT : PlatformAI.describeError(error);
                showMessage(text, error && error.name === 'AbortError' ? 'info' : 'error');
            } finally {
                generateCoachBtn.removeAttribute('aria-disabled');
                generateCoachBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                coachBtnLabel.textContent = originalLabel;
            }
        });

        function displayAIStarterPack(data) {
            // 清空容器
            coachResult.textContent = '';

            const container = document.createElement('div');
            container.className = 'bg-blue-50 border-l-4 border-blue-500 p-6 rounded-r-lg prose max-w-none';

            // 建議主題方向（AI 純文字，可能含 markdown）
            // PlatformAI.renderMarkdown() 先 HTML escape 再套 markdown，故 innerHTML 安全。
            // 結果在這一區的 h2 底下，小標題用 h3。prose 給 h3 的字比 h4 大、間距也不同，
            // 這些 class 讓它看起來和 prose 的 h4 一樣；第一個標題的上方間距由 prose 歸零
            const H3_AS_H4 = 'text-[1em] leading-[1.5] mb-[0.5em]';
            const topicTitle = document.createElement('h3');
            topicTitle.className = H3_AS_H4;
            topicTitle.textContent = '建議主題方向';
            // renderMarkdown 的輸出可能有清單與標題，用 <div>；下方的間距是 prose 給 <p> 的
            const topicText = document.createElement('div');
            topicText.className = 'mb-[1.25em]';
            topicText.innerHTML = PlatformAI.renderMarkdown(data.suggested_topic, { headingLevel: 4 });

            // 探索問題標題
            const questionsTitle = document.createElement('h3');
            questionsTitle.className = H3_AS_H4 + ' mt-[1.5em]';
            questionsTitle.textContent = '你可以從這幾個問題開始探索：';

            // 問題列表
            const questionsList = document.createElement('ul');
            questionsList.className = 'list-disc list-inside';
            // 探索問題為 AI 純文字，可能含 markdown；renderMarkdown 先 escape 後渲染。
            data.research_questions.forEach(q => {
                const li = document.createElement('li');
                li.innerHTML = PlatformAI.renderMarkdown(q, { inline: true });
                questionsList.appendChild(li);
            });

            // 資源類型標題
            const resourcesTitle = document.createElement('h3');
            resourcesTitle.className = H3_AS_H4 + ' mt-[1.5em]';
            resourcesTitle.textContent = '建議尋找的資源類型：';

            // 資源標籤容器
            const resourcesContainer = document.createElement('div');
            resourcesContainer.className = 'flex flex-wrap';
            data.resource_types.forEach(r => {
                const span = document.createElement('span');
                span.className = 'inline-block bg-blue-100 text-blue-800 text-sm font-medium mr-2 mb-2 px-2.5 py-1 rounded-full';
                span.textContent = r;
                resourcesContainer.appendChild(span);
            });

            // 下一步提示
            const nextStep = document.createElement('p');
            nextStep.className = 'mt-4 text-sm';
            nextStep.textContent = '接著可以到「';
            const link1 = document.createElement('a');
            link1.href = 'topic-ideas.html';
            link1.className = 'font-semibold text-blue-600 hover:underline';
            link1.textContent = '主題靈感產生器';
            nextStep.appendChild(link1);
            nextStep.appendChild(document.createTextNode('」或「'));
            const link2 = document.createElement('a');
            link2.href = 'resource-map.html';
            link2.className = 'font-semibold text-blue-600 hover:underline';
            link2.textContent = '學習資源地圖';
            nextStep.appendChild(link2);
            nextStep.appendChild(document.createTextNode('」。'));

            // 組裝所有元素
            container.appendChild(topicTitle);
            container.appendChild(topicText);
            container.appendChild(questionsTitle);
            container.appendChild(questionsList);
            container.appendChild(resourcesTitle);
            container.appendChild(resourcesContainer);
            container.appendChild(nextStep);

            coachResult.appendChild(container);
        }
    </script>

  <style is:global>
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
        }
        .step-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .step-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        }
  </style>
</BaseLayout>
