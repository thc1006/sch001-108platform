---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="研究方法工具箱 - 台灣教育處方籤"
  description="6 種研究方法的適用情境、步驟和常見陷阱，回答幾個問題可以篩出適合的方法。"
  currentSection="autonomous-learning"
  bodyClass="bg-gray-100 text-gray-800"
>
    <!-- 主要內容 -->
    <main id="main-content" class="container mx-auto px-6 py-12">
        <!-- 主視覺 -->
        <section class="text-center mb-16">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
                研究方法<span class="gradient-text">工具箱</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
                6 種研究方法的適用情境、步驟和常見陷阱。
            </p>
        </section>

        <!-- 互動式研究方法推薦 -->
        <section class="bg-white p-8 rounded-xl shadow-lg mb-16">
            <h2 class="text-2xl font-bold mb-2">我該用哪種方法？</h2>
            <p class="text-gray-600 mb-6">回答一到三個問題，就會依你的答案列出適合的研究方法。</p>
            <div class="space-y-6">
                <fieldset>
                    <legend class="font-semibold">1. 你的研究主要是想了解「人們的想法或經驗」嗎？</legend>
                    <div class="flex gap-4 mt-2">
                        <button onclick="recommendMethod('qualitative')" class="bg-orange-700 text-white font-bold py-2 px-6 rounded-lg hover:bg-orange-800 transition">是</button>
                        <button onclick="recommendMethod('other1')" class="bg-gray-200 text-gray-700 py-2 px-6 rounded-lg hover:bg-gray-300 transition">否</button>
                    </div>
                </fieldset>
                 <fieldset class="hidden" id="q2" tabindex="-1">
                    <legend class="font-semibold">2. 你的研究主要是想驗證「數字或數據」的關係嗎？</legend>
                    <div class="flex gap-4 mt-2">
                        <button onclick="recommendMethod('quantitative')" class="bg-orange-700 text-white font-bold py-2 px-6 rounded-lg hover:bg-orange-800 transition">是</button>
                        <button onclick="recommendMethod('other2')" class="bg-gray-200 text-gray-700 py-2 px-6 rounded-lg hover:bg-gray-300 transition">否</button>
                    </div>
                </fieldset>
                 <fieldset class="hidden" id="q3" tabindex="-1">
                    <legend class="font-semibold">3. 你的研究主要是想「創造出一個作品」嗎？</legend>
                    <div class="flex gap-4 mt-2">
                        <button onclick="recommendMethod('creative')" class="bg-orange-700 text-white font-bold py-2 px-6 rounded-lg hover:bg-orange-800 transition">是</button>
                        <button onclick="recommendMethod('other3')" class="bg-gray-200 text-gray-700 py-2 px-6 rounded-lg hover:bg-gray-300 transition">不完全是</button>
                    </div>
                </fieldset>
            </div>
            <div id="recommendation-result" role="status" class="mt-6"></div>
        </section>

        <!-- 研究方法卡片網格 -->
        <section>
            <h2 class="text-2xl font-bold text-center mb-8">所有研究方法</h2>
            <div id="methodology-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- 方法卡片由 renderMethods() 填入 -->
            </div>
        </section>
    </main>

    <!-- 研究方法詳情對話框 -->
    <dialog id="methodModal" aria-labelledby="modal-title" class="modal-content bg-white text-inherit w-11/12 max-w-none md:max-w-3xl m-auto rounded-lg shadow-lg overflow-y-auto outline outline-transparent open:flex flex-col">
        <!-- 對話框內容由 showModal() 填入 -->
    </dialog>

    <script is:inline src="../shared/detail-dialog.js"></script>
    <script is:inline>
        // 資料從同目錄的 methodology.json 載入（見下方 loadData）。
        // 要新增或修改資料，請編輯 methodology.json，不需要動這支 HTML。
        let methodsData = [];

        function escapeHtml(value) {
            return String(value).replace(/[&<>"']/g, (c) => (
                { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
            ));
        }

        const q2 = document.getElementById('q2');
        const q3 = document.getElementById('q3');
        const recommendationResult = document.getElementById('recommendation-result');

        function recommendMethod(answer) {
            let recommendedTypes = [];
            let resultText = '';

            switch(answer) {
                case 'qualitative':
                    recommendedTypes = ['qualitative'];
                    resultText = '聽起來你的研究偏向「質化」，建議你從以下方法著手：';
                    break;
                case 'quantitative':
                    recommendedTypes = ['quantitative'];
                    resultText = '聽起來你的研究偏向「量化」，建議你從以下方法著手：';
                    break;
                case 'creative':
                    recommendedTypes = ['creative'];
                    resultText = '聽起來你的研究偏向「創作實踐」，建議你從以下方法著手：';
                    break;
                // 下一題出現在按鈕下方，焦點移過去，報讀器才會念出題目。
                case 'other1':
                    q2.classList.remove('hidden');
                    q2.focus();
                    return;
                case 'other2':
                    q3.classList.remove('hidden');
                    q3.focus();
                    return;
                case 'other3':
                    recommendedTypes = ['other3'];
                    resultText = '你的研究不完全屬於質化、量化或創作實踐，建議你從以下方法著手：';
                    break;
            }

            const recommendedMethods = methodsData.filter(m => m.type.some(t => recommendedTypes.includes(t)));
            // 每個方法一個 <li>，報讀器念 role="status" 的內容時，方法名稱才不會連成一串。
            let methodsHtml = recommendedMethods.map(m => `<li><button type="button" onclick="showModal('${escapeHtml(m.id)}', this)" class="bg-orange-100 text-orange-800 font-semibold py-2 px-4 rounded-lg hover:bg-orange-200 transition">${escapeHtml(m.title)}</button></li>`).join('');

            recommendationResult.innerHTML = `
                <div class="bg-orange-50 p-4 rounded-lg">
                    <p class="font-semibold">${escapeHtml(resultText)}</p>
                    <ul class="flex flex-wrap gap-3 mt-3">${methodsHtml}</ul>
                </div>
            `;
        }

        const grid = document.getElementById('methodology-grid');
        const modal = document.getElementById('methodModal');
        const detail = DetailDialog.setup(modal);

        function renderMethods() {
            grid.innerHTML = '';
            methodsData.forEach(method => {
                const card = document.createElement('div');
                card.className = 'method-card bg-white p-6 rounded-xl shadow-lg cursor-pointer flex flex-col';
                card.innerHTML = `
                    <div class="flex-grow">
                        <span class="text-sm font-bold text-orange-700">${escapeHtml(method.category)}</span>
                        <h3 class="text-2xl font-bold mt-2 mb-3"><button type="button" class="text-left cursor-pointer">${escapeHtml(method.title)}</button></h3>
                        <p class="text-gray-600">${escapeHtml(method.description)}</p>
                    </div>
                    <div class="mt-4 pt-4 border-t border-gray-200 text-right">
                        <span class="text-blue-600 font-semibold" aria-hidden="true">查看詳情 &rarr;</span>
                    </div>
                `;
                // 整張卡片都可以點；鍵盤和螢幕閱讀器用標題的按鈕，按下時一樣冒泡到這裡。
                const button = card.querySelector('h3 button');
                card.onclick = () => showModal(method.id, button);
                grid.appendChild(card);
            });
        }

        function showModal(id, opener) {
            const method = methodsData.find(m => m.id === id);
            if (!method) return;

            modal.innerHTML = `
                <div class="p-6 border-b flex justify-between items-start">
                    <div>
                        <p class="text-sm font-bold text-orange-700">${escapeHtml(method.category)}</p>
                        <h3 id="modal-title" class="text-2xl font-bold">${escapeHtml(method.title)}</h3>
                    </div>
                    <button type="button" onclick="hideModal()" aria-label="關閉" class="-mr-2 px-2 rounded text-gray-500 hover:text-gray-800 text-3xl">&times;</button>
                </div>
                <div class="p-6 overflow-y-auto flex-grow">
                    ${method.content_html}
                </div>
            `;
            detail.open(opener);
        }

        function hideModal() {
            detail.close();
        }

        // 從 methodology.json 載入資料後再渲染
        async function loadData() {
            try {
                const response = await fetch('methodology.json', { cache: 'no-cache' });
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }
                const data = await response.json();
                methodsData = Array.isArray(data.methods) ? data.methods : [];
                renderMethods();
            } catch (error) {
                console.error('資料載入失敗：', error);
                const grid = document.getElementById('methodology-grid');
                if (grid) {
                    grid.innerHTML = '<p class="col-span-full text-center text-gray-500 py-16">資料載入失敗，請稍後重新整理頁面。</p>';
                }
            }
        }
        loadData();
    </script>

  <style is:global>
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
        }
        .method-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .method-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        }
        .modal-content::backdrop {
            background-color: rgba(0, 0, 0, 0.6);
        }
        .modal-content {
            max-height: 90vh;
        }
        .prose ul > li::before {
            background-color: #f97316;
        }
        /* 訪談法的提示詞範例放在 blockquote。typography 預設把引用排成斜體、字重 500，前後再加上引號，
           中文沒有斜體字形，瀏覽器會硬斜；加上去的引號看起來也像提示詞的一部分。 */
        .prose blockquote {
            font-style: normal;
            font-weight: 400;
        }
        .prose blockquote p::before,
        .prose blockquote p::after {
            content: none;
        }
  </style>
</BaseLayout>
