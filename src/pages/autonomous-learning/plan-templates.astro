        function escapeHtml(value) {
            return String(value).replace(/[&<>"']/g, (c) => (
                { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
            ));
        }

        const templateGrid = document.getElementById('template-grid');
        const modal = document.getElementById('templateModal');
        const detail = DetailDialog.setup(modal);
        const filters = document.querySelector('[aria-label="依分類篩選"]');
        const resultStatus = document.getElementById('result-status');
        // 筆數只在使用者改了條件之後念，第一次載入不念；打字時停 400 毫秒再念。
        let shownCount = 0;
        let countTimer;
        function announceCount(delay = 0) {
            clearTimeout(countTimer);
            countTimer = setTimeout(() => { resultStatus.textContent = `顯示 ${shownCount} 筆`; }, delay);
        }

        function renderTemplates(category = 'all') {
            templateGrid.innerHTML = '';
            const filteredTemplates = category === 'all'
                ? staticTemplates
                : staticTemplates.filter(t => t.category === category);

            filteredTemplates.forEach(template => {
                const card = document.createElement('div');
                card.className = 'bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300 cursor-pointer flex flex-col';
                card.innerHTML = `
                    <div class="flex-grow">
                        <div class="flex justify-between items-start">
                             <span class="text-sm font-bold text-teal-700">${escapeHtml(template.category)}</span>
                             <span class="text-xs font-semibold px-2 py-1 rounded-full bg-gray-200 text-gray-700">${escapeHtml(template.type)}</span>
                        </div>
                        <h3 class="text-xl font-bold mt-2 mb-3"><button type="button" class="text-left cursor-pointer">${escapeHtml(template.title)}</button></h3>
                    </div>
                    <div class="mt-4 pt-4 border-t border-gray-200">
                        <p class="text-sm text-gray-500">相關技能：${escapeHtml(template.tags.join('、'))}</p>
                    </div>
                `;
                // 整張卡片都可以點；鍵盤和螢幕閱讀器用標題的按鈕，按下時一樣冒泡到這裡。
                const button = card.querySelector('h3 button');
                card.onclick = () => showTemplateModal(template.id, button);
                templateGrid.appendChild(card);
            });
            shownCount = filteredTemplates.length;
        }

        function showTemplateModal(id, opener) {
            const template = staticTemplates.find(t => t.id === id);
            if (!template) return;

            modal.innerHTML = `
                <div class="p-6 border-b flex justify-between items-start">
                    <div>
                        <p class="text-sm font-bold text-teal-700">${escapeHtml(template.category)} / ${escapeHtml(template.type)}</p>
                        <h3 id="modal-title" class="text-2xl font-bold">${escapeHtml(template.title)}</h3>
                    </div>
                    <button type="button" onclick="hideModal()" aria-label="關閉" class="-mr-2 px-2 rounded text-gray-500 hover:text-gray-800 text-3xl">&times;</button>
                </div>
                <div class="border-b border-gray-200">
                    <nav class="modal-tabs -mb-px flex space-x-6 px-6" role="tablist">
                        <button type="button" role="tab" id="tab-plan_html" aria-controls="panel-plan_html" aria-selected="true" class="tab-btn active border-b-2 font-semibold py-4 px-1 text-sm" onclick="showTab(this, 'plan_html')">計畫內容</button>
                        <button type="button" role="tab" id="tab-commentary_html" aria-controls="panel-commentary_html" aria-selected="false" tabindex="-1" class="tab-btn border-b-2 border-transparent font-semibold py-4 px-1 text-sm text-gray-500 hover:text-gray-700" onclick="showTab(this, 'commentary_html')">專家點評</button>
                    </nav>
                </div>
                <div class="p-6 overflow-y-auto flex-grow prose max-w-none">
                    <div id="panel-plan_html" role="tabpanel" aria-labelledby="tab-plan_html" tabindex="0" class="tab-content-plan_html">${template.plan_html}</div>
                    <div id="panel-commentary_html" role="tabpanel" aria-labelledby="tab-commentary_html" tabindex="0" class="tab-content-commentary_html hidden">${template.commentary_html}</div>
                </div>
            `;

            detail.open(opener);
        }

        window.showTab = (btn, tabName) => {
            modal.querySelectorAll('.modal-tabs .tab-btn').forEach(b => {
                b.classList.remove('active');
                b.setAttribute('aria-selected', 'false');
                b.tabIndex = -1;
            });
            btn.classList.add('active');
            btn.setAttribute('aria-selected', 'true');
            btn.tabIndex = 0;

            modal.querySelectorAll('.prose > div').forEach(div => div.classList.add('hidden'));
            modal.querySelector(`.tab-content-${tabName}`).classList.remove('hidden');
        }

        window.hideModal = () => {
            detail.close();
        }

        filters.addEventListener('click', (e) => {
            if (e.target.tagName === 'BUTTON') {
                const current = filters.querySelector('.active');
                current.classList.remove('active');
                current.setAttribute('aria-pressed', 'false');
                e.target.classList.add('active');
                e.target.setAttribute('aria-pressed', 'true');
                const category = e.target.dataset.filter;
                renderTemplates(category);
                announceCount();
            }
        });

        // 複製空白進度表。text/html 貼到文件是表格，text/plain 用 tab 分欄，貼到試算表時一格一格分開。
        document.querySelectorAll('[data-copy-table]').forEach((button) => {
            const table = document.getElementById(button.dataset.copyTable);
            const status = button.parentElement.nextElementSibling;
            button.addEventListener('click', async () => {
                const rows = [...table.rows].map((row) => [...row.cells].map((cell) => cell.textContent.trim()));
                const head = table.dataset.head;
                const text = [head, ...rows.map((row) => row.join('\t'))].join('\n');
                const html = `<p>${escapeHtml(head)}</p><table border="1">${rows.map((row, i) => `<tr>${row.map((cell) => (i === 0 ? `<th>${escapeHtml(cell)}</th>` : `<td>${escapeHtml(cell)}</td>`)).join('')}</tr>`).join('')}</table>`;
                // 先清空再寫入，連按兩次也會再念一次。
                status.textContent = '';
                try {
                    if (window.ClipboardItem && navigator.clipboard.write) {
                        await navigator.clipboard.write([new ClipboardItem({
                            'text/html': new Blob([html], { type: 'text/html' }),
                            'text/plain': new Blob([text], { type: 'text/plain' }),
                        })]);
                    } else {
                        await navigator.clipboard.writeText(text);
                    }
                    setTimeout(() => { status.textContent = `已複製 ${table.caption.textContent}，可以貼到文件或試算表。`; }, 100);
                } catch {
                    setTimeout(() => { status.textContent = '沒有複製成功，可以改用下載 CSV 檔。'; }, 100);
                }
            });
        });

        // 計畫草案由 AI 閘道的 study-plan 任務產生，prompt 與輸出格式在 ai-gateway/src/task-catalog.mjs。
        const generatePlanBtn = document.getElementById('generatePlanBtn');
        const planInput = document.getElementById('planInput');
        const planWorkspace = document.getElementById('planWorkspace');
        const planResult = document.getElementById('planResult');
        // 結果區不是 live region，要唸的話用 announce 寫進這裡。
        const planStatus = document.getElementById('planStatus');
        let announceTimer = 0;
        // 先清空，約 100 毫秒後才寫入：同一句連著出現兩次（例如連按兩次「請先輸入」）時，第二次
        // 也會被唸出來。text 是空字串時只清空。
        function announce(text) {
            clearTimeout(announceTimer);
            planStatus.textContent = '';
            if (text) announceTimer = setTimeout(() => { planStatus.textContent = text; }, 100);
        }
        const planBtnLabel = generatePlanBtn.querySelector('span');
        // platform-ai.js 沒載入成功時沒有 describeError 可用，改顯示這句。
        const FALLBACK_ERROR_TEXT = 'AI 功能沒有載入，請重新整理頁面再試一次。';

        function showMessage(text, tone = 'error') {
            planResult.textContent = '';
            const p = document.createElement('p');
            // red-500 對白底只有 3.8:1，不到 WCAG 對一般文字要求的 4.5:1
            p.className = (tone === 'error' ? 'text-red-700' : 'text-gray-600') + ' text-center';
            p.textContent = text;
            planResult.appendChild(p);
            announce(text);
        }

        generatePlanBtn.addEventListener('click', async () => {
            if (generatePlanBtn.getAttribute('aria-disabled') === 'true') return;
            const topic = planInput.value.trim();
            if (!topic) {
                showMessage('請先輸入你的自主學習主題。');
                // 快取裡的舊版 platform-ai.js 沒有 markInvalid。
                if (typeof PlatformAI !== 'undefined' && PlatformAI.markInvalid) PlatformAI.markInvalid(planInput, planResult.lastElementChild);
                return;
            }

            // 進行中停用按鈕，免得重複送出；要中途停止就按進度區塊裡的「取消」。停用靠 aria-disabled：
            // disabled 的按鈕會失去焦點，鍵盤使用者的焦點就掉回 <body>。
            const originalLabel = planBtnLabel.textContent;
            generatePlanBtn.setAttribute('aria-disabled', 'true');
            generatePlanBtn.classList.add('ai-busy');
            planBtnLabel.textContent = '產生中…';
            planResult.textContent = '';
            announce('');

            const controller = new AbortController();
            // mountProgress 也放在 try 裡：PlatformAI 不存在時它會丟錯，按鈕仍要在 finally 恢復。
            let progress = null;
            try {
                progress = PlatformAI.mountProgress(planWorkspace, {
                    onCancel: () => controller.abort(),
                    focusTarget: generatePlanBtn,
                    // 焦點在這一區（輸入框、按鈕、結果）時按 Esc 等於按取消
                    escapeScope: generatePlanBtn.closest('section'),
                });
                const { result } = await PlatformAI.runTask('study-plan', { topic }, {
                    signal: controller.signal,
                    onProgress: progress.update,
                });
                progress.finish();
                displayAIPlan(result);
                announce(`已產生計畫草案，共 ${(result.weekly_plan || []).length} 項週次進度。`);
            } catch (error) {
                if (progress) progress.finish();
                const text = typeof PlatformAI === 'undefined' ? FALLBACK_ERROR_TEXT : PlatformAI.describeError(error);
                showMessage(text, error && error.name === 'AbortError' ? 'info' : 'error');
            } finally {
                generatePlanBtn.removeAttribute('aria-disabled');
                generatePlanBtn.classList.remove('ai-busy');
                planBtnLabel.textContent = originalLabel;
            }
        });

        function displayAIPlan(data) {
            // 以下欄位都是 AI 的回應，可能含 markdown，所以用 PlatformAI.renderMarkdown()。
            // 它內部先 HTML escape、再套 markdown，不可再另外呼叫 escapeHtml，
            // 否則會雙重跳脫（看到字面的 &amp; 等）。
            // 每一項本身就是清單項目，用 inline：以「1. 」開頭的項目不會變成只有一項的 <ol>。
            const md = (text) => PlatformAI.renderMarkdown(text, { inline: true });
            const objectivesHtml = (data.learning_objectives || []).map(obj => `<li>${md(obj)}</li>`).join('');
            const methodsHtml = (data.execution_methods || []).map(met => `<li>${md(met)}</li>`).join('');
            const weeklyPlanHtml = (data.weekly_plan || []).map(week => `<li><b>${md(week.week)}:</b> ${md(week.tasks)}</li>`).join('');
            const outcomeHtml = (data.expected_outcome || []).map(out => `<li>${md(out)}</li>`).join('');

            // 結果在這一區的 h2 底下，小標題用 h3。prose 給 h3 的字比 h4 大、間距也不同，
            // 這些 class 讓它看起來和 prose 的 h4 一樣；第一個標題的上方間距由 prose 歸零
            const h3 = 'text-teal-800 font-bold text-[1em] leading-[1.5] mb-[0.5em]';
            planResult.innerHTML = `
                <div class="bg-teal-50 border-l-4 border-teal-500 p-6 rounded-r-lg prose max-w-none">
                    <h3 class="${h3}">學習目標</h3>
                    <ul class="list-disc">${objectivesHtml}</ul>
                    <h3 class="${h3} mt-[1.5em]">執行方法</h3>
                    <ul class="list-disc">${methodsHtml}</ul>
                    <h3 class="${h3} mt-[1.5em]">週次進度</h3>
                    <ol class="list-decimal">${weeklyPlanHtml}</ol>
                    <h3 class="${h3} mt-[1.5em]">預期產出</h3>
                    <ul class="list-disc">${outcomeHtml}</ul>
                </div>
            `;
        }

        renderTemplates();
    </script>

  <style is:global>
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
        }
        .modal-content::backdrop {
            background-color: rgba(0, 0, 0, 0.6);
        }
        .modal-content {
            max-height: 90vh;
        }
        .tab-btn.active {
            border-bottom-color: #047857;
            color: #047857;
            font-weight: 600;
        }
        .filter-btn.active {
            background-color: #047857;
            color: white;
        }
  </style>
</BaseLayout>
