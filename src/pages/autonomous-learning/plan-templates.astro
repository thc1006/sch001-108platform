---
import BaseLayout from '../../layouts/BaseLayout.astro';

const link = 'text-blue-600 underline hover:text-blue-700';

// 空白進度表的欄位。public/autonomous-learning/ 的三個 CSV 用同樣的表頭，改這裡要一起改。
const progressColumns = ['週次', '要做的事', '做完拿得出什麼', '實際做到哪裡'];
// 中間那週標出回頭看一次，對應上面「在計畫中間排一週回頭看」。
const progressWeeks = (n: number) => Array.from({ length: n }, (_, i) => (i + 1 === n / 2 ? `${i + 1}（回頭看）` : String(i + 1)));

// 公開在網路上的計畫與分享。站上不寫學生姓名與校名，原始頁面上有沒關係。pdf 為真時連結文字後面標（PDF）。
const realPlans = [
    {
        title: '閱讀《傀儡花》的成果摘要',
        group: '文史哲',
        kind: '學校給學生參考的範例',
        did: '讀小說《傀儡花》，邊讀邊對照地圖，把書裡的古今地名和族群整理成一張對照表。',
        learn: '目標那段寫到具體的缺口，課本講這段歷史「連標題只是短短的四行（共 56 字）」。摘要分成為什麼做、打算學什麼、怎麼進行、學到什麼幾段，每段開頭是一個問題。',
        href: 'https://www.hhsh.chc.edu.tw/resource/openfid.php?id=2873',
        text: '閱讀《傀儡花》的成果摘要',
        pdf: true,
    },
    {
        title: '巴拉刈該不該禁',
        group: '醫藥衛生、社會與心理、數理化',
        kind: '學校給學生參考的計畫書範例',
        did: '21 週的計畫：查巴拉刈的用途和危害，訪談醫界、社福團體和公務人員，最後依自己的判斷選擇禁不禁，擬一份政策和配套措施。',
        learn: '每週後面多半有括號，寫要查哪裡的資料，例如防檢局網站、食藥署網站。段考那週照實排進去，訪談的對象和時間提前一週確定。',
        href: 'https://www.essh.kl.edu.tw/wp-content/uploads/2023/09/二信高中自主學習計畫書撰寫範例彈性學習.pdf',
        text: '巴拉刈計畫書範例',
        pdf: true,
        where: '在第 6、7 頁，原檔幾處把「巴拉刈」打成「巴拉圭」',
    },
    {
        title: '《你的名字》電影分析',
        group: '大眾傳播、文史哲',
        kind: '學校手冊收的範例',
        did: '18 週、每週 1 節，蒐集影評和網路文章，寫成小論文。前 8 週在自我檢核表寫進度有沒有達成、為什麼。',
        learn: '落後的那週寫出少算了什麼，像是「我們少想到了查詢小論文規格的時間」。第 8 週和指導老師討論後換了主題，檢核表上也寫出來。',
        href: 'https://www.sphs.hc.edu.tw/ischool/rfile/5eb46aa12a3e7fd44cc16bb5861795b4',
        text: '《你的名字》電影分析的計畫與檢核表',
        pdf: true,
        where: '在第 13、17、18 頁',
    },
    {
        title: '校內地標的建築模型',
        group: '建築與設計',
        kind: '學生的計畫與每週心得',
        did: '19 週，挑學校裡的地標建築，先畫正面、背面、側面的簡圖，再用雪弗板切割、組裝。',
        learn: '每週的心得寫那週卡在哪裡，例如「切割時才發現所花的時間比原訂計畫多了好多倍」，下一週接著寫切歪了怎麼補救。選材料前先問過做過模型的大學生。',
        href: 'https://www.kmsh.km.edu.tw/ischool/news/attached/10979/自主學習手冊.pdf',
        text: '建築模型的計畫與心得',
        pdf: true,
        where: '在第 38 到 40 頁',
    },
    {
        title: '讓思考和表達成為我們的習慣',
        group: '法政、大眾傳播、社會與心理',
        kind: '學生在 ColleGo! 寫的分享',
        did: '兩個人一起做：讀書、看電影後寫摘要和評論，每週準備一則時事在討論會分享，每個月把最有興趣的主題做成影音或文字。',
        learn: '目標寫成次數和時間。作者的說法是，與其說要看更多新聞，「直接列出每周看幾則、每次時間多久、看過就好？還是需要反思？」事先排好每次的進度、地點和時間，遇到疫情也照樣進行。',
        href: 'https://collego.edu.tw/Media/Article/242',
        text: '每週時事研討的分享',
    },
    {
        title: '自學德文到 A1',
        group: '外語',
        kind: '大學生在 ColleGo! 回顧高中的自主學習',
        did: '家裡開始出現德國產品，為了看懂包裝，用 YouTube、Podcast 和網路上的筆記自學德文，目標是暑假考過 A1 檢定。',
        learn: '目標有檢定可以驗收，每週也有固定要做的事，作者寫「我規定自己每一周都要固定做至少一份模擬試題」。段考讓進度中斷時，回頭調整計畫。',
        href: 'https://collego.edu.tw/Media/Article/1632',
        text: '自學德文的分享',
    },
    {
        title: '電腦繪圖及雕刻',
        group: '資訊、工程、建築與設計',
        kind: '學校給學生參考的計畫書範例',
        did: '18 週分三段：前 6 週學 2D 繪圖軟體，接著學雷射雕刻機，最後學 miniCNC，每一段寫出要用到的設備。',
        learn: '第 3 到 6 週每週畫一件練習作品，例如杯子、名牌，接著幾週做一個手機架，做完就知道學會了沒有。學習目標寫成看得出來的事，例如比較雷雕機和 miniCNC 的運作方式。',
        href: 'https://www.hhsh.chc.edu.tw/resource/openfid.php?id=2883',
        text: '電腦繪圖及雕刻的計畫書範例',
        pdf: true,
    },
];

// 中途改計畫、沒做完、寫得太薄的例子，不寫校名。吉他那份的網址含學生姓名，不放連結。
const contrastPlans = [
    {
        title: '中途改計畫：零基礎學鋼琴自彈自唱',
        group: '藝術',
        happened: '原本要同時練唱歌和鋼琴。學校給的 600 分鐘不夠，又用早修和放學補了 7 小時，最後和老師討論，改成只練鋼琴，趕上了班級音樂會。',
        advice: '只交最後的演出，讀的人不知道計畫改過。作者寫出改了什麼、為什麼改，也挑幾天較有代表性的練習，用折線圖記下失誤次數，從 11 次以上降到 0 次。',
        href: 'https://collego.edu.tw/Media/Article/2978',
        text: '自學鋼琴彈唱的分享',
    },
    {
        title: '中途改計畫：化學小論文換了兩次題目',
        group: '數理化',
        happened: '第一個題目因為設備不夠放棄，第二個做到一半，發現有人做過類似的科展，學期過一半才重新開始。',
        advice: '只寫最後的題目，讀的人看不出前半學期做了什麼。作者把兩次放棄的原因都寫出來。訂計畫時先確認學校有沒有需要的設備、先查過去的得獎作品，可以少走這兩段路。',
        href: 'https://collego.edu.tw/Media/Article/1629',
        text: '化學小論文換題的分享',
    },
    {
        title: '沒做完：費氏弧菌生物燈',
        group: '生命科學、工程',
        happened: '在大學實驗室、由教授協助培養會發光的細菌。很久都看不到光，後來從恆溫箱被別人調高溫度的意外查出菌被汙染，改成每次從冷凍菌株重新培養，才看到藍綠色的光。供氧裝置沒做出來，科展也沒過初選。',
        advice: '作者把交出去的三項成果和沒做完的部分分開寫：「那個版本的生物燈，最後停在設計階段。」讀的人知道做到哪裡、卡在哪裡。',
        href: 'https://collego.edu.tw/Media/Article/2979',
        text: '費氏弧菌生物燈的分享',
    },
    {
        title: '寫得太薄：吉他自學的成果簡報',
        group: '藝術',
        happened: '7 頁的簡報，有動機、過程和心得，沒有進度表，「學習成果」那頁只放一張演出照片，沒有說明。',
        advice: '讀的人不知道練了幾週、每週練什麼、從會什麼進步到會什麼。可以列出練了哪幾首歌、每週練多久，照片下寫是哪一場演出、彈了哪一首，再附第一週和最後一週的錄音對照。',
    },
    {
        title: '寫得太薄：自主學習做了小論文，卻沒附上',
        group: '不限學群',
        happened: '作伙學的手冊記下一位審查教授的經驗：檔案說明了自主學習的規劃和檢討，「卻沒有附上完整的小論文成果，審查教授想瞭解成果卻不可得」。',
        advice: '成果本身要放進去。小論文、影片、作品照片附在同一份檔案裡，或寫上打得開的網址。',
        href: 'https://www.108epo.com/results-detail.php?Key=38',
        text: '作伙學《第二階段準備指南》',
        where: '在印刷頁碼第 26 頁',
    },
];
---

<BaseLayout
  title="計畫範本庫 - 台灣教育處方籤"
  description="計畫要寫的項目、6 到 18 週的空白進度表、真實的計畫與範本，也可以請 AI 依主題草擬計畫。"
  currentSection="autonomous-learning"
  bodyClass="bg-gray-100 text-gray-800"
>
    <!-- 主要內容 -->
    <main id="main-content" class="container mx-auto px-6 py-12">
        <!-- 主視覺 -->
        <section class="text-center mb-16">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
                計畫<span class="gradient-text">範本庫</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto">
                先看計畫要寫哪些項目，下載空白進度表，再參考真實的計畫和 4 份範本。也可以請 AI 草擬 8 週的計畫。
            </p>
        </section>

        <!-- 計畫要寫哪些項目 -->
        {/* 手機上照其他區塊留 2rem 內距的話，空白進度表四欄各剩不到三個字寬。 */}
        <section class="bg-white p-5 sm:p-8 rounded-xl shadow-lg mb-16">
            <h2 class="text-2xl font-bold mb-6">計畫要寫哪些項目</h2>
            <h3 class="text-xl font-bold mb-2">學校規定的項目</h3>
            <p class="text-gray-700 mb-6">自主學習計畫要寫學習主題、內容、進度、方式和需要的設備，經老師指導、家長同意後開始。普通型、綜合型和單科型高中，在學期間合計至少要排 18 節。</p>
            <h3 class="text-xl font-bold mb-2">另外寫清楚這幾件事</h3>
            <ul class="list-disc pl-6 space-y-2 text-gray-700">
                <li>目標寫成做完拿得出什麼，例如一張 30 個地名的古今對照表、一段彈完整首歌的影片，比「了解」「掌握」容易檢查。</li>
                <li>方式和資源：用什麼方法、看哪些書或課程、要借哪些設備、需要誰幫忙。</li>
                <li>進度表每週一列，寫那週要做完什麼，段考週先空下來。</li>
                <li>在計畫中間排一週回頭看，寫下改了什麼、為什麼改。</li>
                <li>成果和反思兩樣都要交：成果本身要附上，反思寫遇到什麼事、下次怎麼做。</li>
                <li>用了 AI 就寫怎麼用的：哪一段用了、怎麼查證、自己改了哪些。</li>
            </ul>
            <h3 class="text-xl font-bold mt-6 mb-2">空白進度表</h3>
            <p class="text-gray-700 mb-4">節數照你學校的自主學習實施規範，常見是一學期 18 節。整學期每週 1 節就用 18 週；每週 2 到 3 節、半學期做完，用 6 或 12 週。表頭的每週節數乘上週數，就是合計節數。下面有 6、12、18 週三種，選一種複製到文件或試算表，或下載 CSV 檔。</p>
            <div class="space-y-3">
                {[6, 12, 18].map((n) => (
                    <details class="border border-gray-300 rounded-lg">
                        <summary class="cursor-pointer px-4 py-3 font-semibold">{n} 週空白進度表</summary>
                        <div class="px-3 sm:px-4 pb-4">
                            <p class="text-gray-700 mb-2"><span aria-hidden="true">每週＿節，合計＿節</span><span class="sr-only">每週幾節、合計幾節，自己填</span></p>
                            <table id={`progress-${n}`} data-head="每週＿節，合計＿節" class="w-full table-fixed border-collapse text-sm">
                                <caption class="sr-only">{n} 週空白進度表</caption>
                                <thead>
                                    <tr>{progressColumns.map((c, i) => <th scope="col" class={`border border-gray-400 bg-gray-50 p-2 text-left${i === 0 ? ' w-16 sm:w-24' : ''}`}>{c}</th>)}</tr>
                                </thead>
                                <tbody>
                                    {progressWeeks(n).map((w) => (
                                        <tr><th scope="row" class="border border-gray-400 p-2 text-left font-normal">{w}</th><td class="border border-gray-400 h-10"></td><td class="border border-gray-400"></td><td class="border border-gray-400"></td></tr>
                                    ))}
                                </tbody>
                            </table>
                            <div class="flex flex-col sm:flex-row sm:items-center gap-3 mt-3">
                                <button type="button" data-copy-table={`progress-${n}`} class="bg-teal-700 text-white font-bold py-2 px-4 rounded-lg hover:bg-teal-800 self-start">複製 {n} 週空白進度表</button>
                                <a href={`plan-progress-${n}-weeks.csv`} download class={link}>下載 {n} 週空白進度表（CSV）</a>
                            </div>
                            <p role="status" class="text-sm text-gray-600 mt-2"></p>
                        </div>
                    </details>
                ))}
            </div>
        </section>

        <!-- AI 草擬學習計畫 -->
        <section class="bg-white p-8 rounded-xl shadow-lg mb-16">
            <h2 class="text-2xl font-bold mb-2">AI 草擬學習計畫</h2>
            <p class="text-gray-600 mb-6">輸入自主學習主題，AI 會草擬一份 8 週的計畫，列出學習目標、執行方法、每兩週的進度和預期產出。</p>
            <div class="flex flex-col sm:flex-row gap-3">
                <input type="text" id="planInput" maxlength="100" aria-label="你的自主學習主題" class="w-full px-4 py-3 border border-gray-500 rounded-lg focus:outline-hidden focus:ring-2 focus:ring-teal-700" placeholder="例如：分析手搖飲店的行銷策略">
                <button id="generatePlanBtn" class="w-full sm:w-auto bg-teal-700 text-white font-bold py-3 px-8 rounded-lg hover:bg-teal-800 transition duration-300 flex items-center justify-center space-x-2 flex-shrink-0">
                     <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    <span>產生計畫草案</span>
                </button>
            </div>
            {/* 結果有標題與清單，整段放進 live region 會被唸成一長串、聽不出結構，所以結果區不是 live region。
                結果的摘要與各種訊息改由 #planStatus 唸，它載入時就在、一開始是空的，之後寫入的才會被唸出來。
                進度區塊有自己的 status，也不能放進 live region：WebKit 連 aria-live="off" 子樹的變化也會唸。 */}
            <div class="mt-6">
                <div id="planWorkspace"></div>
                <p id="planStatus" role="status" class="sr-only"></p>
                <div id="planResult" class="space-y-4"></div>
            </div>
        </section>

        <!-- 計畫範本 -->
        <section>
            <h2 class="text-2xl font-bold text-center mb-8">計畫範本</h2>
            <!-- 分類篩選 -->
            <div class="flex flex-wrap justify-center gap-2 md:gap-4 mb-8 bg-white p-3 rounded-full shadow-sm" role="group" aria-label="依分類篩選">
                <button class="filter-btn active px-4 py-2 font-semibold text-sm rounded-full transition" data-filter="all" aria-pressed="true">全部</button>
                <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition" data-filter="社會科學" aria-pressed="false">社會科學</button>
                <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition" data-filter="資訊科技" aria-pressed="false">資訊科技</button>
                <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition" data-filter="藝術設計" aria-pressed="false">藝術設計</button>
                <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition" data-filter="自然科學" aria-pressed="false">自然科學</button>
            </div>
            <p id="result-status" role="status" class="sr-only"></p>
            <div id="template-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- 範本卡片由 renderTemplates() 填入 -->
            </div>
        </section>

        <!-- 真實的計畫 -->
        <section class="mt-16">
            <h2 class="text-2xl font-bold text-center mb-2">真實的計畫</h2>
            <p class="text-gray-600 text-center max-w-3xl mx-auto mb-8">高中生寫的計畫和分享，以及學校給學生參考的範例，都公開在網路上。每份寫它做了什麼、可以學的地方，再連到原文。</p>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {realPlans.map((p) => (
                    <li class="bg-white p-6 rounded-lg shadow-md">
                        <h3 class="text-xl font-bold mb-1">{p.title}</h3>
                        <p class="text-sm font-bold text-teal-700 mb-3">{p.group}｜{p.kind}</p>
                        <p class="text-gray-700 mb-2">{p.did}</p>
                        <p class="text-gray-700 mb-2">可以學的地方：{p.learn}</p>
                        <p class="text-gray-700">原文：<a href={p.href} class={link}>{p.pdf ? <>{p.text.slice(0, -1)}<span class="whitespace-nowrap">{p.text.slice(-1)}（PDF）</span></> : p.text}</a>{p.where && `，${p.where}`}</p>
                    </li>
                ))}
            </ul>
        </section>

        <!-- 改過、沒做完、寫得太薄的例子 -->
        <section class="mt-16">
            <h2 class="text-2xl font-bold text-center mb-2">改過、沒做完、寫得太薄的例子</h2>
