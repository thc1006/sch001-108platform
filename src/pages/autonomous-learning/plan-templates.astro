---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="計畫範本庫 - 台灣教育處方籤"
  description="列出學習目標和週次進度的計畫範本，也可以請 AI 依主題草擬計畫。"
  currentSection="autonomous-learning"
  bodyClass="bg-gray-100 text-gray-800"
>
    <!-- 主要內容 -->
    <main id="main-content" class="container mx-auto px-6 py-12">
        <!-- 主視覺 -->
        <section class="text-center mb-16">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
                計畫<span class="gradient-text">範本庫</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto">
                請 AI 草擬 8 週的計畫，或參考 4 份計畫範本。
            </p>
        </section>

        <!-- AI 草擬學習計畫 -->
        <section class="bg-white p-8 rounded-xl shadow-lg mb-16">
            <h2 class="text-2xl font-bold mb-2">AI 草擬學習計畫</h2>
            <p class="text-gray-600 mb-6">輸入自主學習主題，AI 會草擬一份 8 週的計畫，列出學習目標、執行方法、每兩週的進度和預期產出。</p>
            <div class="flex flex-col sm:flex-row gap-3">
                <input type="text" id="planInput" maxlength="100" aria-label="你的自主學習主題" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-hidden focus:ring-2 focus:ring-teal-700" placeholder="例如：分析手搖飲店的行銷策略">
                <button id="generatePlanBtn" class="w-full sm:w-auto bg-teal-700 text-white font-bold py-3 px-8 rounded-lg hover:bg-teal-800 transition duration-300 flex items-center justify-center space-x-2 flex-shrink-0">
                     <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    <span>產生計畫草案</span>
                </button>
            </div>
            {/* 結果有標題與清單，整段放進 live region 會被唸成一長串、聽不出結構，所以結果區不是 live region。
                結果的摘要與各種訊息改由 #planStatus 唸，它載入時就在、一開始是空的，之後寫入的才會被唸出來。
                進度區塊有自己的 status，也不能放進 live region：WebKit 連 aria-live="off" 子樹的變化也會唸。 */}
            <div class="mt-6">
                <div id="planWorkspace"></div>
                <p id="planStatus" role="status" class="sr-only"></p>
                <div id="planResult" class="space-y-4"></div>
            </div>
        </section>

        <!-- 計畫範本 -->
        <section>
            <h2 class="text-2xl font-bold text-center mb-8">計畫範本</h2>
            <!-- 分類篩選 -->
            <div class="flex flex-wrap justify-center gap-2 md:gap-4 mb-8 bg-white p-3 rounded-full shadow-sm" role="group" aria-label="依分類篩選">
                <button class="filter-btn active px-4 py-2 font-semibold text-sm rounded-full transition" data-filter="all" aria-pressed="true">全部</button>
                <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition" data-filter="社會科學" aria-pressed="false">社會科學</button>
                <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition" data-filter="資訊科技" aria-pressed="false">資訊科技</button>
                <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition" data-filter="藝術設計" aria-pressed="false">藝術設計</button>
                <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition" data-filter="自然科學" aria-pressed="false">自然科學</button>
            </div>
            <p id="result-status" role="status" class="sr-only"></p>
            <div id="template-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- 範本卡片由 renderTemplates() 填入 -->
            </div>
        </section>
    </main>

    <!-- 範本詳情對話框 -->
    <dialog id="templateModal" aria-labelledby="modal-title" class="modal-content bg-white text-inherit w-11/12 max-w-none md:max-w-3xl m-auto rounded-lg shadow-lg overflow-y-auto outline outline-transparent open:flex flex-col">
        <!-- 對話框內容由 showTemplateModal() 填入 -->
    </dialog>

    <script is:inline src="../shared/detail-dialog.js"></script>
    <script is:inline src="../shared/platform-ai.js"></script>
    <script is:inline>
        const staticTemplates = [
            {
                id: 'social-science',
                title: '我家巷口的手搖飲店，為何能屹立不搖？',
                category: '社會科學',
                type: '研究導向',
                tags: ['市場調查', '數據分析', '消費者行為'],
                plan_html: `
                    <h4 class="font-bold text-lg mb-2">學習目標</h4>
                    <ul class="list-disc list-inside mb-4 text-gray-700">
                        <li>學習市場調查的基本方法（問卷設計、訪談）。</li>
                        <li>運用Google表單與試算表進行初步的數據分析。</li>
                        <li>分析消費者行為，並提出該店成功的可能原因。</li>
                    </ul>
                    <h4 class="font-bold text-lg mb-2">週次進度</h4>
                    <ol class="list-decimal list-inside space-y-2 text-gray-700">
                        <li><b>Week 1-2:</b> 文獻探討與問題定義。閱讀相關文章、確立研究範圍。</li>
                        <li><b>Week 3-4:</b> 研究方法設計。設計問卷初稿、規劃訪談大綱。</li>
                        <li><b>Week 5-6:</b> 實地研究與資料蒐集。發放問卷、進行訪談。</li>
                        <li><b>Week 7-8:</b> 資料分析與報告撰寫。整理數據、撰寫結論與反思。</li>
                    </ol>
                `,
                commentary_html: `
                    <h4 class="font-bold text-lg mb-2">優點分析</h4>
                    <ul class="list-disc list-inside space-y-2 text-gray-700">
                        <li><b>主題生活化：</b> 從日常可見的現象出發，容易引發動機，且資料蒐集相對容易。</li>
                        <li><b>目標明確且可衡量：</b> 學習目標清晰，產出（問卷、分析報告）具體，易於評估學習成效。</li>
                        <li><b>結構完整：</b> 計畫涵蓋了研究的完整流程，從問題定義、方法設計到結論產出，邏輯性強。</li>
                        <li><b>技能實用：</b> 計畫中包含的問卷設計、數據分析能力，是大學商管、社會科學院非常看重的核心技能。</li>
                    </ul>
                    <h4 class="font-bold text-lg mt-4 mb-2">推薦工具</h4>
                    <p class="text-gray-700">可參考本站<a href="methodology.html" class="text-blue-600 hover:underline font-semibold">「研究方法工具箱」</a>中的問卷與訪談法，並使用<a href="../learning-portfolio/tools.html" class="text-blue-600 hover:underline font-semibold">「線上製作工具箱」</a>中的 Google Forms 進行調查。</p>
                `
            },
            {
                id: 'tech',
                title: '用 Python 打造一個 Discord 訂便當機器人',
                category: '資訊科技',
                type: '專案導向',
                tags: ['Python', 'API串接', '問題解決'],
                plan_html: `
                    <h4 class="font-bold text-lg mb-2">學習目標</h4>
                    <ul class="list-disc list-inside mb-4 text-gray-700">
                        <li>掌握 Python 基礎語法與函數。</li>
                        <li>學習如何使用 Discord API 建立機器人。</li>
                        <li>實現菜單讀取、下單統計、自動提醒等核心功能。</li>
                    </ul>
                    <h4 class="font-bold text-lg mb-2">週次進度</h4>
                    <ol class="list-decimal list-inside space-y-2 text-gray-700">
                        <li><b>Week 1-2:</b> Python 基礎語法學習。完成線上入門課程。</li>
                        <li><b>Week 3:</b> 環境建置與 Discord API 初探。成功讓機器人上線並回應訊息。</li>
                        <li><b>Week 4-5:</b> 核心功能開發（一）。實現菜單指令、下單功能。</li>
                        <li><b>Week 6-7:</b> 核心功能開發（二）。實現訂單統計、錯誤處理。</li>
                        <li><b>Week 8:</b> 測試、除錯與成果報告撰寫。</li>
                    </ol>
                `,
                commentary_html: `
                     <h4 class="font-bold text-lg mb-2">優點分析</h4>
                    <ul class="list-disc list-inside space-y-2 text-gray-700">
                        <li><b>專案導向學習（PBL）：</b> 計畫圍繞一個具體的專案成果，學習過程更有方向感。</li>
                        <li><b>里程碑清晰：</b> 每週的進度都是一個可驗收的小目標（例如「讓機器人上線」），容易獲得成就感。</li>
                        <li><b>解決真實問題：</b> 這個主題旨在解決一個真實存在的需求（訂便當），實用性高。</li>
                        <li><b>技能前瞻性：</b> 程式設計與API串接是未來產業極需的能力，對申請資訊相關科系大有助益。</li>
                    </ul>
                    <h4 class="font-bold text-lg mt-4 mb-2">推薦資源</h4>
                    <p class="text-gray-700">可參考本站「<a href="../advanced-resources/online-courses.html" class="text-blue-600 hover:underline font-semibold">線上課程</a>」中的 Python 課程，並利用 Google Colab 進行練習。</p>
                `
            },
            {
                id: 'art',
                title: '重現經典電影場景：模型製作與光影實驗',
                category: '藝術設計',
                type: '創作導向',
                tags: ['模型製作', '攝影', '美學分析'],
                plan_html: `
                     <h4 class="font-bold text-lg mb-2">學習目標</h4>
                    <ul class="list-disc list-inside mb-4 text-gray-700">
                        <li>分析電影《銀翼殺手》的視覺風格與美學。</li>
                        <li>學習使用廢棄材料製作場景模型。</li>
                        <li>實驗不同光源與拍攝角度，重現電影中的氛圍。</li>
                    </ul>
                    <h4 class="font-bold text-lg mb-2">週次進度</h4>
                    <ol class="list-decimal list-inside space-y-2 text-gray-700">
                        <li><b>Week 1:</b> 電影分析與資料蒐集。反覆觀看電影、截圖、分析美術設定。</li>
                        <li><b>Week 2-3:</b> 設計與草圖。繪製模型設計圖、規劃材料清單。</li>
                        <li><b>Week 4-6:</b> 模型本體製作。</li>
                        <li><b>Week 7:</b> 光影實驗與攝影。嘗試不同打光方式，拍攝成品。</li>
                        <li><b>Week 8:</b> 成果整理與反思。撰寫創作理念與過程紀錄。</li>
                    </ol>
                `,
                commentary_html: `
                    <h4 class="font-bold text-lg mb-2">優點分析</h4>
                    <ul class="list-disc list-inside space-y-2 text-gray-700">
                        <li><b>結合興趣與專業：</b> 將對電影的熱愛，轉化為對美學、攝影、工藝的專業探索。</li>
                        <li><b>強調創作過程：</b> 計畫的重點不只是最終成品，更包含前期的分析與後期的實驗，完整呈現創作思維。</li>
                        <li><b>動手實作：</b> 含有大量的實作環節，能有效展現學生的創造力與解決問題的能力。</li>
                        <li><b>視覺化成果：</b> 最終產出（模型照片、創作紀錄）非常吸睛，在學習歷程檔案中極具辨識度。</li>
                    </ul>
                `
            },
            {
                id: 'science-exp',
                title: '探討不同變因對麵包黴菌生長的影響',
                category: '自然科學',
                type: '實驗導向',
                tags: ['生物', '實驗設計', '變因控制'],
                plan_html: `
                     <h4 class="font-bold text-lg mb-2">學習目標</h4>
                    <ul class="list-disc list-inside mb-4 text-gray-700">
                        <li>學習如何設計一個有對照組、控制變因的科學實驗。</li>
                        <li>練習系統性地觀察、記錄實驗數據。</li>
                        <li>從實驗結果中歸納出結論，並分析可能的誤差。</li>
                    </ul>
                    <h4 class="font-bold text-lg mb-2">週次進度</h4>
                    <ol class="list-decimal list-inside space-y-2 text-gray-700">
                        <li><b>Week 1:</b> 文獻探討與假設建立。研究黴菌生長條件，提出假設。</li>
                        <li><b>Week 2:</b> 實驗設計。確定操作變因（如：溫度、濕度、光照）與應變變因。</li>
                        <li><b>Week 3-5:</b> 進行實驗與數據記錄。每日定時拍照、記錄黴菌覆蓋面積。</li>
                        <li><b>Week 6:</b> 數據整理與分析。將數據製成圖表。</li>
                        <li><b>Week 7-8:</b> 撰寫實驗報告，包含結論、討論與檢討。</li>
                    </ol>
                `,
                commentary_html: `
                    <h4 class="font-bold text-lg mb-2">優點分析</h4>
                    <ul class="list-disc list-inside space-y-2 text-gray-700">
                        <li><b>符合科學方法：</b> 此計畫完整體現了「觀察-假設-實驗-結論」的科學方法精神。</li>
                        <li><b>可操作性高：</b> 實驗材料容易取得，在家中即可操作，不需複雜的實驗室設備。</li>
                        <li><b>訓練核心能力：</b> 能扎實地訓練到變因控制、數據記錄與誤差分析等科學研究的核心能力。</li>
                        <li><b>成果明確：</b> 最終的實驗報告是一個非常標準且有力的課程學習成果。</li>
                    </ul>
                     <h4 class="font-bold text-lg mt-4 mb-2">推薦工具</h4>
                    <p class="text-gray-700">可參考本站<a href="methodology.html" class="text-blue-600 hover:underline font-semibold">「研究方法工具箱」</a>中的實驗法，並使用<a href="../learning-portfolio/tools.html" class="text-blue-600 hover:underline font-semibold">「線上製作工具箱」</a>中的 Google Sheets 記錄與分析數據。</p>
                `
            }
        ];

        function escapeHtml(value) {
            return String(value).replace(/[&<>"']/g, (c) => (
                { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
            ));
        }

        const templateGrid = document.getElementById('template-grid');
        const modal = document.getElementById('templateModal');
        const detail = DetailDialog.setup(modal);
        const filters = document.querySelector('.flex.flex-wrap.justify-center');
        const resultStatus = document.getElementById('result-status');
        // 筆數只在使用者改了條件之後念，第一次載入不念；打字時停 400 毫秒再念。
        let shownCount = 0;
        let countTimer;
        function announceCount(delay = 0) {
            clearTimeout(countTimer);
            countTimer = setTimeout(() => { resultStatus.textContent = `顯示 ${shownCount} 筆`; }, delay);
        }

        function renderTemplates(category = 'all') {
            templateGrid.innerHTML = '';
            const filteredTemplates = category === 'all'
                ? staticTemplates
                : staticTemplates.filter(t => t.category === category);

            filteredTemplates.forEach(template => {
                const card = document.createElement('div');
                card.className = 'bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300 cursor-pointer flex flex-col';
                card.innerHTML = `
                    <div class="flex-grow">
                        <div class="flex justify-between items-start">
                             <span class="text-sm font-bold text-teal-700">${escapeHtml(template.category)}</span>
                             <span class="text-xs font-semibold px-2 py-1 rounded-full bg-gray-200 text-gray-700">${escapeHtml(template.type)}</span>
                        </div>
                        <h3 class="text-xl font-bold mt-2 mb-3"><button type="button" class="text-left cursor-pointer">${escapeHtml(template.title)}</button></h3>
                    </div>
                    <div class="mt-4 pt-4 border-t border-gray-200">
                        <p class="text-sm text-gray-500">相關技能：${escapeHtml(template.tags.join('、'))}</p>
                    </div>
                `;
                // 整張卡片都可以點；鍵盤和螢幕閱讀器用標題的按鈕，按下時一樣冒泡到這裡。
                const button = card.querySelector('h3 button');
                card.onclick = () => showTemplateModal(template.id, button);
                templateGrid.appendChild(card);
            });
            shownCount = filteredTemplates.length;
        }

        function showTemplateModal(id, opener) {
            const template = staticTemplates.find(t => t.id === id);
            if (!template) return;

            modal.innerHTML = `
                <div class="p-6 border-b flex justify-between items-start">
                    <div>
                        <p class="text-sm font-bold text-teal-700">${escapeHtml(template.category)} / ${escapeHtml(template.type)}</p>
                        <h3 id="modal-title" class="text-2xl font-bold">${escapeHtml(template.title)}</h3>
                    </div>
                    <button type="button" onclick="hideModal()" aria-label="關閉" class="text-gray-500 hover:text-gray-800 text-3xl">&times;</button>
                </div>
                <div class="border-b border-gray-200">
                    <nav class="modal-tabs -mb-px flex space-x-6 px-6" role="tablist">
                        <button type="button" role="tab" id="tab-plan_html" aria-controls="panel-plan_html" aria-selected="true" class="tab-btn active border-b-2 font-semibold py-4 px-1 text-sm" onclick="showTab(this, 'plan_html')">計畫內容</button>
                        <button type="button" role="tab" id="tab-commentary_html" aria-controls="panel-commentary_html" aria-selected="false" tabindex="-1" class="tab-btn border-b-2 border-transparent font-semibold py-4 px-1 text-sm text-gray-500 hover:text-gray-700" onclick="showTab(this, 'commentary_html')">專家點評</button>
                    </nav>
                </div>
                <div class="p-6 overflow-y-auto flex-grow prose max-w-none">
                    <div id="panel-plan_html" role="tabpanel" aria-labelledby="tab-plan_html" tabindex="0" class="tab-content-plan_html">${template.plan_html}</div>
                    <div id="panel-commentary_html" role="tabpanel" aria-labelledby="tab-commentary_html" tabindex="0" class="tab-content-commentary_html hidden">${template.commentary_html}</div>
                </div>
            `;

            detail.open(opener);
        }

        window.showTab = (btn, tabName) => {
            modal.querySelectorAll('.modal-tabs .tab-btn').forEach(b => {
                b.classList.remove('active');
                b.setAttribute('aria-selected', 'false');
                b.tabIndex = -1;
            });
            btn.classList.add('active');
            btn.setAttribute('aria-selected', 'true');
            btn.tabIndex = 0;

            modal.querySelectorAll('.prose > div').forEach(div => div.classList.add('hidden'));
            modal.querySelector(`.tab-content-${tabName}`).classList.remove('hidden');
        }

        window.hideModal = () => {
            detail.close();
        }

        filters.addEventListener('click', (e) => {
            if (e.target.tagName === 'BUTTON') {
                const current = filters.querySelector('.active');
                current.classList.remove('active');
                current.setAttribute('aria-pressed', 'false');
                e.target.classList.add('active');
                e.target.setAttribute('aria-pressed', 'true');
                const category = e.target.dataset.filter;
                renderTemplates(category);
                announceCount();
            }
        });

        // 計畫草案由 AI 閘道的 study-plan 任務產生，prompt 與輸出格式在 ai-gateway/src/task-catalog.mjs。
        const generatePlanBtn = document.getElementById('generatePlanBtn');
        const planInput = document.getElementById('planInput');
        const planWorkspace = document.getElementById('planWorkspace');
        const planResult = document.getElementById('planResult');
        // 結果區不是 live region，要唸的話用 announce 寫進這裡。
        const planStatus = document.getElementById('planStatus');
        let announceTimer = 0;
        // 先清空，約 100 毫秒後才寫入：同一句連著出現兩次（例如連按兩次「請先輸入」）時，第二次
        // 也會被唸出來。text 是空字串時只清空。
        function announce(text) {
            clearTimeout(announceTimer);
            planStatus.textContent = '';
            if (text) announceTimer = setTimeout(() => { planStatus.textContent = text; }, 100);
        }
        const planBtnLabel = generatePlanBtn.querySelector('span');
        // platform-ai.js 沒載入成功時沒有 describeError 可用，改顯示這句，和它對未知錯誤的說法相同。
        const FALLBACK_ERROR_TEXT = '抱歉，AI 服務發生錯誤，請稍後再試。';

        function showMessage(text, tone = 'error') {
            planResult.textContent = '';
            const p = document.createElement('p');
            // red-500 對白底只有 3.8:1，不到 WCAG 對一般文字要求的 4.5:1
            p.className = (tone === 'error' ? 'text-red-700' : 'text-gray-600') + ' text-center';
            p.textContent = text;
            planResult.appendChild(p);
            announce(text);
        }

        generatePlanBtn.addEventListener('click', async () => {
            if (generatePlanBtn.getAttribute('aria-disabled') === 'true') return;
            const topic = planInput.value.trim();
            if (!topic) {
                showMessage('請先輸入你的自主學習主題。');
                return;
            }

            // 進行中停用按鈕，免得重複送出；要中途停止就按進度區塊裡的「取消」。停用靠 aria-disabled：
            // disabled 的按鈕會失去焦點，鍵盤使用者的焦點就掉回 <body>。
            const originalLabel = planBtnLabel.textContent;
            generatePlanBtn.setAttribute('aria-disabled', 'true');
            generatePlanBtn.classList.add('opacity-50', 'cursor-not-allowed');
            planBtnLabel.textContent = '產生中…';
            planResult.textContent = '';
            announce('');

            const controller = new AbortController();
            // mountProgress 也放在 try 裡：PlatformAI 不存在時它會丟錯，按鈕仍要在 finally 恢復。
            let progress = null;
            try {
                progress = PlatformAI.mountProgress(planWorkspace, {
                    onCancel: () => controller.abort(),
                    focusTarget: generatePlanBtn,
                    // 焦點在這一區（輸入框、按鈕、結果）時按 Esc 等於按取消
                    escapeScope: generatePlanBtn.closest('section'),
                });
                const { result } = await PlatformAI.runTask('study-plan', { topic }, {
                    signal: controller.signal,
                    onProgress: progress.update,
                });
                progress.finish();
                displayAIPlan(result);
                announce(`已產生計畫草案，共 ${(result.weekly_plan || []).length} 項週次進度。`);
            } catch (error) {
                if (progress) progress.finish();
                const text = typeof PlatformAI === 'undefined' ? FALLBACK_ERROR_TEXT : PlatformAI.describeError(error);
                showMessage(text, error && error.name === 'AbortError' ? 'info' : 'error');
            } finally {
                generatePlanBtn.removeAttribute('aria-disabled');
                generatePlanBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                planBtnLabel.textContent = originalLabel;
            }
        });

        function displayAIPlan(data) {
            // 以下欄位都是 AI 的回應，可能含 markdown，所以用 PlatformAI.renderMarkdown()。
            // 它內部先 HTML escape、再套 markdown，不可再另外呼叫 escapeHtml，
            // 否則會雙重跳脫（看到字面的 &amp; 等）。
            // 每一項本身就是清單項目，用 inline：以「1. 」開頭的項目不會變成只有一項的 <ol>。
            const md = (text) => PlatformAI.renderMarkdown(text, { inline: true });
            const objectivesHtml = (data.learning_objectives || []).map(obj => `<li>${md(obj)}</li>`).join('');
            const methodsHtml = (data.execution_methods || []).map(met => `<li>${md(met)}</li>`).join('');
            const weeklyPlanHtml = (data.weekly_plan || []).map(week => `<li><b>${md(week.week)}:</b> ${md(week.tasks)}</li>`).join('');
            const outcomeHtml = (data.expected_outcome || []).map(out => `<li>${md(out)}</li>`).join('');

            // 結果在這一區的 h2 底下，小標題用 h3。prose 給 h3 的字比 h4 大、間距也不同，
            // 這些 class 讓它看起來和 prose 的 h4 一樣；第一個標題的上方間距由 prose 歸零
            const h3 = 'text-teal-800 font-bold text-[1em] leading-[1.5] mb-[0.5em]';
            planResult.innerHTML = `
                <div class="bg-teal-50 border-l-4 border-teal-500 p-6 rounded-r-lg prose max-w-none">
                    <h3 class="${h3}">學習目標</h3>
                    <ul class="list-disc">${objectivesHtml}</ul>
                    <h3 class="${h3} mt-[1.5em]">執行方法</h3>
                    <ul class="list-disc">${methodsHtml}</ul>
                    <h3 class="${h3} mt-[1.5em]">週次進度</h3>
                    <ol class="list-decimal">${weeklyPlanHtml}</ol>
                    <h3 class="${h3} mt-[1.5em]">預期產出</h3>
                    <ul class="list-disc">${outcomeHtml}</ul>
                </div>
            `;
        }

        renderTemplates();
    </script>

  <style is:global>
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
        }
        .modal-content::backdrop {
            background-color: rgba(0, 0, 0, 0.6);
        }
        .modal-content {
            max-height: 90vh;
        }
        .tab-btn.active {
            border-bottom-color: #047857;
            color: #047857;
            font-weight: 600;
        }
        .filter-btn.active {
            background-color: #047857;
            color: white;
        }
  </style>
</BaseLayout>
