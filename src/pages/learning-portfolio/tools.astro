---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="線上製作工具箱 - 台灣教育處方籤"
  description="線上製作工具箱"
  currentSection="learning-portfolio"
  bodyClass="bg-gray-100 text-gray-800"
>
    <!-- Main Content -->
    <main id="main-content" class="container mx-auto px-6 py-12">
        <!-- Page Hero Section -->
        <section class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
                線上製作<span class="gradient-text">工具箱</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
                工欲善其事，必先利其器。我們為你精選了最好用的線上工具，讓你的學習成果更出色。
            </p>
        </section>

        <!-- Featured Tool -->
        <section class="mb-16">
            <h2 class="text-3xl font-bold mb-6 text-center">編輯精選工具</h2>
            <div class="bg-white rounded-xl shadow-lg overflow-hidden md:flex">
                 <div class="p-8 md:w-2/3 flex flex-col justify-center">
                    <p class="text-sm font-bold text-orange-600 mb-1">筆記寫作 & 專案管理</p>
                    <h3 class="text-2xl font-bold mb-3">Notion - 你的第二大腦</h3>
                    <p class="text-gray-600 mb-4">Notion 不只是一個筆記軟體，它是一個全功能的數位工作區，結合了筆記、資料庫、看板、日曆等多種功能。非常適合用來建立個人知識庫、管理自主學習專案的進度，甚至是規劃你的人生。</p>
                    <div class="prose prose-sm text-gray-700">
                        <ul>
                            <li><strong>靈活的頁面結構：</strong> 像堆樂高一樣自由組合文字、圖片、表格、待辦清單。</li>
                            <li><strong>強大的資料庫功能：</strong> 可建立關聯式資料庫，系統性地管理你的讀書筆記或活動紀錄。</li>
                            <li><strong>豐富的模板生態系：</strong> 全世界的使用者分享了海量的模板，一鍵即可套用。</li>
                        </ul>
                    </div>
                    <a href="https://www.notion.so/" target="_blank" rel="noopener noreferrer" class="mt-4 inline-block bg-orange-600 text-white font-bold py-3 px-6 rounded-lg hover:bg-orange-700 transition duration-300 self-start">
                        探索 Notion &rarr;
                    </a>
                </div>
                <div class="md:w-1/3 bg-gray-50 flex items-center justify-center">
                    <img src={`${import.meta.env.BASE_URL.replace(/\/+$/, '')}/learning-portfolio/img/tools/notion.png`} alt="Notion 數位工作區介面" class="w-full h-48 md:h-full object-contain p-6">
                </div>
            </div>
        </section>

        <!-- Filters -->
        <section class="mb-12 flex justify-center">
            <div id="category-filters" class="flex flex-wrap justify-center gap-2 md:gap-4 bg-white p-3 rounded-full shadow-sm">
                <button class="filter-btn active px-4 py-2 font-semibold text-sm rounded-full transition" data-category="all">全部工具</button>
                <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition" data-category="簡報排版">簡報排版</button>
                <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition" data-category="心智圖">心智圖</button>
                <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition" data-category="數據視覺化">數據視覺化</button>
                <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition" data-category="筆記寫作">筆記寫作</button>
                <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition" data-category="影音剪輯">影音剪輯</button>
                <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition" data-category="團隊協作">團隊協作</button>
            </div>
        </section>

        <!-- Tool Grid -->
        <section>
            <div id="tool-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Tool cards will be injected here -->
            </div>
        </section>
    </main>

    <script is:inline>
        // 工具資料改由同目錄的 tools.json 載入（見下方 loadData）。
        // 要新增或修改工具，請編輯 tools.json，不需要動這支 HTML。
        let tools = [];

        const toolGrid = document.getElementById('tool-grid');
        const filters = document.getElementById('category-filters');

        function escapeHtml(value) {
            return String(value).replace(/[&<>"']/g, (c) => (
                { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
            ));
        }

        function renderTools(category = 'all') {
            toolGrid.innerHTML = '';
            const filteredTools = category === 'all'
                ? tools
                : tools.filter(tool => tool.category === category);

            filteredTools.forEach(tool => {
                const card = document.createElement('a');
                card.href = encodeURI(tool.url);
                card.target = '_blank';
                card.rel = 'noopener noreferrer';
                card.className = 'tool-card bg-white rounded-lg shadow-md flex flex-col';

                let pricingColor = 'bg-green-100 text-green-800';
                if(tool.pricing === '免費增值') pricingColor = 'bg-yellow-100 text-yellow-800';

                card.innerHTML = `
                    <img src="${encodeURI(tool.logo)}" alt="${escapeHtml(tool.name)}" loading="lazy" class="w-full h-48 object-contain bg-gray-100 p-6 rounded-t-lg" onerror="this.onerror=null;this.src='https://placehold.co/600x400/e5e7eb/4b5563?text=Image+Not+Found';">
                    <div class="p-6 flex-grow flex flex-col">
                        <div class="flex justify-between items-start">
                            <h3 class="text-xl font-bold text-gray-900">${escapeHtml(tool.name)}</h3>
                            <span class="text-xs font-semibold px-2 py-1 rounded-full ${pricingColor} flex-shrink-0">${escapeHtml(tool.pricing)}</span>
                        </div>
                        <p class="text-sm font-bold text-orange-600 mt-1">${escapeHtml(tool.category)}</p>
                        <p class="text-gray-700 my-3 text-sm flex-grow">${escapeHtml(tool.description)}</p>
                        <div class="mt-auto pt-4 border-t border-gray-100">
                             <p class="text-xs text-gray-500 mb-2 font-semibold">最適用於：</p>
                             <span class="inline-block bg-orange-100 text-orange-800 text-sm font-medium px-3 py-1 rounded-full">${escapeHtml(tool.best_for)}</span>
                        </div>
                    </div>
                `;
                toolGrid.appendChild(card);
            });
        }

        filters.addEventListener('click', (e) => {
            if (e.target.tagName === 'BUTTON') {
                filters.querySelector('.active').classList.remove('active');
                e.target.classList.add('active');
                const category = e.target.dataset.category;
                renderTools(category);
            }
        });

        // 從 tools.json 載入工具資料後再渲染
        async function loadData() {
            try {
                const response = await fetch('tools.json', { cache: 'no-cache' });
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }
                const data = await response.json();
                tools = Array.isArray(data.tools) ? data.tools : [];
                renderTools();
            } catch (error) {
                console.error('工具資料載入失敗：', error);
                toolGrid.innerHTML = '<p class="col-span-full text-center text-gray-500 py-16">資料載入失敗，請稍後重新整理頁面。</p>';
            }
        }
        loadData();
    </script>

    <style is:global>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'PingFang TC', 'Microsoft JhengHei UI', 'Microsoft JhengHei', 'Noto Sans TC', 'Noto Sans CJK TC', 'Source Han Sans TC', sans-serif;
        }
        .gradient-text {
            background: -webkit-linear-gradient(45deg, #f97316, #f59e0b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .filter-btn.active {
            background-color: #ea580c;
            color: white;
        }
        .tool-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .tool-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        }
        .prose ul > li::before {
            background-color: #fb923c;
        }
    </style>
</BaseLayout>
