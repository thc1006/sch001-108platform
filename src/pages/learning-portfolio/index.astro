---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="學習歷程煉金室 - 台灣教育處方籤"
  description="學習歷程煉金室"
  currentSection="learning-portfolio"
  bodyClass="bg-gray-100 text-gray-800"
>
    <!-- 主要內容 -->
    <main id="main-content" class="container mx-auto px-6 py-12">
        <!-- 主視覺 -->
        <section class="text-center mb-16">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
                學習歷程<span class="gradient-text">煉金室</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
                告別無效的檔案堆疊。將你的學習經驗與反思，淬鍊成展現個人特質的亮點。
            </p>
        </section>

        <!-- AI 學習歷程健檢工具 -->
        <section class="bg-white p-8 rounded-xl shadow-lg mb-16">
             <h2 class="text-2xl font-bold mb-2">AI 學習歷程健檢工具</h2>
             <p class="text-gray-600 mb-6">將你寫好的「心得與反思」文字貼入下方，AI 將根據 STAR 原則（情境、任務、行動、結果）分析你的內容，並提供具體的修改建議，讓你的故事更具說服力！</p>
             <div>
                <textarea id="reflectionInput" maxlength="2000" aria-label="你的心得反思" aria-describedby="reflectionLimit" class="w-full h-40 p-4 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500" placeholder="在這裡貼上你的心得反思文字..."></textarea>
                <p id="reflectionLimit" class="mt-1 text-sm text-gray-500">最多 2000 字，超過的部分貼不進來。</p>
             </div>
             <div class="mt-4 text-center">
                <button id="analyzeBtn" class="bg-cyan-600 text-white font-bold py-3 px-8 rounded-lg hover:bg-cyan-700 transition duration-300 flex items-center justify-center space-x-2 mx-auto">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                    <span>開始健檢</span>
                </button>
             </div>
             {/* 進度區塊不放進結果區：WebKit 把 aria-live="off" 子樹的變化也算進外層的 live region，
                 Safari + VoiceOver 會反覆唸出計時器與取消鈕。 */}
             <div class="mt-6">
                <div id="analysisWork"></div>
                <div id="analysisResult" aria-live="polite"></div>
             </div>
        </section>

        <!-- 四大核心工房導覽 -->
        <section>
            <h2 class="text-2xl font-bold text-center mb-8">煉金室四大核心工房</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- 工房 1：優質範例藝廊 -->
                <a href="portfolio-gallery.html" class="block bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 text-center">
                    <div class="flex items-center justify-center h-20 w-20 rounded-full bg-green-100 mb-4 mx-auto">
                        <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">優質範例藝廊</h3>
                    <p class="text-gray-600 text-sm">觀摩最好的作品，建立你的標竿。</p>
                </a>

                <!-- 工房 2：反思引導提問集 -->
                <a href="reflection-guide.html" class="block bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 text-center">
                    <div class="flex items-center justify-center h-20 w-20 rounded-full bg-cyan-100 mb-4 mx-auto">
                        <svg class="w-10 h-10 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">反思引導提問集</h3>
                    <p class="text-gray-600 text-sm">問對問題，讓你的心得更有深度。</p>
                </a>

                <!-- 工房 3：多元表現資料庫 -->
                <a href="activity-database.html" class="block bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 text-center">
                    <div class="flex items-center justify-center h-20 w-20 rounded-full bg-sky-100 mb-4 mx-auto">
                        <svg class="w-10 h-10 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2h8a2 2 0 002-2v-1a2 2 0 012-2h1.945M7.707 4.293l.586-.586a2 2 0 012.828 0l.586.586M11 11a1 1 0 11-2 0 1 1 0 012 0zM13 11a1 1 0 11-2 0 1 1 0 012 0zM16.293 4.293l.586.586a2 2 0 010 2.828l-.586.586"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">多元表現資料庫</h3>
                    <p class="text-gray-600 text-sm">尋找能豐富你履歷的課外活動。</p>
                </a>

                <!-- 工房 4：線上製作工具箱 -->
                <a href="tools.html" class="block bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 text-center">
                    <div class="flex items-center justify-center h-20 w-20 rounded-full bg-orange-100 mb-4 mx-auto">
                        <svg class="w-10 h-10 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">線上製作工具箱</h3>
                    <p class="text-gray-600 text-sm">工欲善其事，必先利其器。</p>
                </a>
            </div>
        </section>
    </main>

  <script is:inline src="../shared/platform-ai.js"></script>
  <script is:inline>
        // AI 學習歷程健檢的 prompt 與輸出格式在閘道的 star-analysis 任務（ai-gateway/src/task-catalog.mjs）。
        const analyzeBtn = document.getElementById('analyzeBtn');
        const reflectionInput = document.getElementById('reflectionInput');
        const analysisWork = document.getElementById('analysisWork');
        const analysisResult = document.getElementById('analysisResult');
        const analyzeBtnLabel = analyzeBtn.querySelector('span');
        // platform-ai.js 沒載入時沒有 describeError 可用，改用這句；與它對未知錯誤的說法相同。
        const FALLBACK_ERROR_TEXT = '抱歉，AI 服務發生錯誤，請稍後再試。';

        function showMessage(text, tone = 'error') {
            analysisResult.textContent = '';
            const p = document.createElement('p');
            // red-500 對白底只有 3.8:1，不到 WCAG 對一般文字要求的 4.5:1
            p.className = (tone === 'error' ? 'text-red-700' : 'text-gray-600') + ' text-center';
            p.textContent = text;
            analysisResult.appendChild(p);
        }

        analyzeBtn.addEventListener('click', async () => {
            if (analyzeBtn.getAttribute('aria-disabled') === 'true') return;
            const reflection = reflectionInput.value.trim();
            if (!reflection) {
                showMessage('請先貼上你的心得反思文字！');
                return;
            }

            // 停用按鈕避免重複送出，要中途停止就用進度區塊裡的「取消」。停用靠 aria-disabled：
            // disabled 的按鈕會失去焦點，鍵盤使用者的焦點就掉回 <body>。
            // 只換 <span> 的文字，圖示才不會被清掉。
            const originalLabel = analyzeBtnLabel.textContent;
            analyzeBtn.setAttribute('aria-disabled', 'true');
            analyzeBtn.classList.add('opacity-50', 'cursor-not-allowed');
            analyzeBtnLabel.textContent = '健檢中…';
            analysisResult.textContent = '';

            const controller = new AbortController();
            // PlatformAI 不存在時 mountProgress 會丟 ReferenceError，要放在 try 裡，按鈕才會在 finally 恢復。
            let progress = null;
            try {
                progress = PlatformAI.mountProgress(analysisWork, {
                    onCancel: () => controller.abort(),
                    focusTarget: analyzeBtn,
                });
                const { result } = await PlatformAI.runTask('star-analysis', { reflection }, {
                    signal: controller.signal,
                    onProgress: progress.update,
                });
                progress.finish();
                analysisWork.textContent = '';
                displayAIAnalysis(result);
            } catch (error) {
                if (progress) progress.finish();
                analysisWork.textContent = '';
                const text = typeof PlatformAI === 'undefined' ? FALLBACK_ERROR_TEXT : PlatformAI.describeError(error);
                showMessage(text, error && error.name === 'AbortError' ? 'info' : 'error');
            } finally {
                analyzeBtn.removeAttribute('aria-disabled');
                analyzeBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                analyzeBtnLabel.textContent = originalLabel;
            }
        });

        function displayAIAnalysis(data) {
            // 清空容器
            analysisResult.textContent = '';

            const container = document.createElement('div');
            container.className = 'bg-gray-50 p-6 rounded-lg';

            // 總評標題
            const overallTitle = document.createElement('h3');
            overallTitle.className = 'text-lg font-semibold mb-4 text-cyan-900';
            overallTitle.textContent = '健檢總評';

            // 總評內容（AI 純文字，可能含 markdown）
            // PlatformAI.renderMarkdown() 先 HTML escape 再套 markdown，故 innerHTML 安全。
            const overallComment = document.createElement('p');
            overallComment.className = 'mb-6 text-gray-700 leading-relaxed';
            overallComment.innerHTML = PlatformAI.renderMarkdown(data.overall_comment, { headingLevel: 4 });

            // STAR 分析標題
            const starTitle = document.createElement('h3');
            starTitle.className = 'text-lg font-semibold mb-4 text-cyan-900';
            starTitle.textContent = 'STAR 分析與建議';

            // STAR 分析容器
            const analysisContainer = document.createElement('div');
            analysisContainer.className = 'space-y-4 mb-6';

            const colors = {
                S: { bg: 'bg-blue-100', text: 'text-blue-800' },
                T: { bg: 'bg-green-100', text: 'text-green-800' },
                A: { bg: 'bg-yellow-100', text: 'text-yellow-800' },
                R: { bg: 'bg-red-100', text: 'text-red-800' },
            };
            const elementNames = {'S':'情境', 'T':'任務', 'A':'行動', 'R':'結果'};

            // 閘道依 schema 驗證過，四項一定都有。順序照 elementNames，不照模型寫出的鍵順序。
            Object.keys(elementNames).forEach(element => {
                const item = data.analysis[element];
                const color = colors[element];

                const itemDiv = document.createElement('div');
                itemDiv.className = `p-4 rounded-lg ${color.bg} border border-gray-200`;

                const itemTitle = document.createElement('h4');
                itemTitle.className = `font-bold ${color.text} mb-2`;
                itemTitle.textContent = `${element} (${elementNames[element]})`;

                // 評語 / 建議為 AI 純文字，可能含 markdown。
                // 用 renderMarkdown（先 escape 後渲染）安全地填入 <span>，
                // 標籤本身仍以 textContent 設定。
                const commentP = document.createElement('p');
                commentP.className = 'text-sm text-gray-700 mb-2';
                const commentLabel = document.createElement('strong');
                commentLabel.textContent = '評語：';
                const commentSpan = document.createElement('span');
                commentSpan.innerHTML = PlatformAI.renderMarkdown(item.comment);
                commentP.appendChild(commentLabel);
                commentP.appendChild(commentSpan);

                const suggestionP = document.createElement('p');
                suggestionP.className = 'text-sm text-gray-700';
                const suggestionLabel = document.createElement('strong');
                suggestionLabel.textContent = '建議：';
                const suggestionSpan = document.createElement('span');
                suggestionSpan.innerHTML = PlatformAI.renderMarkdown(item.suggestion);
                suggestionP.appendChild(suggestionLabel);
                suggestionP.appendChild(suggestionSpan);

                itemDiv.appendChild(itemTitle);
                itemDiv.appendChild(commentP);
                itemDiv.appendChild(suggestionP);

                analysisContainer.appendChild(itemDiv);
            });

            // 修改範例標題
            const exampleTitle = document.createElement('h3');
            exampleTitle.className = 'text-lg font-semibold mb-4 text-cyan-900';
            exampleTitle.textContent = '修改範例';

            // 修改範例內容
            const exampleBox = document.createElement('div');
            exampleBox.className = 'bg-cyan-50 border border-cyan-200 rounded-lg p-4';
            // 修改範例為 AI 純文字，可能含 markdown；renderMarkdown 先 escape 後渲染。
            const exampleText = document.createElement('p');
            exampleText.className = 'text-sm text-cyan-800 leading-relaxed';
            exampleText.innerHTML = PlatformAI.renderMarkdown(data.revised_example, { headingLevel: 4 });
            exampleBox.appendChild(exampleText);

            // 組裝所有元素
            container.appendChild(overallTitle);
            container.appendChild(overallComment);
            container.appendChild(starTitle);
            container.appendChild(analysisContainer);
            container.appendChild(exampleTitle);
            container.appendChild(exampleBox);

            analysisResult.appendChild(container);
        }
  </script>

  <style is:global>
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
        }
        .gradient-text {
            background: -webkit-linear-gradient(45deg, #22c55e, #06b6d4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .prose ul > li::before {
            background-color: #10b981;
        }
  </style>
</BaseLayout>
