---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { works, contrasts } from '../../../public/learning-portfolio/portfolio-works.json';
import { portfolio as examples } from '../../../public/learning-portfolio/portfolio-gallery.json';

const link = 'inline-block self-start mt-auto pt-4 text-blue-700 underline hover:text-blue-800';
const term = 'font-semibold text-gray-800';
---

<BaseLayout
  title="優質範例藝廊 - 台灣教育處方籤"
  description="高中生的真實作品、對照例子和範例，每份附寫法分析。"
  currentSection="learning-portfolio"
  bodyClass="bg-gray-100 text-gray-800"
>
    <!-- 主要內容 -->
    <main id="main-content" class="container mx-auto px-6 py-12">
        <!-- 主視覺 -->
        <section class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
                優質範例<span class="gradient-text">藝廊</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
                {works.length} 份高中生的真實作品寫出可以學的寫法，{contrasts.length} 份對照例子寫出讀的人會卡在哪裡。另有 {examples.length} 份範例，每份從問題意識、研究過程、成果展現和反思四項分析寫法，可以拿來對照自己的檔案。
            </p>
        </section>

        <!-- 焦點範例 -->
        <section class="mb-16">
            <h2 class="text-3xl font-bold mb-6 text-center">焦點範例</h2>
            <div class="bg-white rounded-xl shadow-lg overflow-hidden md:flex">
                <div class="md:w-1/2">
                    <img src="https://images.pexels.com/photos/3184418/pexels-photo-3184418.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1" alt="" class="h-full w-full object-cover">
                </div>
                <div class="p-8 md:w-1/2 flex flex-col justify-center">
                    <p class="text-sm font-bold text-green-700 mb-1">社會科學</p>
                    <h3 class="text-2xl font-bold mb-3">社會實踐報告：<br>「剩食」議題的社區田野調查</h3>
                    <p class="text-gray-600 mb-4">作者除了文獻探討，也走訪 5 家便當店、2 間超市並訪談里長，最後提出「社區剩食共享地圖」的提案。</p>
                    <button type="button" onclick="showModal('social-02', this)" class="mt-4 inline-block bg-green-700 text-white font-bold py-3 px-6 rounded-lg hover:bg-green-800 transition duration-300 self-start">
                        看這份範例的分析 <span aria-hidden="true">&rarr;</span>
                    </button>
                </div>
            </div>
        </section>

        <section aria-labelledby="works-heading" class="mb-16">
            <h2 id="works-heading" class="text-3xl font-bold mb-4 text-center">高中生的真實作品</h2>
            <p class="text-gray-700 max-w-3xl mx-auto mb-8">下面 {works.length} 份是高中生交出去的作品，原文由科展、小論文比賽的主辦單位、宜蘭區的高中和教育部委託的作伙學計畫公開。每份寫出做了什麼、可以學的寫法，原文在連結裡。</p>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                {works.map((w) => (
                    <article aria-labelledby={`${w.id}-title`} class="bg-white p-6 rounded-xl shadow-md flex flex-col min-w-0">
                        <h3 id={`${w.id}-title`} class="text-xl font-bold">{w.title}</h3>
                        <p class="text-sm text-gray-600 mt-1">{w.group}｜{w.kind}</p>
                        <dl class="mt-4 space-y-3 text-gray-700 leading-relaxed">
                            <div>
                                <dt class={term}>做了什麼</dt>
                                <dd>{w.did}</dd>
                            </div>
                            <div>
                                <dt class={term}>可以學的寫法</dt>
                                <dd>{w.learn}</dd>
                            </div>
                            {w.quote && (
                                <div>
                                    <dt class={term}>{w.quote.by}</dt>
                                    <dd>「{w.quote.text}」</dd>
                                </div>
                            )}
                        </dl>
                        <a href={w.url} class={link}><span class="sr-only">{w.title}：</span>{w.linkLabel}</a>
                    </article>
                ))}
            </div>
        </section>

        <section aria-labelledby="contrasts-heading" class="mb-16">
            <h2 id="contrasts-heading" class="text-3xl font-bold mb-4 text-center">讀的人會卡住的寫法</h2>
            <p class="text-gray-700 max-w-3xl mx-auto mb-8">作伙學在課程學習成果的呈現建議裡舉了這兩個例子。每份寫出讀的人卡在哪裡，以及怎麼改比較好。</p>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                {contrasts.map((c) => (
                    <article aria-labelledby={`${c.id}-title`} class="bg-white p-6 rounded-xl shadow-md flex flex-col min-w-0">
                        <h3 id={`${c.id}-title`} class="text-xl font-bold">{c.title}</h3>
                        <dl class="mt-4 space-y-3 text-gray-700 leading-relaxed">
                            <div>
                                <dt class={term}>讀的人卡在哪裡</dt>
                                <dd>{c.problem}</dd>
                            </div>
                            <div>
                                <dt class={term}>怎麼改比較好</dt>
                                <dd>{c.better}</dd>
                            </div>
                        </dl>
                        <a href={c.url} class={link}><span class="sr-only">{c.title}：</span>{c.linkLabel}</a>
                    </article>
                ))}
            </div>
        </section>

        <h2 id="examples-heading" class="text-3xl font-bold mb-6 text-center">{examples.length} 份範例的寫法分析</h2>

        <!-- 篩選器 -->
        <section class="mb-12 sticky top-16 z-40 bg-gray-100/80 backdrop-blur-sm py-4" data-autohide-filters>
            <div class="bg-white p-4 rounded-xl shadow-md">
                 <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label for="category-filter" class="font-bold text-gray-700 text-sm">學科領域</label>
                        <select id="category-filter" class="w-full mt-1 p-2 border border-gray-500 rounded-md focus:outline-hidden focus:ring-2 focus:ring-green-700 bg-white">
                            <option value="all">全部領域</option>
                        </select>
                    </div>
                    <div>
                        <label for="type-filter" class="font-bold text-gray-700 text-sm">成果類型</label>
                        <select id="type-filter" class="w-full mt-1 p-2 border border-gray-500 rounded-md focus:outline-hidden focus:ring-2 focus:ring-green-700 bg-white">
                            <option value="all">所有類型</option>
                        </select>
                    </div>
                    <div>
                        <label for="tag-filter" class="font-bold text-gray-700 text-sm">能力標籤</label>
                         <select id="tag-filter" class="w-full mt-1 p-2 border border-gray-500 rounded-md focus:outline-hidden focus:ring-2 focus:ring-green-700 bg-white">
                            <option value="all">所有能力</option>
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <!-- 作品卡片網格 -->
        <section>
            <p id="result-status" role="status" class="sr-only"></p>
            <div id="portfolio-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- 作品卡片由 renderPortfolioGrid() 填入 -->
            </div>
            <div id="no-results" class="hidden text-center py-16">
                <svg class="mx-auto h-12 w-12 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">找不到符合條件的範例</h3>
                <p class="mt-1 text-sm text-gray-600">試著調整或清除篩選條件。</p>
            </div>
        </section>
    </main>

    <!-- 作品詳情對話框 -->
    <dialog id="portfolioModal" aria-labelledby="modal-title" class="modal-content bg-white text-inherit w-11/12 max-w-none md:max-w-4xl m-auto rounded-lg shadow-lg overflow-y-auto outline outline-transparent open:flex flex-col">
        <!-- 對話框內容由 showModal() 填入 -->
    </dialog>

    <script is:inline src="../shared/detail-dialog.js"></script>
    <script is:inline>
        // 資料從同目錄的 portfolio-gallery.json 載入（見下方 loadData）。
        // 要新增或修改資料，請編輯 portfolio-gallery.json，不需要動這支 HTML。
        let portfolioData = [];

        // 將資料欄位安全地嵌入 innerHTML(避免含特殊字元的 JSON 破版或注入)。
        function escapeHtml(value) {
            return String(value).replace(/[&<>"']/g, (c) => (
                { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
            ));
        }

        const portfolioGrid = document.getElementById('portfolio-grid');
        const noResultsDiv = document.getElementById('no-results');
        const modal = document.getElementById('portfolioModal');
        const detail = DetailDialog.setup(modal);
        const categoryFilter = document.getElementById('category-filter');
        const typeFilter = document.getElementById('type-filter');
        const tagFilter = document.getElementById('tag-filter');
        const resultStatus = document.getElementById('result-status');
        // 筆數只在使用者改了條件之後念，第一次載入不念；打字時停 400 毫秒再念。
        let shownCount = 0;
        let announceTimer;
        function announceCount(delay = 0) {
            clearTimeout(announceTimer);
            announceTimer = setTimeout(() => { resultStatus.textContent = `顯示 ${shownCount} 筆`; }, delay);
        }

        function renderPortfolioGrid() {
            const selectedCategory = categoryFilter.value;
            const selectedType = typeFilter.value;
            const selectedTag = tagFilter.value;

            const filteredData = portfolioData.filter(p => {
                const matchesCategory = selectedCategory === 'all' || p.category === selectedCategory;
                const matchesType = selectedType === 'all' || p.type === selectedType;
                const matchesTag = selectedTag === 'all' || p.tags.includes(selectedTag);
                return matchesCategory && matchesType && matchesTag;
            });

            portfolioGrid.innerHTML = '';
            shownCount = filteredData.length;

            if (filteredData.length === 0) {
                noResultsDiv.classList.remove('hidden');
            } else {
                noResultsDiv.classList.add('hidden');
            }

            filteredData.forEach(item => {
                const card = document.createElement('div');
                card.className = 'portfolio-card bg-white rounded-lg shadow-md overflow-hidden cursor-pointer flex flex-col';
                card.innerHTML = `
                    <img src="${encodeURI(item.thumbnail_url)}" alt="" class="w-full h-48 object-cover" onerror="this.onerror=null;this.src='https://placehold.co/600x400/e5e7eb/4b5563?text=Image+Not+Found';">
                    <div class="p-6 flex-grow">
                        <div class="flex justify-between items-center">
                            <p class="text-sm font-bold text-green-700">${escapeHtml(item.category)}</p>
                            <span class="text-xs font-semibold px-2 py-1 rounded-full bg-gray-200 text-gray-700">${escapeHtml(item.type)}</span>
                        </div>
                        <h3 class="text-lg font-bold mt-2 h-14"><button type="button" class="text-left cursor-pointer">${escapeHtml(item.title)}</button></h3>
                    </div>
                    <div class="px-6 pb-6 border-t border-gray-100 mt-auto pt-4">
                        <p class="text-xs text-gray-500 font-semibold">相關能力：${item.tags.map(escapeHtml).join(', ')}</p>
                    </div>
                `;
                // 整張卡片都可以點；鍵盤和螢幕閱讀器用標題的按鈕，按下時一樣冒泡到這裡。
                const button = card.querySelector('h3 button');
                card.onclick = () => showModal(item.id, button);
                portfolioGrid.appendChild(card);
            });
        }

        function showModal(id, opener) {
            const item = portfolioData.find(p => p.id === id);
            if (!item) return;

            modal.innerHTML = `
                <div class="p-6 border-b flex justify-between items-start">
                    <div>
                        <p class="text-sm font-bold text-green-700">${escapeHtml(item.category)} / ${escapeHtml(item.type)}</p>
                        <h3 id="modal-title" class="text-2xl font-bold">${escapeHtml(item.title)}</h3>
                    </div>
                    <button type="button" onclick="hideModal()" aria-label="關閉" class="-mr-2 px-2 rounded text-gray-500 hover:text-gray-800 text-3xl">&times;</button>
                </div>
                <div class="p-6 overflow-y-auto flex-grow">
                    <div class="prose max-w-none">
                        ${item.analysis_html}
                    </div>
                </div>
            `;

            detail.open(opener);
        }

        function hideModal() {
            detail.close();
        }

        // 依資料中實際出現的值動態填入篩選器選項
        function populateFilters() {
            const categories = [...new Set(portfolioData.map(p => p.category))];
            const types = [...new Set(portfolioData.map(p => p.type))];
            const tags = [...new Set(portfolioData.flatMap(p => p.tags))];

            const appendOptions = (select, values) => {
                values.forEach(value => {
                    const option = document.createElement('option');
                    option.value = value;
                    option.textContent = value;
                    select.appendChild(option);
                });
            };

            appendOptions(categoryFilter, categories);
            appendOptions(typeFilter, types);
            appendOptions(tagFilter, tags);
        }

        categoryFilter.addEventListener('change', () => { renderPortfolioGrid(); announceCount(); });
        typeFilter.addEventListener('change', () => { renderPortfolioGrid(); announceCount(); });
        tagFilter.addEventListener('change', () => { renderPortfolioGrid(); announceCount(); });

        // 從 portfolio-gallery.json 載入資料後再渲染
        async function loadData() {
            try {
                const response = await fetch('portfolio-gallery.json', { cache: 'no-cache' });
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }
                const data = await response.json();
                portfolioData = Array.isArray(data.portfolio) ? data.portfolio : [];
                populateFilters();
                renderPortfolioGrid();
            } catch (error) {
                console.error('資料載入失敗：', error);
                const grid = document.getElementById('portfolio-grid');
                if (grid) {
                    grid.innerHTML = '<p class="col-span-full text-center text-gray-500 py-16">資料載入失敗，請稍後重新整理頁面。</p>';
                }
            }
        }
        loadData();
    </script>

    <style is:global>
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
        }
        .modal-content::backdrop {
            background-color: rgba(0, 0, 0, 0.6);
        }
        .modal-content {
            max-height: 90vh;
        }
        .portfolio-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .portfolio-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        }
    </style>
</BaseLayout>
