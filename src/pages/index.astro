  <!-- 1. 引入 Fuse.js 函式庫 -->
  <!-- 自架而非 CDN：第三方網域掛掉時本站功能會跟著失效，而且沒有任何建置期
         檢查會發現。版本由 package-lock.json 鎖定，檔案由 scripts/vendor-assets.mjs
         從 node_modules 複製。

         type="module" 而不是原本的 classic script（#94）：fuse.js 7 起 dist/
         底下只剩 .cjs 與 .mjs，UMD／IIFE build 一個都沒有了——也就是說「載進來
         就有 window.Fuse」這條路徑在 7 以後不存在。ESM 則是 6（dist/fuse.esm.js）
         與 7（dist/fuse.min.mjs）都有，所以改走 ESM 才是同時吃得下兩個大版的
         那一條。上游檔名的差異由 vendor-assets.mjs 吸收：它一律輸出成
         vendor/fuse.esm.js，並產生這裡載的 fuse-global.js（7 行：5 行說明 ＋
         import 與 window.Fuse = Fuse 各一行），所以這個網址不隨相依升級改變。

         下面那行 modulepreload 有兩個作用，兩個都是必要的：

         (a) 效能。shim 這個間接層會多一趟序列化往返——瀏覽器要先抓完
             fuse-global.js、剖析完，才「發現」還要去抓 fuse.esm.js。
             modulepreload 讓兩個請求同時出發。

         (b) CI 保護。check:site 驗的是 HTML 屬性（script[src]、link[href]），
             它不會去追 ES module 的 import 圖。只有 <script src> 的話，被驗到的
             就只剩這 7 行的 shim，而它背後那顆 41kB 的引擎對 check:site 是隱形的
             ——實測 `rm dist/vendor/fuse.esm.js` 後 check:site 仍然「錯誤：0
             ✅ 全部通過」，但全站搜尋已經死了。把 fuse.esm.js 用
             link[rel=modulepreload] 明寫在 HTML 裡，它就重新回到 check:site 的
             驗證範圍。（vendor-assets.mjs 另有一關驗產出之間的 import 圖，
             兩者擋的是不同時點的同一件事。）

         載入順序是有保證的，不是碰運氣：module script 沒有 async 時一律 defer，
         規格要求它在文件解析完之後、DOMContentLoaded 之前執行完；下面那段
         classic script 是在 DOMContentLoaded 裡才第一次碰到 Fuse。

         失效行為與改動前相同：這個檔載不到時 Fuse 是 undefined，
         initializeFuse() 內的 new Fuse(...) 會丟例外，而它兩個呼叫點都在
         try/catch 或 .catch() 裡，使用者看到的仍是同一個紅色錯誤框。 -->
  <link rel="modulepreload" href={`${vendorBase}/vendor/fuse.esm.js`} />
  <script is:inline type="module" src={`${vendorBase}/vendor/fuse-global.js`}></script>

  <!-- 2. 全站搜尋功能邏輯 -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('search-input');
      const resultsContainer = document.getElementById('search-results-container');
      const clearBtn = document.getElementById('search-clear-btn');
      let fuse;
      let searchData = [];
      let debounceTimer;
      let selectedIndex = -1;
      let resultElements = [];

      // 鍵值必須依部署路徑隔離。GitHub Pages 把同一帳號下的所有專案頁放在同一個
      // origin（thc1006.github.io），而 localStorage 是 per-origin 不是 per-path——
      // 固定字串鍵會讓同帳號的其他專案頁互相覆蓋彼此的搜尋快取，症狀是搜尋結果
      // 指向另一個站台的頁面，而且清快取才會好。
      const CACHE_KEY = 'search-index-cache:' + window.location.pathname.replace(/[^/]*$/, '');
      // 索引結構一改就必須跟著跳版，否則舊快取（有效期 24 小時）會讓使用者拿著
      // 沒有 competencies／sdgs／taxonomy 的舊索引，搜「A2」照樣找不到東西，
      // 而且只有清快取才會好——那種症狀使用者無從自救，也不會回報。
      // 2.0：新增 competencies／sdgs／taxonomy 三個分類欄位（#14）。
      const CACHE_VERSION = '2.0';
      const CACHE_DURATION = 24 * 60 * 60 * 1000;

      // 相對路徑。本頁建置後就在 base 的根目錄（部署為 /sch001-108platform/index.html），
      // 所以 'search-index.json' 會解析成 /sch001-108platform/search-index.json；本機
      // 從 / 開時則解析成 /search-index.json。兩邊都對，而且不必知道 base 是什麼。
      //
      // 先前是用 window.location.hostname.endsWith('github.io') 分支硬寫兩條路徑。
      // 那在正式站上剛好會成立，但只要不是 *.github.io——自訂網域、本機預覽、PR
      // preview——就會 fetch 到不存在的 /search-index.json，搜尋整個失效且只有
      // console 裡有訊息。瀏覽器 smoke test 第一次跑就是抓到這個。
      const searchPath = 'search-index.json';

      const cached = localStorage.getItem(CACHE_KEY);
      if (cached) {
        try {
          const { version, data, timestamp } = JSON.parse(cached);
          const isExpired = Date.now() - timestamp > CACHE_DURATION;
          if (version === CACHE_VERSION && !isExpired && Array.isArray(data) && data.length > 0) {
            const firstItem = data[0];
            if (firstItem?.title && firstItem?.url && firstItem?.content && Array.isArray(firstItem?.tags)) {
              console.log('🔍 搜尋引擎已從快取載入！共 ' + data.length + ' 筆資料');
              initializeFuse(data);
              searchInput.disabled = false;
              searchInput.placeholder = '輸入關鍵字搜尋全站資源...';
              searchInput.classList.remove('bg-gray-200');
            } else {
              console.warn('⚠️ 快取資料格式錯誤，重新載入...');
              localStorage.removeItem(CACHE_KEY);
              loadSearchIndex();
            }
          } else {
            console.log('🔍 快取已過期或版本不符，重新載入...');
            loadSearchIndex();
          }
        } catch (e) {
          console.warn('快取載入失敗:', e);
          loadSearchIndex();
        }
      } else {
        loadSearchIndex();
      }

      function loadSearchIndex() {
        fetch(searchPath)
          .then((response) => {
            if (!response.ok) {
              throw new Error(`網路回應錯誤 (${response.status})，無法載入 ${searchPath}`);
            }
            return response.json();
          })
          .then((data) => {
            try {
              localStorage.setItem(CACHE_KEY, JSON.stringify({ version: CACHE_VERSION, data, timestamp: Date.now() }));
              console.log('🔍 搜尋索引已快取到 localStorage');
            } catch (e) {
              if (e.name === 'QuotaExceededError') {
                console.warn('⚠️ localStorage 配額已滿，嘗試清理舊快取...');
                try {
                  Object.keys(localStorage).forEach((key) => {
                    if (key.startsWith('search-index-cache')) {
                      localStorage.removeItem(key);
                    }
                  });
                  localStorage.setItem(CACHE_KEY, JSON.stringify({ version: CACHE_VERSION, data, timestamp: Date.now() }));
                  console.log('✅ 清理後成功快取');
                } catch (retryError) {
                  console.error('❌ 快取失敗，但不影響搜尋功能:', retryError);
                }
              } else {
                console.warn('無法儲存快取:', e);
              }
            }

            initializeFuse(data);
            searchInput.disabled = false;
            searchInput.placeholder = '輸入關鍵字搜尋全站資源...';
            searchInput.classList.remove('bg-gray-200');
          })
          .catch((error) => {
            console.error('載入搜尋索引時發生錯誤:', error);
            resultsContainer.textContent = '';
            const errorDiv = document.createElement('div');
            errorDiv.className = 'p-4 my-2 text-center text-red-600 bg-red-100 rounded-lg shadow-sm';
            errorDiv.textContent = '搜尋功能載入失敗，請檢查檔案路徑或網路連線。';
            resultsContainer.appendChild(errorDiv);
          });
      }

      function initializeFuse(data) {
        searchData = data;
        const fuseOptions = {
          includeScore: true,
          // 用來說明「這筆為什麼被找出來」。命中的是素養代碼還是議題標籤，
          // 對使用者的意義完全不同，但只看標題與摘要是看不出來的。
          includeMatches: true,
          shouldSort: true,
          threshold: 0.4,
          // competencies（A1-C3 代碼）與 sdgs（SDG11…）給的權重比 title 還高：
          // 會打「A2」或「SDG11」進搜尋框的人要的就是那個分類，不是標題裡剛好
          // 有這兩個字的東西。Fuse 會把 keys 的 weight 正規化，所以這裡調的是
          // 相對關係；實測（405 筆索引，改動前這四個查詢分別是 0／0／3／11 筆）：
          //   A2       → 9 筆，每一筆都真的標了 A2（5 個學群 + 4 個公民科技專案）
          //   系統思考 → 同上 9 筆
          //   環保     → 3 筆公民科技專案，score 0.000
          //   SDG      → 18 筆，公民科技專案排第 1（權重 0.6 時排第 9）
          // 並以 20 個既有查詢（競賽／Python／學長姐／書單…）比對過 top-10，
          // 排序完全沒有變動。
          keys: [
            { name: 'title', weight: 0.7 },
            { name: 'competencies', weight: 1.0 },
            { name: 'sdgs', weight: 1.0 },
            { name: 'taxonomy', weight: 0.65 },
            { name: 'tags', weight: 0.5 },
            { name: 'content', weight: 0.2 },
          ],
        };
        fuse = new Fuse(searchData, fuseOptions);
        console.log('🔍 搜尋引擎已準備就緒！共 ' + data.length + ' 筆資料');
      }

      searchInput.addEventListener('input', function () {
        if (!fuse) return;
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          const query = this.value.trim();
          clearBtn.classList.toggle('hidden', query.length === 0);
          resultsContainer.textContent = '';
          if (query.length > 0) {
            const results = fuse.search(query);
            displayResults(results.slice(0, 20), query);
          } else {
            searchInput.setAttribute('aria-expanded', 'false');
            selectedIndex = -1;
          }
        }, 200);
      });

      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          selectedIndex = Math.min(selectedIndex + 1, resultElements.length - 1);
          updateSelection();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          selectedIndex = Math.max(selectedIndex - 1, -1);
          updateSelection();
        } else if (e.key === 'Enter' && selectedIndex >= 0) {
          e.preventDefault();
          resultElements[selectedIndex].click();
        } else if (e.key === 'Escape') {
          searchInput.value = '';
          resultsContainer.textContent = '';
          clearBtn.classList.add('hidden');
          searchInput.setAttribute('aria-expanded', 'false');
          selectedIndex = -1;
        }
      });

      // WCAG 4.1.2（A 級）：這是 combobox 的 focus-stays-on-input 模式——焦點不會移到
      // 選項上，所以「目前選到哪一筆」只能靠 aria-activedescendant 傳達。
      //
      // 先前只改了 class 與 aria-selected。實測（正式站、按 ArrowDown 之後）：
      //   aria-activedescendant = null，且 9 個選項全部沒有 id
      // 也就是螢幕閱讀器使用者用方向鍵瀏覽時，完全聽不到任何回饋。
      function updateSelection() {
        resultElements.forEach((el, idx) => {
          if (idx === selectedIndex) {
            el.classList.add('bg-blue-100', 'ring-2', 'ring-blue-500');
            el.setAttribute('aria-selected', 'true');
            el.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          } else {
            el.classList.remove('bg-blue-100', 'ring-2', 'ring-blue-500');
            el.setAttribute('aria-selected', 'false');
          }
        });
        const active = selectedIndex >= 0 ? resultElements[selectedIndex] : null;
        if (active && active.id) {
          searchInput.setAttribute('aria-activedescendant', active.id);
        } else {
          // 沒有作用中的選項時必須「移除」而不是設成空字串：空字串仍是一個指向
          // 不存在元素的參照，部分螢幕閱讀器會因此停留在上一筆。
          searchInput.removeAttribute('aria-activedescendant');
        }
      }

      // WCAG 4.1.3「狀態訊息」（AA 級）：結果數量的變化是狀態訊息，必須在不移動
      // 焦點的情況下被播報。實測本頁原本**完全沒有任何 live region**，看不到畫面的
      // 使用者打完字之後不會知道有沒有結果、有幾筆。
      //
      // 競賽頁已經做對了（#result-count 帶 aria-live="polite"），這裡照同樣的形狀補。
      // 用 role="status"，它隱含 aria-live="polite" 與 aria-atomic="true"。
      // live region 必須在內容第一次變動「之前」就存在於無障礙樹中。第一版是在
      // 第一次播報時才建立元素、同一個 task 內就設文字——那是已知的反模式，多數
      // 螢幕閱讀器會漏掉那一次播報（也就是使用者的第一次搜尋，最需要回饋的那次）。
      // 改成頁面載入時就建立，之後只更新文字。
      const searchStatusEl = document.createElement('div');
      searchStatusEl.setAttribute('role', 'status');
      searchStatusEl.className = 'sr-only';
      resultsContainer.parentNode.insertBefore(searchStatusEl, resultsContainer);

      function announceResults(count, query) {
        // 一律用 textContent：這裡會放使用者輸入的字串。
        searchStatusEl.textContent = !query
          ? ''
          : count === 0
            ? '找不到符合「' + query + '」的結果'
            : '找到 ' + count + ' 筆符合「' + query + '」的結果，可用上下方向鍵瀏覽';
      }

      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchInput.focus();
        resultsContainer.textContent = '';
        clearBtn.classList.add('hidden');
        searchInput.setAttribute('aria-expanded', 'false');
        selectedIndex = -1;
      });

      function displayResults(results, query) {
        resultsContainer.textContent = '';
        searchInput.setAttribute('aria-expanded', results.length > 0 ? 'true' : 'false');

        if (results.length === 0) {
          const emptyDiv = document.createElement('div');
          emptyDiv.className = 'p-4 my-2 text-center text-gray-500 bg-white rounded-lg shadow-sm';
          emptyDiv.textContent = `找不到與「${query}」相關的結果`;
          resultsContainer.appendChild(emptyDiv);
          // 空結果也要播報。這條路徑會提早 return，不補的話「查無結果」對螢幕
          // 閱讀器使用者是完全無聲的——那正是最需要回饋的情況。
          selectedIndex = -1;
          searchInput.removeAttribute('aria-activedescendant');
          resultElements = [];
          announceResults(0, query);
          return;
        }

        results.forEach((result, index) => {
          const item = result.item;
          const linkEl = document.createElement('a');
          linkEl.href = item.url;
          linkEl.className = 'block p-4 my-2 transition duration-300 ease-in-out bg-white rounded-lg shadow-sm hover:shadow-lg hover:bg-blue-50';
          linkEl.setAttribute('role', 'option');
          linkEl.setAttribute('aria-selected', 'false');
          // aria-activedescendant 只能指向「有 id 的元素」。沒有 id 的話，焦點留在
          // 輸入框、螢幕閱讀器就完全播報不出使用者正用方向鍵移到哪一筆。
          linkEl.id = 'search-option-' + index;

          const titleEl = document.createElement('h3');
          titleEl.className = 'text-lg font-semibold text-blue-700';
          titleEl.innerHTML = highlight(item.title, query);

          const contentEl = document.createElement('p');
          contentEl.className = 'text-sm text-gray-600';
          contentEl.innerHTML = highlight(item.content.substring(0, 100), query) + '...';

          const tagsDiv = document.createElement('div');
          tagsDiv.className = 'mt-2';
          item.tags.forEach((tag) => {
            const tagSpan = document.createElement('span');
            tagSpan.className = 'inline-block px-2 py-1 mr-2 text-xs font-semibold text-gray-700 bg-gray-200 rounded-full';
            tagSpan.innerHTML = highlight(tag, query);
            tagsDiv.appendChild(tagSpan);
          });

          // 素養／SDG 的中文標籤。一律走 textContent，不進 innerHTML：
          // 這一頁其他地方要走 innerHTML 都得先過 escapeHTML()，而這些字串是
          // 從資料檔一路帶到瀏覽器的，連「忘了 escape」的機會都不該留。
          const taxonomy = Array.isArray(item.taxonomy) ? item.taxonomy : [];
          const taxDiv = document.createElement('div');
          taxDiv.className = 'mt-2 flex flex-wrap gap-1';
          taxonomy.forEach((label) => {
            const taxSpan = document.createElement('span');
            taxSpan.className =
              'inline-block px-2 py-1 text-xs font-semibold rounded-full ' +
              (label.indexOf('SDG') === 0 ? 'text-emerald-800 bg-emerald-100' : 'text-sky-800 bg-sky-100');
            taxSpan.textContent = label;
            taxDiv.appendChild(taxSpan);
          });

          // 命中說明：讓使用者看得出「這筆是因為素養代碼被找出來的」，而不是
          // 只看到一個標題卻不知道關鍵字在哪。同樣只用 textContent。
          const matchEl = document.createElement('p');
          matchEl.className = 'mt-2 text-xs text-gray-500';
          matchEl.textContent = describeMatches(result.matches);

          linkEl.appendChild(titleEl);
          linkEl.appendChild(contentEl);
          if (item.tags.length > 0) {
            linkEl.appendChild(tagsDiv);
          }
          if (taxonomy.length > 0) {
            linkEl.appendChild(taxDiv);
          }
          if (matchEl.textContent) {
            linkEl.appendChild(matchEl);
          }
          resultsContainer.appendChild(linkEl);
        });

        selectedIndex = -1;
        searchInput.removeAttribute('aria-activedescendant');
        resultElements = Array.from(resultsContainer.querySelectorAll('a'));
        announceResults(resultElements.length, query);
      }

      // Fuse 的 key → 給使用者看的中文欄位名。key 不在表裡就不顯示（例如日後
      // 新增了只給排序用的內部欄位），避免把內部鍵名端到使用者面前。
      const MATCH_FIELD_LABELS = {
        title: '標題',
        competencies: '核心素養',
        sdgs: 'SDGs',
        taxonomy: '分類標籤',
        tags: '標籤',
        content: '內文',
      };
      // 分類欄位命中時要一併講出命中的值（「核心素養（A2）」）；標題與內文已經
      // 有 highlight 標黃，再重複一次只是雜訊。
      const MATCH_FIELDS_WITH_VALUE = ['competencies', 'sdgs', 'taxonomy', 'tags'];

      function describeMatches(matches) {
        if (!Array.isArray(matches) || matches.length === 0) return '';
        const byLabel = new Map();
        matches.forEach((m) => {
          const label = MATCH_FIELD_LABELS[m.key];
          if (!label) return;
          if (!byLabel.has(label)) byLabel.set(label, []);
          if (MATCH_FIELDS_WITH_VALUE.indexOf(m.key) !== -1 && typeof m.value === 'string' && m.value) {
            byLabel.get(label).push(m.value);
          }
        });
        if (byLabel.size === 0) return '';
        const parts = [];
        byLabel.forEach((values, label) => {
          const uniq = values.filter((v, i) => values.indexOf(v) === i).slice(0, 3);
          parts.push(uniq.length ? label + '（' + uniq.join('、') + '）' : label);
        });
        return '命中：' + parts.join('・');
      }

      function highlight(text, query) {
        if (!query) return escapeHTML(text);
        const escapedText = escapeHTML(text);
        const regex = new RegExp(`(${escapeRegExp(query)})`, 'gi');
        return escapedText.replace(regex, '<mark class="bg-yellow-200 rounded">$1</mark>');
      }

      function escapeHTML(str) {
        if (!str) return '';
        return str.replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m]);
      }

      function escapeRegExp(string) {
        if (!string) return '';
        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      }
    });
  </script>
</BaseLayout>
