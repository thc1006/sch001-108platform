    <script is:inline src="../shared/puter-ai.js"></script>
    <script is:inline>
        // ============================================================
        // Toggle Details (individual expand/collapse)
        // ============================================================
        function toggleDetails(button) {
            const content = button.nextElementSibling;
            const isOpen = content.classList.contains('open');
            content.classList.toggle('open');
            button.setAttribute('aria-expanded', !isOpen);
        }

        // ============================================================
        // Expand All / Collapse All
        // ============================================================
        document.getElementById('expand-all-btn').addEventListener('click', function() {
            document.querySelectorAll('.details-content').forEach(function(el) {
                el.classList.add('open');
            });
            document.querySelectorAll('.details-toggle').forEach(function(btn) {
                btn.setAttribute('aria-expanded', 'true');
            });
        });

        document.getElementById('collapse-all-btn').addEventListener('click', function() {
            document.querySelectorAll('.details-content').forEach(function(el) {
                el.classList.remove('open');
            });
            document.querySelectorAll('.details-toggle').forEach(function(btn) {
                btn.setAttribute('aria-expanded', 'false');
            });
        });

        // ============================================================
        // Back to Top
        // ============================================================
        (function() {
            var backToTop = document.getElementById('back-to-top');
            var threshold = window.innerHeight;

            window.addEventListener('scroll', function() {
                if (window.scrollY > threshold) {
                    backToTop.classList.add('visible');
                } else {
                    backToTop.classList.remove('visible');
                }
            }, { passive: true });

            backToTop.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        })();

        // ============================================================
        // Mobile Tag Overflow (+N more)
        // ============================================================
        (function() {
            var MAX_VISIBLE_MOBILE = 3;

            function handleTagOverflow() {
                var isMobile = window.innerWidth < 768;
                document.querySelectorAll('.tag-container').forEach(function(container) {
                    var tags = Array.from(container.querySelectorAll('.project-tag'));
                    var moreBtn = container.querySelector('.tag-more-btn');
                    var expanded = container.dataset.expanded === 'true';

                    if (isMobile && !expanded && tags.length > MAX_VISIBLE_MOBILE) {
                        tags.forEach(function(tag, i) {
                            tag.classList.toggle('hidden', i >= MAX_VISIBLE_MOBILE);
                        });
                        moreBtn.classList.remove('hidden');
                        moreBtn.textContent = '+' + (tags.length - MAX_VISIBLE_MOBILE);
                    } else {
                        tags.forEach(function(tag) {
                            tag.classList.remove('hidden');
                        });
                        moreBtn.classList.add('hidden');
                    }
                });
            }

            // Expand tags on click
            document.querySelectorAll('.tag-more-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var container = btn.closest('.tag-container');
                    container.dataset.expanded = 'true';
                    handleTagOverflow();
                });
            });

            // Reset on resize to desktop
            var resizeTimer;
            window.addEventListener('resize', function() {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(function() {
                    // Reset expanded state when switching to desktop
                    if (window.innerWidth >= 768) {
                        document.querySelectorAll('.tag-container').forEach(function(c) {
                            c.dataset.expanded = '';
                        });
                    }
                    handleTagOverflow();
                }, 150);
            }, { passive: true });

            handleTagOverflow();
        })();

        // ============================================================
        // AI Exploration Suggester（Puter.js AI;模型清單與 fallback 集中於 puter-ai.js)
        // ============================================================
        (function() {
            var input = document.getElementById('ai-interest-input');
            var charCount = document.getElementById('ai-char-count');
            var submitBtn = document.getElementById('ai-submit-btn');
            var resultsArea = document.getElementById('ai-results');
            var loadingEl = document.getElementById('ai-loading');
            var resultContent = document.getElementById('ai-result-content');
            var resultText = document.getElementById('ai-result-text');
            var errorEl = document.getElementById('ai-error');
            var errorText = document.getElementById('ai-error-text');
            var isRequesting = false;

            // Character count
            input.addEventListener('input', function() {
                charCount.textContent = input.value.length + ' / 300';
            });

            submitBtn.addEventListener('click', async function() {
                var userInput = input.value.trim();
                if (!userInput) {
                    input.focus();
                    return;
                }
                if (isRequesting) return;

                // Double-click protection
                isRequesting = true;
                submitBtn.disabled = true;

                // Show loading
                resultsArea.classList.remove('hidden');
                loadingEl.classList.remove('hidden');
                resultContent.classList.add('hidden');
                errorEl.classList.add('hidden');

                var prompt = '你是「台灣教育處方籤」平台的 AI 探索助手，正在協助一位台灣高中生找到適合的公民科技專案作為自主學習主題。\n\n' +
                    '以下是 8 個台灣的公民科技專案：\n\n' +
                    '1. Disfactory（農地違章工廠回報系統）\n' +
                    '透過衛星圖資與群眾外包標記台灣農地上的違章工廠。\n' +
                    '相關領域：地理、GIS 地理資訊系統、公民與社會、環境科學\n\n' +
                    '2. Cofacts 真的假的\n' +
                    'LINE 聊天機器人加協作查核資料庫，打擊假訊息傳播。\n' +
                    '相關領域：資訊科技、媒體識讀、公民與社會、數據分析\n\n' +
                    '3. Amis MoeDict 阿美語萌典\n' +
                    '台灣第一部數位化原住民語線上辭典，保存瀕危語言。\n' +
                    '相關領域：語言學、文化保存、資訊科技、多元文化\n\n' +
                    '4. 透明足跡 / 掃了再買\n' +
                    '環境資訊公開平台，可查詢企業環境違規紀錄並掃描商品條碼。\n' +
                    '相關領域：化學、環境科學、經濟學、消費者權益\n\n' +
                    '5. 國家寶藏 National Treasure\n' +
                    '從海外（主要為美國國家檔案局）翻拍與台灣歷史相關的文件。\n' +
                    '相關領域：歷史、英文、數位典藏、國際關係\n\n' +
                    '6. LawTrace 立法足跡\n' +
                    '整合立法院法案資料，呈現法律從提案到歷次修正的完整立法歷程。\n' +
                    '相關領域：公民與社會、法律、資訊科技、開放資料\n\n' +
                    '7. vTaiwan 數位民主審議平台\n' +
                    '結合線上意見分群與實體審議的數位民主平台，近年聚焦 AI 治理。\n' +
                    '相關領域：公民與社會、審議民主、資訊科技、AI 治理\n\n' +
                    '8. 民生公共物聯網 Civil IoT Taiwan\n' +
                    '整合空品、地震、防災、水資源的開放感測資料與即時監測平台。\n' +
                    '相關領域：自然科學、地球科學、資訊科技、資料分析\n\n' +
                    '---\n\n' +
                    '使用者表示自己的興趣是：「' + userInput + '」\n\n' +
                    '請推薦 1 至 3 個最適合該使用者的專案，並說明原因。每個推薦請包含：\n' +
                    '專案名稱、推薦原因（2-3 句）、探索建議（1-2 句具體的自主學習方向）。\n\n' +
                    '用繁體中文回答，語氣友善、鼓勵探索。如果使用者的興趣與所有專案都不太相關，也請誠實說明，並嘗試找出最接近的連結點。回答請簡潔有力，不要超過 400 字。';

                try {
                    var response = await PuterAI.callGeminiWithFallback(prompt);
                    var text = '';
                    if (typeof response === 'string') {
                        text = response;
                    } else if (response && response.message && response.message.content) {
                        text = response.message.content;
                    } else if (response && typeof response.toString === 'function') {
                        text = response.toString();
                    }

                    if (!text || text === '[object Object]') {
                        throw new Error('AI 回覆格式異常，請稍後再試。');
                    }

                    loadingEl.classList.add('hidden');
                    // AI 回應可能含 markdown（如 **粗體**）。
                    // PuterAI.renderMarkdown() 先 HTML escape 再套 markdown，
                    // 故 innerHTML 注入安全，AI 無法插入可執行 HTML。
                    resultText.innerHTML = PuterAI.renderMarkdown(text);
                    resultContent.classList.remove('hidden');
                } catch (err) {
                    var detail = PuterAI.formatPuterError(err);
                    console.error("Puter.js AI call failed:", detail, err);
                    loadingEl.classList.add('hidden');
                    // 優先顯示具體錯誤（formatPuterError 產生的 [code] message / name: message），
                    // 退而求其次用 err.message（適用於 Error instance 但 formatPuterError 也已覆蓋此路徑），
                    // 最後才是泛用文案。
                    errorText.textContent = detail || (err && err.message) || '發生未知錯誤，請稍後再試。';
                    errorEl.classList.remove('hidden');
                } finally {
                    isRequesting = false;
                    submitBtn.disabled = false;
                }
            });
        })();
    </script>

