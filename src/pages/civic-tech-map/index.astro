        function toggleDetails(button) {
            const content = button.nextElementSibling;
            const isOpen = content.classList.contains('open');
            content.classList.toggle('open');
            button.setAttribute('aria-expanded', !isOpen);
        }

        // 兩組展開／收合按鈕共用這個處理函式。
        (function() {
            function setAllDetails(event) {
                var open = event.currentTarget.dataset.detailsAction === 'expand';
                document.querySelectorAll('.details-content').forEach(function(el) {
                    el.classList.toggle('open', open);
                });
                document.querySelectorAll('.details-toggle').forEach(function(btn) {
                    btn.setAttribute('aria-expanded', String(open));
                });
            }
            document.querySelectorAll('[data-details-action]').forEach(function(btn) {
                btn.addEventListener('click', setAllDetails);
            });
        })();

        // 連結沒露出的那一側標上 data-more-left／right，CSS 淡出。載入、視窗改寬、字型變寬都由 ResizeObserver 觸發。
        (function() {
            var scroller = document.querySelector('[data-scroll-fade]');
            function update() {
                var rest = scroller.scrollWidth - scroller.clientWidth - scroller.scrollLeft;
                scroller.toggleAttribute('data-more-left', scroller.scrollLeft > 1);
                scroller.toggleAttribute('data-more-right', rest > 1);
            }
            scroller.addEventListener('scroll', update, { passive: true });
            var observer = new ResizeObserver(update);
            observer.observe(scroller);
            observer.observe(scroller.firstElementChild);

            // Chromium 156、Firefox 157 不會把 Tab 到的半露出連結捲進來。scrollIntoView 會連整頁捲，
            // 滑鼠點時捲動會讓點擊落空，所以只在鍵盤焦點時捲這一列。
            scroller.addEventListener('focusin', function(event) {
                if (event.target === scroller || !event.target.matches(':focus-visible')) return;
                var pad = parseFloat(getComputedStyle(scroller).scrollPaddingLeft);
                var box = scroller.getBoundingClientRect();
                var link = event.target.getBoundingClientRect();
                if (link.left < box.left + pad) scroller.scrollLeft -= box.left + pad - link.left;
                else if (link.right > box.right - pad) scroller.scrollLeft += link.right - box.right + pad;
            });
        })();

        (function() {
            var backToTop = document.getElementById('back-to-top');
            var threshold = window.innerHeight;

            window.addEventListener('scroll', function() {
                if (window.scrollY > threshold) {
                    backToTop.classList.add('visible');
                } else {
                    backToTop.classList.remove('visible');
                }
            }, { passive: true });

            backToTop.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        })();

        // 手機上每個專案的標籤只顯示前 MAX_VISIBLE_MOBILE 個，其餘收進「+N」按鈕。
        (function() {
            var MAX_VISIBLE_MOBILE = 3;

            function handleTagOverflow() {
                var isMobile = window.innerWidth < 768;
                document.querySelectorAll('.tag-container').forEach(function(container) {
                    var tags = Array.from(container.querySelectorAll('.project-tag'));
                    var moreBtn = container.querySelector('.tag-more-btn');
                    var expanded = container.dataset.expanded === 'true';

                    if (isMobile && !expanded && tags.length > MAX_VISIBLE_MOBILE) {
                        tags.forEach(function(tag, i) {
                            tag.classList.toggle('hidden', i >= MAX_VISIBLE_MOBILE);
                        });
                        moreBtn.classList.remove('hidden');
                        moreBtn.textContent = '+' + (tags.length - MAX_VISIBLE_MOBILE);
                    } else {
                        tags.forEach(function(tag) {
                            tag.classList.remove('hidden');
                        });
                        moreBtn.classList.add('hidden');
                    }
                });
            }

            // 按「+N」展開這個專案的全部標籤。
            document.querySelectorAll('.tag-more-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var container = btn.closest('.tag-container');
                    container.dataset.expanded = 'true';
                    handleTagOverflow();
                });
            });

            // 視窗大小改變後重新套用標籤的收合。
            var resizeTimer;
            window.addEventListener('resize', function() {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(function() {
                    // 回到桌面寬度時清掉展開狀態，之後縮回手機寬度會重新收合。
                    if (window.innerWidth >= 768) {
                        document.querySelectorAll('.tag-container').forEach(function(c) {
                            c.dataset.expanded = '';
                        });
                    }
                    handleTagOverflow();
                }, 150);
            }, { passive: true });

            handleTagOverflow();
        })();

        // 「AI 探索建議」由 AI 閘道的 civic-tech-suggestion 任務產生，prompt 與專案清單在
        // ai-gateway/src/task-catalog.mjs。頁面只送學生的興趣，答案邊收邊顯示。
        (function() {
            var input = document.getElementById('ai-interest-input');
            var charCount = document.getElementById('ai-char-count');
            var submitBtn = document.getElementById('ai-submit-btn');
            var submitLabel = submitBtn.querySelector('span');
            var workspace = document.getElementById('ai-workspace');
            var resultsArea = document.getElementById('ai-results');
            var resultTemplate = document.getElementById('ai-result-template');
            // PlatformAI 沒載入成功時連 describeError 都沒有，改用這句，與它對未知錯誤的說法相同。
            var FALLBACK_ERROR_TEXT = '抱歉，AI 服務發生錯誤，請稍後再試。';

            input.addEventListener('input', function() {
                charCount.textContent = input.value.length + ' / 300';
            });

            // 草稿與最後的結果用同一個框。renderMarkdown 先 escape 再套 markdown，可以放進 innerHTML。
            function setResultText(box, markdown) {
                box.querySelector('.ai-result-text').innerHTML = PlatformAI.renderMarkdown(markdown);
            }

            function createResultBox(markdown) {
                var box = resultTemplate.content.firstElementChild.cloneNode(true);
                setResultText(box, markdown);
                return box;
            }

            function showMessage(text, tone) {
                var box = document.createElement('div');
                var p = document.createElement('p');
                if (tone === 'info') {
                    box.className = 'mt-6 bg-gray-50 border border-gray-200 rounded-lg p-4 text-center';
                    p.className = 'text-sm text-gray-700';
                } else {
                    box.className = 'mt-6 bg-red-50 border border-red-200 rounded-lg p-4 text-center';
                    p.className = 'text-sm text-red-700';
                }
                p.textContent = text;
                box.appendChild(p);
                resultsArea.appendChild(box);
            }

            // 先 finish() 再清空：焦點在取消鈕上時，finish() 會把它交給按鈕，直接清空會掉回 <body>。
            function clearWorkspace(progress) {
                if (progress) progress.finish();
                workspace.textContent = '';
            }

            submitBtn.addEventListener('click', async function() {
                if (submitBtn.getAttribute('aria-disabled') === 'true') return;
                var interest = input.value.trim();
                if (!interest) {
                    input.focus();
                    return;
                }

                // 進行中停用按鈕，防止重複送出；要停下來用進度區塊裡的「取消」。停用靠 aria-disabled：
                // disabled 的按鈕會失去焦點，鍵盤使用者的焦點就掉回 <body>。
                var originalLabel = submitLabel.textContent;
                submitBtn.setAttribute('aria-disabled', 'true');
                submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
                submitLabel.textContent = '分析中…';
                resultsArea.textContent = '';

                var controller = new AbortController();
                // mountProgress 也在 try 裡：PlatformAI 不存在時它會丟錯，放在外面就走不到 finally。
                var progress = null;
                var drawDraft = null;
                try {
                    progress = PlatformAI.mountProgress(workspace, {
                        onCancel: function() { controller.abort(); },
                        focusTarget: submitBtn
                    });
                    var draft = null;
                    var draw = function(_, text) {
                        if (draft) {
                            setResultText(draft, text);
                        } else {
                            draft = createResultBox(text);
                            workspace.appendChild(draft);
                        }
                    };
                    // 部署後十分鐘內，瀏覽器快取裡的 platform-ai.js 可能還是沒有 perFrame 的舊版，那時每段都畫。
                    drawDraft = PlatformAI.perFrame ? PlatformAI.perFrame(draw) : Object.assign(draw, { cancel: function() {} });
                    var outcome = await PlatformAI.runTask('civic-tech-suggestion', { interest: interest }, {
                        signal: controller.signal,
                        onProgress: progress.update,
                        onDelta: drawDraft
                    });
                    clearWorkspace(progress);
                    // 以 done 的結果為準，片段接起來的只是草稿。
                    resultsArea.appendChild(createResultBox(outcome.result));
                } catch (err) {
                    clearWorkspace(progress);
                    var text = typeof PlatformAI === 'undefined' ? FALLBACK_ERROR_TEXT : PlatformAI.describeError(err);
                    // 錯誤帶著已經收到的答案（沒寫完、逾時、接續輪忙線）：標明沒有寫完，放在訊息上面
                    if (err && err.partial) {
                        var partialBox = createResultBox(err.partial);
                        partialBox.querySelector('h3').textContent = 'AI 推薦結果（沒有寫完）';
                        resultsArea.appendChild(partialBox);
                    }
                    showMessage(text, err && err.name === 'AbortError' ? 'info' : 'error');
                } finally {
                    if (drawDraft) drawDraft.cancel();
                    submitBtn.removeAttribute('aria-disabled');
                    submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    submitLabel.textContent = originalLabel;
                }
            });
        })();
    </script>

    <style is:global>
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
        }
        .gradient-text {
            background: -webkit-linear-gradient(45deg, #059669, #14b8a6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .project-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .project-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.08), 0 8px 10px -6px rgb(0 0 0 / 0.06);
        }
        .details-toggle {
            cursor: pointer;
            user-select: none;
        }
        .details-toggle .chevron {
            transition: transform 0.3s ease;
        }
        .details-toggle[aria-expanded="true"] .chevron {
            transform: rotate(180deg);
        }
        .details-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease-in-out;
        }
        .details-content.open {
            max-height: 800px;
        }
        .why-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .why-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.08);
        }
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }
        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        /* scroll-padding 和淡出一樣寬，連結捲進來時停在淡出區外。Chrome 120 之前只認 -webkit-mask-image。 */
        [data-scroll-fade] {
            --fade: 2rem;
            scroll-padding-inline: var(--fade);
        }
        [data-scroll-fade][data-more-left] { --fade-left: var(--fade); }
        [data-scroll-fade][data-more-right] { --fade-right: var(--fade); }
        [data-scroll-fade][data-more-left],
        [data-scroll-fade][data-more-right] {
            -webkit-mask-image: linear-gradient(to right, transparent, #000 var(--fade-left, 0px) calc(100% - var(--fade-right, 0px)), transparent);
            mask-image: linear-gradient(to right, transparent, #000 var(--fade-left, 0px) calc(100% - var(--fade-right, 0px)), transparent);
        }
        #back-to-top {
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }
        #back-to-top.visible {
            opacity: 1;
            pointer-events: auto;
        }
        :focus-visible {
            outline: 2px solid #059669;
            outline-offset: 2px;
            border-radius: 4px;
        }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
</BaseLayout>
