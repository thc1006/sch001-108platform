---
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../../public/civic-tech-map/projects.json';

const { projects } = data;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const workshop = 'https://hackmd.io/MJw8iyS9TSaQ7Sfi83umJw';
const portfolioRules = 'https://edu.law.moe.gov.tw/LawContent.aspx?id=GL001916';
const link = 'text-blue-600 underline hover:text-blue-700';
// 查證日期都一樣時只在列表下面寫一次，不一樣時寫在各張卡片上。
const checkedDates = [...new Set(projects.map((p) => p.sourceCheckedAt))];
const formatDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${y} 年 ${m} 月 ${d} 日`;
};
---

<BaseLayout
  title="公民科技專案 - 台灣教育處方籤"
  description={`${projects.length} 個台灣公民科技專案公開的資料與工具，每個附一個自主學習或探究與實作的題目例子和做法。`}
  currentSection="autonomous-learning"
  bodyClass="bg-gray-100 text-gray-800"
>
  <main id="main-content" class="container mx-auto px-6 py-12">
    <nav class="text-sm text-gray-600 mb-6" aria-label="麵包屑">
      <a href={`${base}/autonomous-learning/topic-ideas.html`} class="underline hover:text-blue-600">主題靈感產生器</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-gray-700" aria-current="page">公民科技專案</span>
    </nav>

    <section class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-black text-gray-800 mb-4">
        公民科技<span class="gradient-text">專案</span>
      </h1>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        這 {projects.length} 個台灣的公民科技專案都公開了資料或工具，可以拿來做自主學習或探究與實作。
      </p>
      <p class="text-sm text-gray-600 mt-2">其中六個出自零時小學校整理、在 SITCON 2025 共創工作坊上補充的<a href={workshop} class={link}>對照表</a>。</p>
    </section>

    <div class="max-w-4xl mx-auto">
      <section class="text-gray-700 leading-relaxed mb-12">
        <p>在自主學習時間做的，上傳學習歷程時屬於多元表現，申請大學時放在「高中自主學習計畫與成果」；在探究與實作等課堂上做的報告或作品是課程學習成果，上傳後要任課老師認證（教育部<a href={portfolioRules} class={link}>學習歷程檔案作業要點</a>）。</p>
      </section>

      <section class="mb-12" aria-labelledby="overview-heading">
        <h2 id="overview-heading" class="text-2xl font-bold text-gray-800 mb-4">專案一覽</h2>
        <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-2">
          {projects.map((p) => (
            <li>
              <a href={`#${p.id}`} class={link}>{p.title}</a><span class="text-gray-600">：{p.theme}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="bg-white p-5 md:p-8 rounded-xl shadow-md border border-gray-100 mb-16" aria-labelledby="ai-heading">
        <h2 id="ai-heading" class="text-2xl font-bold text-gray-800 mb-2">讓 AI 幫你挑</h2>
        <p class="text-gray-600 mb-4">AI 會從這 {projects.length} 個專案裡推薦 1 到 3 個，並說明理由。</p>
        <label for="ai-interest-input" class="block text-sm font-medium text-gray-700 mb-1">你的興趣或關心的議題</label>
        <textarea
          id="ai-interest-input"
          rows="3"
          maxlength="300"
          aria-describedby="ai-char-count"
          class="w-full border border-gray-500 rounded-lg p-3 text-gray-800 focus:outline-hidden focus:ring-2 focus:ring-blue-500 resize-none"
          placeholder="例如：我家附近的空氣品質"
        ></textarea>
        <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
          <p id="ai-char-count" class="text-sm text-gray-500">0 / 300</p>
          <button
            id="ai-submit-btn"
            type="button"
            class="inline-flex items-center gap-2 bg-blue-600 text-white font-bold py-2.5 px-6 rounded-lg hover:bg-blue-700 transition duration-300"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            <span>推薦專案</span>
          </button>
        </div>
        {/* 進度區塊與草稿一直在變，不放進 live region；WebKit 不理會裡層的 aria-live="off"，用它包起來也沒用。 */}
        <div id="ai-workspace" class="mt-6 empty:hidden"></div>
        {/* 結果有標題、清單與提醒，整段放進 live region 會被唸成一長串，所以結果區不是 live region。
            摘要與訊息由 #ai-status 唸，它載入時就在、一開始是空的，之後寫入的才會被唸出來。 */}
        <p id="ai-status" role="status" class="sr-only"></p>
        <div id="ai-results"></div>
        <template id="ai-result-template">
          <div class="mt-6">
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-5">
              <h3 class="font-bold text-blue-800 mb-3">AI 推薦結果</h3>
              <div class="ai-result-text text-sm text-gray-700 leading-relaxed whitespace-pre-line"></div>
            </div>
            <p class="text-sm text-gray-500 mt-3">AI 的回答可能有錯，專案現況以各專案官網為準。</p>
          </div>
        </template>
      </section>

      <section aria-labelledby="projects-heading">
        <h2 id="projects-heading" class="text-2xl font-bold text-gray-800 mb-6">專案介紹</h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {projects.map((p) => (
            <article id={p.id} class="bg-white p-5 md:p-6 rounded-xl shadow-md border border-gray-100">
              {/* 專案一覽也有同名的連結，連到這張卡片；這一個連到官網，名稱要分得出來。 */}
              <h3 class="text-xl font-bold"><a href={p.url} class="text-blue-700 hover:underline">{p.title}<span class="sr-only">（官網）</span></a></h3>
              <p class="text-sm text-gray-500 mt-1">{p.org}</p>
              <p class="text-gray-700 leading-relaxed mt-3">{p.description}</p>
              <dl class="mt-4 space-y-3 text-gray-700 leading-relaxed">
                <div>
                  <dt class="font-semibold text-gray-800">可以用的資料或工具</dt>
                  <dd>
                    <ul class="list-disc pl-5 space-y-1">
                      {p.tools.map((t) => (
                        <li>
                          {t.url ? <a href={t.url} class={link}>{t.name}</a> : t.name}{t.note && `：${t.note}`}
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
                <div>
                  <dt class="font-semibold text-gray-800">題目例子</dt>
                  <dd>{p.topic}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-gray-800">做法</dt>
                  <dd>{p.steps}</dd>
                </div>
              </dl>
              {p.source && <p class="text-sm text-gray-500 mt-4">出處：<a href={p.source.url} class="underline hover:text-blue-600">{p.source.text}</a></p>}
              {checkedDates.length > 1 && <p class="text-sm text-gray-500 mt-2">{formatDate(p.sourceCheckedAt)}查證</p>}
            </article>
          ))}
        </div>
        <div class="text-gray-600 mt-6 space-y-2">
          {checkedDates.length === 1 && <p class="text-sm text-gray-600">以上資料於 {formatDate(checkedDates[0])}查證。</p>}
          <p>想看更多專案，可以到 g0v 揪松團維護的<a href="https://civictech.tw/" class={link}>台灣公民科技資料庫</a>，依你關心的議題找。</p>
        </div>
      </section>

      <section class="mt-16 text-gray-700 leading-relaxed" aria-labelledby="join-heading">
        <h2 id="join-heading" class="text-2xl font-bold text-gray-800 mb-4">和專案團隊一起做</h2>
        <p>g0v 社群大約每兩個月辦一次黑客松，不會寫程式也可以參加，到現場可以提案，也可以加入別人的專案。各場的日期和共筆在<a href="https://jothon.g0v.tw/events/" class={link}>揪松網的活動列表</a>。</p>
      </section>
    </div>
  </main>

  <script is:inline src="../shared/platform-ai.js"></script>
  <script is:inline>
    // 「讓 AI 幫你挑」由 AI 閘道的 civic-tech-suggestion 任務產生，prompt 與專案清單在
    // ai-gateway/src/task-catalog.mjs。頁面只送學生的興趣，答案邊收邊顯示。
    (function() {
      var input = document.getElementById('ai-interest-input');
      var charCount = document.getElementById('ai-char-count');
      var submitBtn = document.getElementById('ai-submit-btn');
      var submitLabel = submitBtn.querySelector('span');
      var workspace = document.getElementById('ai-workspace');
      var resultsArea = document.getElementById('ai-results');
      var resultTemplate = document.getElementById('ai-result-template');
      var statusEl = document.getElementById('ai-status');
      var announceTimer = 0;
      // 先清空，約 100 毫秒後才寫入：同一句連著出現兩次時，第二次也會被唸出來。text 是空字串時只清空。
      function announce(text) {
        clearTimeout(announceTimer);
        statusEl.textContent = '';
        if (text) announceTimer = setTimeout(function() { statusEl.textContent = text; }, 100);
      }
      // PlatformAI 沒載入成功時連 describeError 都沒有，改用這句，與它對未知錯誤的說法相同。
      var FALLBACK_ERROR_TEXT = '抱歉，AI 服務發生錯誤，請稍後再試。';

      input.addEventListener('input', function() {
        charCount.textContent = input.value.length + ' / 300';
      });

      // 草稿與最後的結果用同一個框。renderMarkdown 先 escape 再套 markdown，可以放進 innerHTML。
      // 回答裡的標題接在框裡的 h3「AI 推薦結果」底下。partial 表示文字沒寫完（草稿、斷掉的回答）。
      function setResultText(box, markdown, partial) {
        box.querySelector('.ai-result-text').innerHTML = PlatformAI.renderMarkdown(markdown, { headingLevel: 4, partial: partial });
      }

      function createResultBox(markdown, partial) {
        var box = resultTemplate.content.firstElementChild.cloneNode(true);
        setResultText(box, markdown, partial);
        return box;
      }

      function showMessage(text, tone) {
        var box = document.createElement('div');
        var p = document.createElement('p');
        if (tone === 'info') {
          box.className = 'mt-6 bg-gray-50 border border-gray-200 rounded-lg p-4 text-center';
          p.className = 'text-sm text-gray-700';
        } else {
          box.className = 'mt-6 bg-red-50 border border-red-200 rounded-lg p-4 text-center';
          p.className = 'text-sm text-red-700';
        }
        p.textContent = text;
        box.appendChild(p);
        resultsArea.appendChild(box);
        announce(text);
      }

      // 先 finish() 再清空：焦點在取消鈕上時，finish() 會把它交給按鈕，直接清空會掉回 <body>。
      function clearWorkspace(progress) {
        if (progress) progress.finish();
        workspace.textContent = '';
      }

      submitBtn.addEventListener('click', async function() {
        if (submitBtn.getAttribute('aria-disabled') === 'true') return;
        var interest = input.value.trim();
        if (!interest) {
          resultsArea.textContent = '';
          // 和其他 AI 頁一樣焦點留在按鈕上，提示由 status 唸一次。移焦點的話，輸入框的描述裡也有提示，會唸兩次。
          showMessage('請先輸入你的興趣或關心的議題。');
          // 快取裡的舊版 platform-ai.js 沒有 markInvalid。
          if (typeof PlatformAI !== 'undefined' && PlatformAI.markInvalid) PlatformAI.markInvalid(input, resultsArea.lastElementChild);
          return;
        }

        // 進行中停用按鈕，防止重複送出；要停下來用進度區塊裡的「取消」。停用靠 aria-disabled：
        // disabled 的按鈕會失去焦點，鍵盤使用者的焦點就掉回 <body>。
        var originalLabel = submitLabel.textContent;
        submitBtn.setAttribute('aria-disabled', 'true');
        submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
        submitLabel.textContent = '分析中…';
        resultsArea.textContent = '';
        announce('');

        var controller = new AbortController();
        // mountProgress 也在 try 裡：PlatformAI 不存在時它會丟錯，放在外面就走不到 finally。
        var progress = null;
        var drawDraft = null;
        try {
          progress = PlatformAI.mountProgress(workspace, {
            onCancel: function() { controller.abort(); },
            focusTarget: submitBtn,
            // 焦點在這一區（輸入框、按鈕、結果）時按 Esc 等於按取消
            escapeScope: submitBtn.closest('section')
          });
          var draft = null;
          var draw = function(_, text) {
            if (draft) {
              setResultText(draft, text, true);
            } else {
              draft = createResultBox(text, true);
              workspace.appendChild(draft);
            }
          };
          // 部署後十分鐘內，瀏覽器快取裡的 platform-ai.js 可能還是沒有 perFrame 的舊版，那時每段都畫。
          drawDraft = PlatformAI.perFrame ? PlatformAI.perFrame(draw) : Object.assign(draw, { cancel: function() {} });
          var outcome = await PlatformAI.runTask('civic-tech-suggestion', { interest: interest }, {
            signal: controller.signal,
            onProgress: progress.update,
            onDelta: drawDraft
          });
          clearWorkspace(progress);
          // 以 done 的結果為準，片段接起來的只是草稿。
          resultsArea.appendChild(createResultBox(outcome.result));
          announce('已產生推薦結果，在「AI 推薦結果」標題下。');
        } catch (err) {
          clearWorkspace(progress);
          var text = typeof PlatformAI === 'undefined' ? FALLBACK_ERROR_TEXT : PlatformAI.describeError(err);
          // 錯誤帶著已經收到的答案（沒寫完、斷線、逾時、接續輪忙線）：標明沒有寫完，放在訊息上面
          if (err && err.partial) {
            var partialBox = createResultBox(err.partial, true);
            partialBox.querySelector('h3').textContent = 'AI 推薦結果（沒有寫完）';
            resultsArea.appendChild(partialBox);
          }
          showMessage(text, err && err.name === 'AbortError' ? 'info' : 'error');
          if (err && err.partial) announce(text + '已收到的部分在「AI 推薦結果」標題下。');
        } finally {
          if (drawDraft) drawDraft.cancel();
          submitBtn.removeAttribute('aria-disabled');
          submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
          submitLabel.textContent = originalLabel;
        }
      });
    })();
  </script>
</BaseLayout>
