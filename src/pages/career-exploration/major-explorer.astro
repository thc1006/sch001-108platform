---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="大學科系羅盤 - 即將推出 - 台灣教育處方籤"
  description="大學科系羅盤"
  currentSection="career-exploration"
  bodyClass="bg-gray-50"
>
    <!-- Main Content -->
    <main id="main-content" class="container mx-auto px-6 py-16">
        <div class="max-w-4xl mx-auto">

            <!-- Coming Soon Badge -->
            <div class="flex justify-center mb-8">
                <span class="coming-soon-badge inline-flex items-center px-6 py-2 rounded-full text-sm font-semibold bg-purple-100 text-purple-800">
                    <ion-icon name="time-outline" class="mr-2"></ion-icon>
                    即將推出
                </span>
            </div>

            <!-- Hero Section -->
            <div class="text-center mb-16">
                <h1 class="text-5xl md:text-6xl font-bold text-gray-800 mb-6">
                    大學科系<span class="gradient-text">羅盤</span>
                </h1>
                <p class="text-xl text-gray-600 mb-4">
                    探索18學群與核心素養的對應關係
                </p>
                <p class="text-lg text-gray-500">
                    功能開發中，敬請期待！
                </p>
            </div>

            <!-- Feature Preview -->
            <div class="bg-white rounded-2xl shadow-lg p-8 mb-12">
                <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
                    <ion-icon name="bulb-outline" class="text-purple-600 mr-3 text-3xl"></ion-icon>
                    即將帶來的功能
                </h2>

                <div class="grid md:grid-cols-2 gap-6">
                    <div class="flex items-start space-x-4">
                        <div class="flex-shrink-0">
                            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                                <ion-icon name="school-outline" class="text-purple-600 text-2xl"></ion-icon>
                            </div>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-800 mb-2">18學群完整指南</h3>
                            <p class="text-gray-600 text-sm">深入了解每個學群的特色、核心課程與未來發展</p>
                        </div>
                    </div>

                    <div class="flex items-start space-x-4">
                        <div class="flex-shrink-0">
                            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                                <ion-icon name="git-network-outline" class="text-purple-600 text-2xl"></ion-icon>
                            </div>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-800 mb-2">核心素養對應關係</h3>
                            <p class="text-gray-600 text-sm">清楚呈現各學群與108課綱核心素養的連結</p>
                        </div>
                    </div>

                    <div class="flex items-start space-x-4">
                        <div class="flex-shrink-0">
                            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                                <ion-icon name="navigate-outline" class="text-purple-600 text-2xl"></ion-icon>
                            </div>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-800 mb-2">互動式探索工具</h3>
                            <p class="text-gray-600 text-sm">透過互動式介面，輕鬆找到適合自己的學群方向</p>
                        </div>
                    </div>

                    <div class="flex items-start space-x-4">
                        <div class="flex-shrink-0">
                            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                                <ion-icon name="analytics-outline" class="text-purple-600 text-2xl"></ion-icon>
                            </div>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-800 mb-2">個人化推薦系統</h3>
                            <p class="text-gray-600 text-sm">根據你的興趣與能力，推薦最適合的科系選項</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Temporary Alternative -->
            <div class="bg-blue-50 border-l-4 border-blue-500 p-6 rounded-lg mb-12">
                <div class="flex items-start">
                    <ion-icon name="information-circle-outline" class="text-blue-500 text-2xl mr-3 flex-shrink-0"></ion-icon>
                    <div>
                        <h3 class="font-semibold text-blue-900 mb-2">目前可以使用的功能</h3>
                        <p class="text-blue-800 mb-3">在大學科系羅盤開發完成之前，您可以先使用以下功能：</p>
                        <ul class="space-y-2">
                            <li class="flex items-center text-blue-800">
                                <ion-icon name="checkmark-circle" class="mr-2"></ion-icon>
                                <a href="senior-interviews.html" class="hover:underline font-medium">學長姐真心話</a> - 閱讀來自各校系學長姐的真實經驗
                            </li>
                            <li class="flex items-center text-blue-800">
                                <ion-icon name="checkmark-circle" class="mr-2"></ion-icon>
                                <a href="competency-map.html" class="hover:underline font-medium">核心素養對照表</a> - 了解三面九項的內涵與實踐方法
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="index.html" class="inline-flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-purple-600 hover:bg-purple-700 transition duration-300 shadow-lg">
                    <ion-icon name="arrow-back-outline" class="mr-2"></ion-icon>
                    返回未來生涯GPS
                </a>
                <a href="../index.html" class="inline-flex items-center justify-center px-8 py-3 border border-purple-300 text-base font-medium rounded-lg text-purple-600 bg-white hover:bg-purple-50 transition duration-300">
                    <ion-icon name="home-outline" class="mr-2"></ion-icon>
                    返回首頁
                </a>
            </div>

        </div>
    </main>

    <script is:inline type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script is:inline nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

    <style is:global>
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .gradient-text {
            background: linear-gradient(45deg, #8b5cf6, #4f46e5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-fill-color: transparent;
        }

        .coming-soon-badge {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        @keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: .5;
            }
        }
    </style>
</BaseLayout>
