---
import BaseLayout from '../../layouts/BaseLayout.astro';
// 自架的第三方函式庫放在 public/vendor/，路徑要帶上部署的 base。
const vendorBase = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<BaseLayout
  title="核心素養互動對照表 - 台灣教育處方籤"
  description="核心素養互動探索"
  currentSection="career-exploration"
  bodyClass="bg-gray-100 text-gray-800"
>
    <main id="main-content" class="container mx-auto px-6 py-12">
        <section class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-black text-gray-800 mb-4">
                核心素養<span class="gradient-text">互動探索</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
                將抽象的「三面九項」轉化為具體行動。展開各項看說明，或透過學群篩選，找到你的能力優勢。
            </p>
        </section>

        <section class="mb-12 p-4 bg-white rounded-xl shadow-md sticky top-16 z-30" data-autohide-filters>
            <div class="flex flex-col md:flex-row items-center gap-4">
                <label for="cluster-filter" class="font-bold text-gray-700 shrink-0"><i data-feather="filter" class="inline-block -mt-1"></i> 依學群篩選：</label>
                <select id="cluster-filter" class="w-full bg-gray-100 border-2 border-gray-200 text-gray-700 py-2 px-4 pr-8 rounded-lg leading-tight focus:outline-hidden focus:bg-white focus:border-indigo-500">
                    <option value="all">顯示所有</option>
                    <!-- 學群選項由 renderCompetencies() 動態填充 -->
                    </select>
            </div>
            <p id="filter-status" role="status" class="sr-only"></p>
        </section>

        <section id="competency-grid" class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            <!-- 素養卡片由 renderCompetencies() 動態填充 -->
            </section>

        <section id="ai-analyst" class="mt-20">
            <div class="bg-white p-8 rounded-xl shadow-lg">
                 <h2 class="text-2xl md:text-3xl font-bold mb-2 flex items-center gap-3">
                    <i data-feather="cpu" class="text-indigo-500"></i>
                    <span>AI 對照核心素養</span>
                 </h2>
                 <p class="text-gray-600 mb-6">貼上你的活動經驗，AI 會從九項核心素養挑出 2 到 3 項，每項附一句寫作建議。</p>
                 <div class="mb-4">
                     <textarea id="ai-input" maxlength="1000" aria-label="你的活動經驗" aria-describedby="ai-input-limit" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-hidden focus:ring-2 focus:ring-indigo-500 transition" rows="4" placeholder="例如：我參加了學校的科展，從找資料、設計實驗到分析數據都自己來。過程中失敗了三次，但也學會了怎麼解決問題，最後有拿到佳作。"></textarea>
                     <p id="ai-input-limit" class="mt-1 text-sm text-gray-500">最多 1000 字</p>
                 </div>
                 <button id="ai-generate-btn" class="w-full bg-indigo-600 text-white font-bold py-3 px-8 rounded-lg hover:bg-indigo-700 transition duration-300 flex items-center justify-center space-x-2">
                     <i data-feather="zap"></i>
                     <span>開始對照</span>
                 </button>
                 {/* 進度與草稿放在沒有 aria-live 的 #ai-work，#ai-result 只放最後的答案或訊息：WebKit 會把
                     live region 裡任何子孫的變化送給 VoiceOver，子孫自己設 aria-live="off" 也擋不住。 */}
                 <div class="mt-6">
                     <div id="ai-work"></div>
                     <div id="ai-result" aria-live="polite"></div>
                 </div>
            </div>
        </section>
    </main>

    <!-- 自架而非 CDN：第三方網域掛掉時本站功能會跟著失效，而且沒有任何建置期
         檢查會發現。版本由 package-lock.json 鎖定，檔案由 scripts/vendor-assets.mjs
         從 node_modules 複製；檔案缺少時 check:site 會在 CI 擋下。 -->
    <script is:inline src={`${vendorBase}/vendor/feather.min.js`}></script>

    <script is:inline src="../shared/platform-ai.js"></script>
    <script is:inline>
        const competencyData = { "自主行動": { icon: 'user-check', color: 'indigo', items: [ { name: 'A1 身心素質與自我精進', description: '具備良好身心狀態與正向價值觀，持續學習、追求更好的自己。', examples: ['規律運動，維持健康生活', '參與正念或冥想活動，提升專注力', '閱讀課外讀物，主動拓展視野', '設定短期學習目標（如學會一個新技能）並努力達成'], clusters: ['醫藥衛生', '遊憩運動', '教育'] }, { name: 'A2 系統思考與解決問題', description: '能理解問題的複雜性，分析背後成因，並提出有效的解決方案。', examples: ['製作心智圖分析課文或社會議題的架構', '參與科展，從零開始設計實驗流程', '學習程式設計，解決生活中的不便', '分析一個歷史事件的多方因果關係'], clusters: ['工程', '資訊', '財經', '生命科學', '法政'] }, { name: 'A3 規劃執行與創新應變', description: '能夠制定計畫、有效執行，並在面對變化時，發揮創意、彈性調整。', examples: ['完成一份完整的自主學習計畫與成果', '擔任社團幹部，從籌辦到執行一場活動', '規劃家庭旅遊或班級出遊的完整行程', '在小組報告中，主動提出新的呈現方式（如拍影片、做網站）'], clusters: ['管理', '設計', '大眾傳播', '建築'] } ] }, "溝通互動": { icon: 'message-circle', color: 'blue', items: [ { name: 'B1 符號運用與溝通表達', description: '善用語言、文字、圖表等多元符號，清晰表達想法並理解他人。', examples: ['上台進行一場有結構、有吸引力的口頭報告', '撰寫一篇結構完整、論點清晰的小論文', '將複雜數據製作成易懂的資訊圖表（Infographic）', '學習一種新的外語或程式語言並實際應用'], clusters: ['外語', '文史哲', '大眾傳播', '財經', '藝術'] }, { name: 'B2 科技資訊與媒體素養', description: '能有效運用科技與資訊，並具備判讀、思辨媒體訊息的能力。', examples: ['學習使用試算表或統計軟體分析數據', '針對一個網路熱議事件，進行事實查核與來源分析', '經營一個有主題的社群帳號或部落格', '學習影片剪輯或修圖軟體，製作個人作品'], clusters: ['資訊', '工程', '生命科學', '大眾傳播', '管理'] }, { name: 'B3 藝術涵養與美感素養', description: '能感知、欣賞與創作美的事物，並將美感融入生活之中。', examples: ['參觀美術館或表演藝術活動，並寫下心得評論', '學習一項樂器或繪畫技巧，並完成一項作品', '為班級或社團活動設計海報或文宣品', '留意生活周遭的建築、產品或服裝設計細節'], clusters: ['藝術', '設計', '建築', '文史哲'] } ] }, "社會參與": { icon: 'users', color: 'purple', items: [ { name: 'C1 道德實踐與公民意識', description: '具備道德判斷力，關心公共議題，並以負責任的態度參與社會。', examples: ['長期參與一項志工服務，並反思其意義', '針對一項公共政策（如交通、環保）提出自己的看法與建議', '了解選舉制度與民主運作，並與家人朋友討論', '在團隊中展現誠信與責任感，完成被託付的任務'], clusters: ['法政', '社會與心理', '教育', '農林漁牧'] }, { name: 'C2 人際關係與團隊合作', description: '能與他人建立正向的互動關係，並在團隊中有效溝通、分工合作。', examples: ['在小組報告中，扮演促進討論或協調衝突的角色', '參加球隊等團體性社團，學習團隊默契與策略', '學習傾聽並尊重與自己不同的意見', '組織讀書會，與同學共學、解決課業問題'], clusters: ['管理', '社會與心理', '教育', '遊憩運動', '醫藥衛生'] }, { name: 'C3 多元文化與國際理解', description: '尊重並欣賞不同文化，並具備全球視野，關心國際事務。', examples: ['學習一種新住民語言或原住民文化', '深入研究一個國家的歷史、文化或社會現況', '關注一項國際新聞或全球議題（如 SDGs），並提出觀點', '透過網路或實體活動，與外國朋友進行文化交流'], clusters: ['外語', '文史哲', '法政', '地球環境'] } ] } };

        const gridContainer = document.getElementById('competency-grid');
        const filterSelect = document.getElementById('cluster-filter');

        function escapeHtml(value) {
            return String(value).replace(/[&<>"']/g, (c) => (
                { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
            ));
        }

        function renderCompetencies() {
            gridContainer.innerHTML = '';
            const allClusters = new Set();

            for (const face in competencyData) {
                const faceData = competencyData[face];
                const column = document.createElement('div');
                column.className = 'space-y-8';

                let itemsHtml = '';
                faceData.items.forEach(item => {
                    item.clusters.forEach(cl => allClusters.add(cl));
                    const examplesHtml = item.examples.map(ex => `<li class="flex items-start gap-2"><i data-feather="arrow-right" class="w-4 h-4 text-${faceData.color}-500 mt-1 shrink-0"></i><span>${escapeHtml(ex)}</span></li>`).join('');
                    const clustersHtml = item.clusters.map(cl => `<span class="cluster-tag inline-block bg-gray-200 text-gray-700 text-xs font-medium mr-2 mb-2 px-2.5 py-1 rounded-full">${escapeHtml(cl)}</span>`).join('');
                    const contentId = `content-${item.name.replace(/\s+/g, '-')}`;
                    itemsHtml += `<div class="competency-card bg-white rounded-lg shadow-md border-2 border-transparent transition-all duration-300" data-clusters='${escapeHtml(JSON.stringify(item.clusters))}'><h3><button class="accordion-toggle w-full text-left p-4 flex justify-between items-center" aria-expanded="false" aria-controls="${escapeHtml(contentId)}"><span class="font-bold text-lg text-gray-800">${escapeHtml(item.name)}<span class="match-note sr-only" hidden>（相關）</span></span><i data-feather="chevron-down" class="transition-transform"></i></button></h3><div id="${escapeHtml(contentId)}" class="accordion-content px-4"><p class="text-gray-600 text-sm mb-4">${escapeHtml(item.description)}</p><h4 class="font-semibold text-sm mb-2 text-gray-800">如何展現這項素養？</h4><ul class="space-y-1.5 text-sm text-gray-700 mb-4">${examplesHtml}</ul><h4 class="font-semibold text-sm mb-2 text-gray-800">相關大學學群</h4><div>${clustersHtml}</div></div></div>`;
                });

                column.innerHTML = `<div class="bg-white rounded-xl shadow-lg p-6 md:sticky md:top-[138px]" data-sticky-cover><div class="flex items-center text-${faceData.color}-600"><i data-feather="${faceData.icon}" class="w-8 h-8"></i><h2 class="text-2xl font-bold ml-3">${escapeHtml(face)}</h2></div></div><div class="space-y-6">${itemsHtml}</div>`;
                gridContainer.appendChild(column);
            }

            const sortedClusters = [...allClusters].sort();
            sortedClusters.forEach(cl => { const option = document.createElement('option'); option.value = cl; option.textContent = cl; filterSelect.appendChild(option); });

            document.querySelectorAll('.accordion-toggle').forEach(button => {
                button.addEventListener('click', () => {
                    const card = button.closest('.competency-card');
                    const icon = button.querySelector('i');
                    const isOpen = card.classList.toggle('is-open');
                    button.setAttribute('aria-expanded', isOpen);
                    if (icon) icon.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
                });
            });
        }

        // 不相關的卡片只是變淡，看不到畫面的人要靠卡片名稱後面的「（相關）」和 #filter-status 的筆數分辨。
        const filterStatus = document.getElementById('filter-status');
        filterSelect.addEventListener('change', (e) => {
            const selectedCluster = e.target.value;
            const cards = document.querySelectorAll('.competency-card');
            let matched = 0;
            cards.forEach(card => {
                const note = card.querySelector('.match-note');
                if (selectedCluster === 'all') {
                    card.classList.remove('highlight');
                    card.style.opacity = '1';
                    note.hidden = true;
                } else {
                    const cardClusters = JSON.parse(card.dataset.clusters);
                    const isMatch = cardClusters.includes(selectedCluster);
                    card.classList.toggle('highlight', isMatch);
                    card.style.opacity = isMatch ? '1' : '0.4';
                    note.hidden = !isMatch;
                    if (isMatch) matched++;
                }
            });
            filterStatus.textContent = selectedCluster === 'all'
                ? `顯示全部 ${cards.length} 項素養`
                : `${matched} 項素養與「${selectedCluster}」學群相關`;
        });

        // 素養對照的 prompt 在閘道的 competency-analysis 任務（ai-gateway/src/task-catalog.mjs），頁面只送活動經驗。
        const aiInput = document.getElementById('ai-input');
        const aiGenerateBtn = document.getElementById('ai-generate-btn');
        const aiWorkContainer = document.getElementById('ai-work');
        const aiResultContainer = document.getElementById('ai-result');
        const aiBtnLabel = aiGenerateBtn.querySelector('span');
        // platform-ai.js 沒載入時沒有 describeError 可用，改顯示這句，與它對未知錯誤的說法相同。
        const FALLBACK_ERROR_TEXT = '抱歉，AI 服務發生錯誤，請稍後再試。';

        // partial：沒寫完的答案已經收到的部分，標明沒有寫完，放在訊息上面
        function showMessage(text, tone = 'error', partial = '') {
            aiResultContainer.textContent = '';
            if (partial) {
                const box = createAnswerBox(partial, true);
                const label = document.createElement('p');
                label.className = 'not-prose text-sm font-semibold text-gray-600';
                label.textContent = 'AI 的回答（沒有寫完）';
                box.prepend(label);
                aiResultContainer.appendChild(box);
            }
            const p = document.createElement('p');
            // red-500 對白底只有 3.8:1，不到 WCAG 對一般文字要求的 4.5:1
            p.className = (tone === 'error' ? 'text-red-700' : 'text-gray-600') + ' text-center font-semibold';
            p.textContent = text;
            aiResultContainer.appendChild(p);
        }

        // renderMarkdown 先 escape 再轉換，輸出可以直接放進 innerHTML。回答裡的標題接在這一區的 h2 底下。
        // partial 表示文字沒寫完（草稿、斷掉的回答）。
        function createAnswerBox(markdown, partial = false) {
            const box = document.createElement('div');
            box.className = 'prose max-w-none p-4 bg-indigo-50 rounded-lg';
            box.innerHTML = PlatformAI.renderMarkdown(markdown, { headingLevel: 3, partial });
            return box;
        }

        aiGenerateBtn.addEventListener('click', async () => {
            // 停用時只設 aria-disabled，點擊照樣會進來。不用 disabled：按鈕會失去焦點，鍵盤使用者的焦點掉回 <body>。
            if (aiGenerateBtn.getAttribute('aria-disabled') === 'true') return;
            const experience = aiInput.value.trim();
            if (!experience) {
                showMessage('請先輸入你的活動經驗描述！');
                return;
            }

            // 進行中停用按鈕，要停止就按進度區塊的「取消」。只換 <span> 的文字，圖示才不會被清掉。
            const originalLabel = aiBtnLabel.textContent;
            aiGenerateBtn.setAttribute('aria-disabled', 'true');
            aiGenerateBtn.classList.add('opacity-50', 'cursor-not-allowed');
            aiBtnLabel.textContent = '分析中…';
            aiResultContainer.textContent = '';

            const controller = new AbortController();
            // mountProgress 放在 try 裡：PlatformAI 沒載入時它會丟 ReferenceError，按鈕仍要靠 finally 恢復。
            let progress = null;
            let drawDraft = null;
            try {
                progress = PlatformAI.mountProgress(aiWorkContainer, {
                    onCancel: () => controller.abort(),
                    focusTarget: aiGenerateBtn,
                    // 焦點在這一區（輸入框、按鈕、結果）時按 Esc 等於按取消
                    escapeScope: document.getElementById('ai-analyst'),
                });
                let draft = null;
                const draw = (_, text) => {
                    const box = createAnswerBox(text, true);
                    if (draft) draft.replaceWith(box);
                    else aiWorkContainer.appendChild(box);
                    draft = box;
                };
                // 部署後十分鐘內，瀏覽器快取裡的 platform-ai.js 可能還是沒有 perFrame 的舊版，那時每段都畫。
                drawDraft = PlatformAI.perFrame ? PlatformAI.perFrame(draw) : Object.assign(draw, { cancel() {} });
                const { result } = await PlatformAI.runTask('competency-analysis', { experience }, {
                    signal: controller.signal,
                    onProgress: progress.update,
                    onDelta: drawDraft,
                });
                // 先 finish() 再清空：焦點在取消鈕上時，finish() 會把它交給按鈕，直接清空會掉回 <body>。
                progress.finish();
                aiWorkContainer.textContent = '';
                // 以 done 的 result 為準，片段接起來的只是草稿。
                aiResultContainer.appendChild(createAnswerBox(result));
            } catch (error) {
                if (progress) progress.finish();
                aiWorkContainer.textContent = '';
                const text = typeof PlatformAI === 'undefined' ? FALLBACK_ERROR_TEXT : PlatformAI.describeError(error);
                // 錯誤帶著已經收到的答案（沒寫完、斷線、逾時、接續輪忙線）就留在畫面上；沒有的照常拿掉草稿
                showMessage(text, error && error.name === 'AbortError' ? 'info' : 'error', error && error.partial);
            } finally {
                if (drawDraft) drawDraft.cancel();
                aiGenerateBtn.removeAttribute('aria-disabled');
                aiGenerateBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                aiBtnLabel.textContent = originalLabel;
            }
        });

        renderCompetencies();
        // 圖示都是裝飾，名稱由旁邊的文字提供。
        feather.replace({ 'aria-hidden': 'true' });
    </script>

    <style is:global>
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
            background-color: #f8fafc;
        }
        /* 收合時用 visibility: hidden，螢幕報讀器才不會讀到看不見的內容；延到高度收完才隱藏，動畫照舊。 */
        #competency-grid .competency-card .accordion-content {
            max-height: 0;
            overflow: hidden;
            padding-top: 0;
            padding-bottom: 0;
            opacity: 0;
            visibility: hidden;
            transition: max-height 0.4s ease-in-out, padding 0.3s ease-in-out, opacity 0.3s ease-in-out, visibility 0s linear 0.4s;
        }
        #competency-grid .competency-card.is-open .accordion-content {
            max-height: 2000px;
            padding-top: 0;
            padding-bottom: 1rem;
            opacity: 1;
            visibility: visible;
            transition: max-height 0.4s ease-in-out, padding 0.3s ease-in-out, opacity 0.3s ease-in-out, visibility 0s;
        }
        .competency-card.highlight {
            transform: scale(1.02);
            box-shadow: 0 0 0 3px #8b5cf6, 0 10px 15px -3px rgb(0 0 0 / 0.1);
            border-color: #8b5cf6;
        }
    </style>
</BaseLayout>
