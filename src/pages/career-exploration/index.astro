---
import BaseLayout from '../../layouts/BaseLayout.astro';
// 自架的第三方函式庫放在 public/vendor/，路徑要帶上部署的 base。
const vendorBase = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<BaseLayout
  title="未來生涯GPS 2.0 - 台灣教育處方籤"
  description="未來生涯GPS 2.0"
  currentSection="career-exploration"
  bodyClass="bg-gray-50 text-gray-800"
>
    <main id="main-content" class="container mx-auto px-4 sm:px-6 py-12">

        <section class="text-center mb-20">
            <h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 mb-4 leading-tight">
                未來生涯<span class="gradient-text">GPS</span> 2.0
            </h1>
            <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
                將你的高中學習，精準定位到未來方向。結合 AI 學涯導師，探索大學學群，聆聽學長姐的真實建議。
            </p>
        </section>

        <section id="ai-advisor" class="mb-20">
            <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8 max-w-4xl mx-auto">
                <div class="flex items-center gap-4 mb-6">
                    <div class="bg-indigo-100 p-3 rounded-full">
                        <ion-icon aria-hidden="true" name="sparkles-outline" class="text-3xl text-indigo-600"></ion-icon>
                    </div>
                    <div>
                        <h2 class="text-2xl md:text-3xl font-bold text-gray-900">AI 學涯導師</h2>
                        <p class="text-gray-600">對未來感到迷惘嗎？試著問我問題吧！</p>
                    </div>
                </div>

                <div id="chat-window" class="h-64 overflow-y-auto p-4 bg-gray-50 rounded-lg mb-4 space-y-4">
                    {/* 對話紀錄只放完成的訊息。串流中的草稿由程式接在紀錄後面，不在 live region 裡。 */}
                    <div id="chat-log" role="log" aria-label="對話紀錄" class="space-y-4">
                        <div class="flex gap-2 items-end">
                            <div class="w-8 h-8 bg-indigo-200 rounded-full flex items-center justify-center flex-shrink-0">
                                <ion-icon name="sparkles" aria-hidden="true" class="text-indigo-600"></ion-icon>
                            </div>
                            <div class="chat-bubble-ai p-3 max-w-lg">
                                <p class="text-sm sm:text-base">你好！我是 AI 學涯導師。你可以告訴我你喜歡的科目、興趣，或任何對未來科系的疑問，我會試著給你一些建議。例如：「我喜歡動手做東西，也對電腦有興趣，適合讀什麼？」</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex gap-2">
                    <input type="text" id="chat-input" maxlength="200" aria-label="你的問題" aria-describedby="chat-input-hint" class="placeholder:text-gray-600 flex-grow min-w-0 bg-gray-100 border-2 border-gray-200 rounded-full py-3 px-5 focus:outline-hidden focus:border-indigo-500 transition-colors" placeholder="在這裡輸入你的問題...">
                    <button id="chat-submit" class="shrink-0 bg-indigo-600 text-white rounded-full px-5 py-3 font-semibold hover:bg-indigo-700 active:bg-indigo-800 transition-all duration-300 transform hover:scale-105 flex items-center">
                        <span class="hidden sm:inline">發送</span>
                        {/* 窄螢幕上文字隱藏，按鈕的名稱只能來自圖示。 */}
                        <ion-icon name="send-outline" aria-label="發送" class="sm:hidden text-xl"></ion-icon>
                    </button>
                </div>
                {/* career-chat 每次只送這一題，不帶先前的對話（ai-gateway/src/task-catalog.mjs）。 */}
                <p id="chat-input-hint" class="mt-2 text-sm text-gray-500">每一題都分開回答，AI 看不到前面的問答。想接著問，請把需要的背景寫進同一題，最多 200 字。</p>
                <div id="chat-progress"></div>
            </div>
        </section>

        <section id="explorer" class="bg-white p-4 sm:p-8 rounded-2xl shadow-lg">
            <div class="text-center mb-10">
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900">大學科系羅盤</h2>
                <p class="text-gray-600 mt-2">從學群清單選一個學群，或輸入名稱搜尋。</p>
                <a href="clusters/index.html" class="inline-flex items-center gap-2 mt-4 text-indigo-600 font-semibold hover:underline">
                    十大學群升學指南
                    <ion-icon aria-hidden="true" name="arrow-forward-outline"></ion-icon>
                </a>
            </div>
            <div class="flex flex-col md:flex-row gap-8">

                <div class="md:w-1/3 lg:w-1/4 flex flex-col gap-4">
                    <div class="relative">
                        <input type="text" id="search-bar" aria-label="搜尋學群" class="placeholder:text-gray-600 w-full bg-gray-100 border-2 border-transparent rounded-full py-3 pl-10 pr-4 focus:outline-hidden focus:border-indigo-500 transition-colors" placeholder="搜尋學群...">
                        <ion-icon aria-hidden="true" name="search-outline" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></ion-icon>
                    </div>
                    <p id="result-status" role="status" class="sr-only"></p>
                    <div id="cluster-list" role="group" aria-label="學群清單" class="space-y-2 overflow-y-auto max-h-[60vh] pr-2">
                        </div>
                </div>

                <div id="cluster-details" class="md:w-2/3 lg:w-3/4 bg-slate-50 p-4 sm:p-6 rounded-xl min-h-[300px]">
                    </div>
            </div>
        </section>

        <section class="mt-24">
            <div class="text-center mb-12">
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900">學長姐真心話</h2>
                <p class="text-lg text-gray-600 mt-2">讓走過這條路的人，告訴你最真實的風景。</p>
            </div>
            <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 flex flex-col items-center text-center transform hover:-translate-y-1">
                    <img class="w-24 h-24 rounded-full mb-4 object-cover shadow-md ring-4 ring-white" src="https://api.dicebear.com/7.x/avataaars/svg?seed=wang&backgroundColor=c0aede,d1d4f9,ffdfbf,f0f0f0&backgroundType=gradientLinear" alt="王同學頭像">
                    <h3 class="font-bold text-xl text-gray-900">王同學</h3>
                    <p class="text-indigo-600 font-semibold mb-4">陽明交通大學 生物科技學系</p>
                    <p class="text-gray-700 italic">「高中時的科展經驗，不只是為了得獎。從中學到的實驗設計和解決問題的能力，才是在大學真正派上用場的關鍵。」</p>
                </div>
                <div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 flex flex-col items-center text-center transform hover:-translate-y-1">
                    <img class="w-24 h-24 rounded-full mb-4 object-cover shadow-md ring-4 ring-white" src="https://api.dicebear.com/7.x/avataaars/svg?seed=lin&hair=long&backgroundColor=c0aede,d1d4f9,ffdfbf,f0f0f0&backgroundType=gradientLinear" alt="林同學頭像">
                    <h3 class="font-bold text-xl text-gray-900">林同學</h3>
                    <p class="text-indigo-600 font-semibold mb-4">政治大學 傳播學院</p>
                    <p class="text-gray-700 italic">「不要害怕在學習歷程中放入看似『不務正業』的經驗。我經營社群帳號的過程，反而成為面試時教授最感興趣的亮點。」</p>
                </div>
            </div>
            <div class="text-center mt-12">
                <a href="senior-interviews.html" class="bg-indigo-600 text-white font-bold py-3 px-8 rounded-lg hover:bg-indigo-700 transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-lg">
                    查看更多訪談
                </a>
            </div>
        </section>

    </main>

    {/* 自架而非 CDN：第三方網域掛掉時本站功能會跟著失效，而且沒有任何建置期
         檢查會發現。版本由 package-lock.json 鎖定，檔案由 scripts/vendor-assets.mjs
         從 node_modules 複製。這個檔被 script[src] 指名，check:site 會驗它，
         而且會從它遞移走 ES module 的 import 圖，所以它靜態 import 的
         p-*.js chunk 同樣在守備範圍內（chunk 檔名帶 hash，寫不進這裡的樣板，
         只可能靠 import 圖驗；實測刪掉那個 chunk，17 個 ion-icon 全部不渲染）。

         守備範圍到此為止，別多說：stencil 的 loader 是用 import(變數) 去
         lazy-load ion-icon 的 entry chunk 的，那種靜態分析看不到。那一層靠
         vendor 步驟整個目錄搬過來，以及 tests/e2e 的 shadow DOM 檢查。

         這裡不放 nomodule 的 ES5 後備（#94）。ionicons 8 沒有 ES5 loader；而且
         nomodule 只在不支援 ES module 的瀏覽器（IE11／Edge ≤18／Safari ≤10）執行，
         那些瀏覽器本來就跑不了本頁的 inline script：箭頭函式在 IE11 是 SyntaxError，
         整段不會執行，左側學群清單根本不會渲染。首頁的搜尋腳本也一樣（用了
         firstItem?.title 這種 ES2020 語法）。

         ion-icon 由下面這個 module loader 註冊，tests/e2e/site-smoke.spec.js 會檢查
         每個 ion-icon 的 shadow DOM 裡真的有 svg 元素（找不到 SVG 時 ion-icon 不報錯
         只是不顯示，所以必須這樣驗）。 */}
    <script is:inline type="module" src={`${vendorBase}/vendor/ionicons/ionicons.esm.js`}></script>

    <script is:inline src="../shared/platform-ai.js"></script>
    <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

        // description 到 careers 照 url 指的 ColleGo! 學群頁（2026-10-29 查閱）：簡要介紹、核心素養圖表
        // 重視百分比最高的兩項、主要學類、重要學科、生涯發展。name 是本站學群頁的名稱，collego 是
        // ColleGo! 的名稱。portfolio_tips 是本站寫的建議。
        // 名稱、簡介、核心素養、主要學類與相關職類另外抄在 AI 閘道 career-chat 任務的指令裡
        // （ai-gateway/src/task-catalog.mjs），ai-gateway/test/task-catalog.test.mjs 會比對兩邊。
