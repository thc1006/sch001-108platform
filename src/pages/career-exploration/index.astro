            { id: 'life_sci', name: '生命科學學群', collego: '生命科學學群', icon: 'leaf-outline', description: '生命科學學群著重於動植物生活型態、生命現象的知識探究，包括生命的發生、遺傳、演化、構造、功能、細胞及分子層次機制等。', competencies: ['系統思考與解決問題', '規劃執行與創新應變'], majors: ['生物資訊', '生醫工程', '生化', '生命科學', '生物科技', '植物保護', '生態', '食品生技'], subjects: ['生物', '化學', '英語文', '數學', '國語文', '物理'], careers: ['工程／研發／生技相關職類', '教育／學術／研究相關職類'], portfolio_tips: '可以呈現科展、生物奧林匹亞的經驗，或對特定生物議題（例如基因編輯）的探討報告。', url: 'https://collego.edu.tw/Highschool/CollegeIntro?current_college_id=5', guide: 'life-science' },
            { id: 'medicine', name: '醫藥衛生學群', collego: '醫藥衛生學群', icon: 'medkit-outline', description: '醫藥衛生學群學習維護人類身心健康相關之知識及技術，從個人到整個人群，包括身心健康的維持、疾病或傷害的預防與治療。', competencies: ['系統思考與解決問題', '人際關係與團隊合作'], majors: ['醫學', '公共衛生', '牙醫', '物理治療', '職能治療', '護理', '醫學檢驗', '影像放射', '藥學', '食品營養', '呼吸治療', '健康照護', '化妝品', '職業安全', '獸醫', '醫務管理', '運動保健', '視光', '語療聽力'], subjects: ['生物', '英語文', '國語文', '化學', '健康與護理', '數學'], careers: ['醫療／美容／生命相關職類', '教育／學術／研究相關職類'], portfolio_tips: '可以呈現參加醫療相關營隊、志工服務的經驗與反思。', url: 'https://collego.edu.tw/Highschool/CollegeIntro?current_college_id=4', guide: 'medicine' },
        ];

        const clusterListContainer = document.getElementById('cluster-list');
        const clusterDetailsContainer = document.getElementById('cluster-details');
        const searchBar = document.getElementById('search-bar');
        const resultStatus = document.getElementById('result-status');
        // 筆數只在使用者改了條件之後念，第一次載入不念；打字時停 400 毫秒再念。
        let shownCount = 0;
        let announceTimer;
        function announceCount(delay = 0) {
            clearTimeout(announceTimer);
            announceTimer = setTimeout(() => { resultStatus.textContent = `顯示 ${shownCount} 筆`; }, delay);
        }
        const chatInput = document.getElementById('chat-input');
        const chatSubmit = document.getElementById('chat-submit');
        const chatWindow = document.getElementById('chat-window');

        function escapeHtml(value) {
            return String(value).replace(/[&<>"']/g, (c) => (
                { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
            ));
        }

        function renderClusterDetails(clusterId) {
            const cluster = majorData.find(c => c.id === clusterId);
            if (!cluster) {
                clusterDetailsContainer.innerHTML = `<p class="text-center text-gray-500">請先從學群清單選一個學群。</p>`;
                return;
            }

            clusterDetailsContainer.innerHTML = `
                <div class="flex items-start gap-4 mb-4">
                    <div class="bg-indigo-100 p-3 rounded-xl">
                        <ion-icon aria-hidden="true" name="${escapeHtml(cluster.icon)}" class="text-3xl text-indigo-600"></ion-icon>
                    </div>
                    <div>
                        <h3 class="text-2xl font-bold text-gray-900">${escapeHtml(cluster.name)}</h3>
                        <p class="text-gray-600">${escapeHtml(cluster.description)}</p>
                        <p class="mt-1 text-sm text-gray-500">ColleGo!「${escapeHtml(cluster.collego)}」的簡要介紹</p>
                    </div>
                </div>

                <div class="border-b border-gray-200 mb-4">
                    <div class="tab-list -mb-px flex space-x-6" role="group" aria-label="${escapeHtml(cluster.name)}的資訊">
                        <button class="tab-btn active" data-tab="competencies" aria-pressed="true" aria-controls="tab-competencies">核心素養</button>
                        <button class="tab-btn" data-tab="careers" aria-pressed="false" aria-controls="tab-careers">生涯發展</button>
                        <button class="tab-btn" data-tab="portfolio" aria-pressed="false" aria-controls="tab-portfolio">歷程建議</button>
                    </div>
                </div>

                <div id="tab-content-area" class="text-gray-700">
                    <div id="tab-competencies" class="tab-panel">
                        <h4 class="font-bold text-lg mb-3">重視程度前兩名的核心素養</h4>
                        <div class="flex flex-wrap gap-2">
                            ${cluster.competencies.map(c => `<span class="inline-block bg-indigo-100 text-indigo-800 text-sm font-medium px-3 py-1 rounded-full">${escapeHtml(c)}</span>`).join('')}
                        </div>
                        <h4 class="font-bold text-lg mt-4 mb-3">重要學科</h4>
                        <div class="flex flex-wrap gap-2">
                            ${cluster.subjects.map(s => `<span class="inline-block bg-green-100 text-green-800 text-sm font-medium px-3 py-1 rounded-full">${escapeHtml(s)}</span>`).join('')}
                        </div>
                        <h4 class="font-bold text-lg mt-4 mb-3">主要學類</h4>
                        <div class="flex flex-wrap gap-2">
                            ${cluster.majors.map(m => `<span class="inline-block bg-gray-200 text-gray-800 text-sm font-medium px-3 py-1 rounded-full">${escapeHtml(m)}</span>`).join('')}
                        </div>
                        <p class="mt-4 text-sm text-gray-500">核心素養、重要學科與主要學類照 ColleGo!「${escapeHtml(cluster.collego)}」的頁面，2026 年 10 月查閱。</p>
                    </div>
                    <div id="tab-careers" class="tab-panel hidden">
                        <h4 class="font-bold text-lg mb-3">相關職類</h4>
                        <ul class="list-disc list-inside space-y-1">
                            ${cluster.careers.map(c => `<li>${escapeHtml(c)}</li>`).join('')}
                        </ul>
                        <p class="mt-4 text-sm text-gray-500">照 ColleGo!「${escapeHtml(cluster.collego)}」頁面的「生涯發展」原樣列出，是職類的大分類，不是完整的出路清單。2026 年 10 月查閱。</p>
                    </div>
                    <div id="tab-portfolio" class="tab-panel hidden">
                        <h4 class="font-bold text-lg mb-3">學習歷程準備方向</h4>
                        <p>${escapeHtml(cluster.portfolio_tips)}</p>
                    </div>
                </div>

                <div class="mt-6 flex flex-wrap gap-3">
                    <a href="clusters/${encodeURI(cluster.guide)}/index.html" class="inline-flex items-center gap-2 bg-indigo-600 text-white font-bold py-2 px-4 rounded-lg hover:bg-indigo-700 transition duration-300">
                        查看升學指南 <ion-icon aria-hidden="true" name="arrow-forward-outline"></ion-icon>
                    </a>
                    <a href="${encodeURI(cluster.url)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-white border border-indigo-300 text-indigo-600 font-bold py-2 px-4 rounded-lg hover:bg-indigo-50 transition duration-300">
                        前往 ColleGo! <ion-icon aria-hidden="true" name="open-outline"></ion-icon><span class="sr-only">（另開新分頁）</span>
                    </a>
                </div>
            `;

            addTabEventListeners();
            clusterDetailsContainer.classList.remove('fade-in');
            void clusterDetailsContainer.offsetWidth; // 強制重排，fade-in 動畫才會重播
            clusterDetailsContainer.classList.add('fade-in');
        }

        function handleClusterClick(e) {
            const button = e.target.closest('.cluster-btn');
            if (!button) return;

            const currentActive = clusterListContainer.querySelector('.active');
            if (currentActive) {
                currentActive.classList.remove('active');
                currentActive.setAttribute('aria-pressed', 'false');
            }
            button.classList.add('active');
            button.setAttribute('aria-pressed', 'true');

            const clusterId = button.dataset.id;
            renderClusterDetails(clusterId);
        }

        function filterClusters() {
            const searchTerm = searchBar.value.toLowerCase();
            const filteredData = majorData.filter(cluster => cluster.name.toLowerCase().includes(searchTerm));
            renderClusterList(filteredData);
            shownCount = filteredData.length;
        }

        function renderClusterList(data) {
            const currentActiveId = clusterListContainer.querySelector('.active')?.dataset.id;
            clusterListContainer.innerHTML = '';
            data.forEach((cluster) => {
                const button = document.createElement('button');
                button.className = 'cluster-btn w-full text-left px-4 py-3 rounded-lg font-semibold flex items-center gap-3';
                button.dataset.id = cluster.id;
                button.innerHTML = `<ion-icon aria-hidden="true" name="${escapeHtml(cluster.icon)}" class="text-xl"></ion-icon> <span>${escapeHtml(cluster.name)}</span>`;
                const isActive = cluster.id === currentActiveId;
                button.classList.toggle('active', isActive);
                button.setAttribute('aria-pressed', String(isActive));
                clusterListContainer.appendChild(button);
            });
        }

        function initializeExplorer() {
            renderClusterList(majorData);

            if (majorData.length > 0) {
                const firstButton = clusterListContainer.querySelector('.cluster-btn');
                if (firstButton) {
                    firstButton.classList.add('active');
                    firstButton.setAttribute('aria-pressed', 'true');
                    renderClusterDetails(majorData[0].id);
                }
            }

            clusterListContainer.addEventListener('click', handleClusterClick);
            searchBar.addEventListener('input', () => { filterClusters(); announceCount(400); });
        }

        function addTabEventListeners() {
            const tabContainer = clusterDetailsContainer.querySelector('.tab-list');
            if (!tabContainer) return;

            tabContainer.addEventListener('click', (e) => {
                const button = e.target.closest('.tab-btn');
                if (!button) return;

                tabContainer.querySelectorAll('.tab-btn').forEach(btn => {
                    btn.classList.toggle('active', btn === button);
                    btn.setAttribute('aria-pressed', String(btn === button));
                });

                clusterDetailsContainer.querySelectorAll('.tab-panel').forEach(panel => panel.classList.add('hidden'));
                const tabId = button.dataset.tab;
                document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            });
        }

        // AI 學涯導師：prompt 與學群資料都在閘道的 career-chat 任務（ai-gateway/src/task-catalog.mjs），
        // 頁面一次只送這一題，不帶先前的對話。
        const chatLog = document.getElementById('chat-log');
        const chatProgress = document.getElementById('chat-progress');
        const chatSubmitLabel = chatSubmit.querySelector('span');
        // platform-ai.js 沒載入成功時用這句，與 describeError 對未知錯誤的說法相同。
        const FALLBACK_ERROR_TEXT = '抱歉，AI 服務發生錯誤，請稍後再試。';
        let chatBusy = false;
        // 回答裡的標題接在 h2「AI 學涯導師」底下。
        const ANSWER_MARKDOWN = { headingLevel: 3 };
        // 沒寫完的文字（草稿、斷掉的回答）：最後一行落單的 ** 等記號拿掉
        const PARTIAL_MARKDOWN = { headingLevel: 3, partial: true };
        // 與 platform-ai.js 的 COOLDOWN_CODES 相同：帶著 retryAfter 時，等完才能再送出
        const WAIT_CODES = ['busy', 'rate_limited', 'too_many_inflight', 'not_ready'];

        function enableChat(label) {
            chatBusy = false;
            chatSubmit.removeAttribute('aria-disabled');
            chatSubmit.classList.remove('opacity-50', 'cursor-not-allowed');
            chatSubmitLabel.textContent = label;
        }

        // 一則訊息的外框、頭像與泡泡；內容由呼叫的人填進 text。
        function createMessage(sender) {
            const row = document.createElement('div');
            if (sender === 'user') {
                row.className = 'flex gap-2 items-end justify-end';
                row.innerHTML = `
                    <div class="chat-bubble-user p-3 max-w-lg">
                        <p class="text-sm sm:text-base text-gray-800"></p>
                    </div>
                    <div class="w-8 h-8 bg-green-200 rounded-full flex items-center justify-center flex-shrink-0">
                        <ion-icon name="person" aria-hidden="true" class="text-green-700"></ion-icon>
                    </div>
                `;
            } else {
                row.className = 'flex gap-2 items-end';
                row.innerHTML = `
                    <div class="w-8 h-8 bg-indigo-200 rounded-full flex items-center justify-center flex-shrink-0">
                        <ion-icon name="sparkles" aria-hidden="true" class="text-indigo-600"></ion-icon>
                    </div>
                    <div class="chat-bubble-ai p-3 max-w-lg">
                        <p class="text-sm sm:text-base"></p>
                    </div>
                `;
            }
            return { row, text: row.querySelector('p') };
        }

        function isScrolledToBottom() {
            return chatWindow.scrollHeight - chatWindow.scrollTop - chatWindow.clientHeight < 4;
        }

        function scrollToBottom() {
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        async function handleChatSubmit() {
            const question = chatInput.value.trim();
            if (chatBusy || !question) return;

            const asked = createMessage('user');
            asked.text.textContent = question;
            chatLog.appendChild(asked.row);
            scrollToBottom();
            chatInput.value = '';
            // 現在就交回輸入框：等回答到了才搬，VoiceOver 可能漏唸回答（WebKit bug 222190）。
            chatInput.focus();

            // 進行中不停用輸入框，按鈕用 aria-disabled 而不是 disabled：有焦點的元素一停用，焦點就
            // 掉到 <body>。學生可以先打下一題，但要等這一題結束才送得出去。
            chatBusy = true;
            const originalLabel = chatSubmitLabel.textContent;
            chatSubmit.setAttribute('aria-disabled', 'true');
            chatSubmit.classList.add('opacity-50', 'cursor-not-allowed');
            chatSubmitLabel.textContent = '思考中...';

            const controller = new AbortController();
            // mountProgress 也要放在 try 裡：PlatformAI 不存在時它會丟 ReferenceError。
            let progress = null;
            let draft = null;
            let drawDraft = null;
            let waitMs = 0;
            // 拿掉草稿，把完成的訊息加進紀錄，螢幕閱讀器唸一次。學生往上捲去看舊訊息時不拉回底部。
            const settle = (message) => {
                const follow = isScrolledToBottom();
                if (draft) draft.row.remove();
                chatLog.appendChild(message.row);
                if (follow) scrollToBottom();
            };
            try {
                // 進度放在輸入列下方。聊天視窗只有 h-64，放進去會擠掉對話，往上捲時取消鈕也會跟著捲走。
                // 焦點交給輸入框而不是按鈕：送出時已經清空輸入框、把焦點交回去，接下來要打的是下一題。
                progress = PlatformAI.mountProgress(chatProgress, {
                    onCancel: () => controller.abort(),
                    focusTarget: chatInput,
                    // 焦點在 AI 學涯導師這一區（輸入框、按鈕、對話紀錄）時按 Esc 等於按取消
                    escapeScope: document.getElementById('ai-advisor'),
                });
                // 草稿接在紀錄後面，不在 live region 裡，否則每收到一段就重唸一次。Safari 連
                // aria-live="off" 子樹裡的變化也算進外層的 live region，放在紀錄裡再關掉沒有用。
                const draw = (_, text) => {
                    const follow = isScrolledToBottom();
                    if (!draft) {
                        draft = createMessage('ai');
                        chatWindow.appendChild(draft.row);
                    }
                    // renderMarkdown 先 HTML escape 再套 markdown，AI 的輸出塞不進可執行的 HTML。
                    draft.text.innerHTML = PlatformAI.renderMarkdown(text, PARTIAL_MARKDOWN);
                    if (follow) scrollToBottom();
                };
                // 部署後十分鐘內，瀏覽器快取裡的 platform-ai.js 可能還是沒有 perFrame 的舊版，那時每段都畫。
                drawDraft = PlatformAI.perFrame ? PlatformAI.perFrame(draw) : Object.assign(draw, { cancel() {} });
                const { result } = await PlatformAI.runTask('career-chat', { question }, {
                    signal: controller.signal,
                    onProgress: progress.update,
                    onDelta: drawDraft,
                });
                progress.finish();
                // 以 done 的結果為準，片段接起來的只是草稿。
                const answer = createMessage('ai');
                answer.text.innerHTML = PlatformAI.renderMarkdown(result, ANSWER_MARKDOWN);
                settle(answer);
            } catch (error) {
                if (progress) progress.finish();
                // 錯誤帶著已經收到的答案（沒寫完、斷線、逾時、接續輪忙線）：先進紀錄、標明沒有寫完，訊息接在後面
                if (error && error.partial) {
                    const partial = createMessage('ai');
                    const label = document.createElement('span');
                    label.className = 'block text-xs font-semibold text-gray-600 mb-1';
                    label.textContent = 'AI 的回答（沒有寫完）';
                    partial.text.before(label);
                    partial.text.innerHTML = PlatformAI.renderMarkdown(error.partial, PARTIAL_MARKDOWN);
                    settle(partial);
                }
                const notice = createMessage('ai');
                notice.text.classList.add(error && error.name === 'AbortError' ? 'text-gray-600' : 'text-red-700');
                notice.text.textContent = typeof PlatformAI === 'undefined' ? FALLBACK_ERROR_TEXT : PlatformAI.describeError(error);
                settle(notice);
                // 閘道說要等時把問題放回輸入框，已經顯示沒寫完的答案、或已經打了下一題就不放。
                // 其他失敗不放回：按鈕馬上能按，連按 Enter 會一直重送
                if (error && WAIT_CODES.includes(error.code) && error.retryAfter > 0) {
                    // 快取裡的舊版 platform-ai.js 不設上限，這裡照新版的：busy 10 分鐘，其他一小時
                    waitMs = Math.min(error.retryAfter, error.code === 'busy' ? 600 : 3600) * 1000;
                    if (!error.partial && !chatInput.value.trim()) chatInput.value = question;
                }
            } finally {
                if (drawDraft) drawDraft.cancel();
                if (waitMs) {
                    chatSubmitLabel.textContent = '請稍候';
                    setTimeout(() => enableChat(originalLabel), waitMs);
                } else {
                    enableChat(originalLabel);
                }
                // Safari 點按鈕不給焦點，滑鼠按了取消時焦點不在進度區塊裡，finish() 不會把它交給輸入框。
                if (controller.signal.aborted) chatInput.focus();
            }
        }

        chatSubmit.addEventListener('click', handleChatSubmit);
        // 用注音、倉頡選字時按 Enter 是確定選字，不能送出。結束選字的那個 keydown 在 Safari 的
        // isComposing 是 false，照 MDN keydown 頁的寫法，keyCode 229 也一起擋。
        chatInput.addEventListener('keydown', (e) => {
            if (e.key !== 'Enter' || e.shiftKey || e.isComposing || e.keyCode === 229) return;
            e.preventDefault();
            handleChatSubmit();
        });

        initializeExplorer();
    });
    </script>

    <style is:global>
        /* 基本字體設定 */
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* 左側學群按鈕樣式 */
        .cluster-btn {
            transition: all 0.3s ease-in-out;
            transform-origin: left;
        }
        .cluster-btn.active {
            background-color: #4f46e5;
            color: white;
            transform: scale(1.03);
            box-shadow: 0 4px 14px 0 rgb(79 70 229 / 39%);
        }
        .cluster-btn:hover:not(.active) {
            background-color: #eef2ff;
            color: #4338ca;
        }

        /* 右側資訊卡片切換時的淡入效果 */
        #cluster-details.fade-in {
            animation: fadeIn 0.5s ease-in-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* AI 聊天室樣式 */
        .chat-bubble-ai {
            background-color: #eef2ff;
            border-radius: 20px 20px 20px 5px;
        }
        .chat-bubble-ai p {
            white-space: pre-wrap; /* 保留換行符並自動換行 */
        }
        .chat-bubble-user {
            background-color: #dcfce7;
            border-radius: 20px 20px 5px 20px;
        }

        /* Tab 樣式 */
        .tab-btn {
            padding: 0.5rem 0.25rem;
            border-bottom: 2px solid transparent;
            color: #6b7280;
            font-weight: 600;
            transition: all 0.2s ease-in-out;
        }
        .tab-btn.active {
            color: #4f46e5;
            border-bottom-color: #4f46e5;
        }
    </style>
</BaseLayout>
