---
import BaseLayout from '../../layouts/BaseLayout.astro';
// 自架的第三方函式庫放在 public/vendor/，路徑要帶上部署的 base。
const vendorBase = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<BaseLayout
  title="學長姐真心話 - 台灣教育處方籤"
  description="學長姐真心話"
  currentSection="career-exploration"
  bodyClass="bg-gray-100 text-gray-800"
>
    <!-- 主要內容 -->
    <main id="main-content" class="container mx-auto px-6 py-12">
        <!-- 主視覺 -->
        <section class="text-center mb-16">
             <div class="w-full h-72 rounded-2xl overflow-hidden mb-8 shadow-lg">
                <img src="https://images.pexels.com/photos/1595385/pexels-photo-1595385.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" class="w-full h-full object-cover" alt="一群學生在討論">
            </div>
            <h1 class="text-4xl md:text-5xl font-black text-gray-800 mb-4">
                學長姐<span class="gradient-text">真心話</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
                讓走過這條路的人，告訴你最真實的風景。這裡沒有標準答案，只有最真誠的經驗分享。
            </p>
            <p class="text-sm text-gray-600 max-w-3xl mx-auto mt-4">
                為保護隱私，以下學長姐均為化名；經驗內容綜合真實升學制度、公開數據與經驗分享整理而成，呈現具代表性的升學樣貌與觀點。文中提及的制度與數據以受訪當下為準，實際請以最新年度招生簡章為主。
            </p>
        </section>

        <!-- 搜尋與分類篩選 -->
        <section id="interviews" class="mb-12 sticky top-16 z-30 bg-gray-100/80 backdrop-blur-md py-4 rounded-xl" data-autohide-filters>
            <div class="flex flex-col md:flex-row justify-center items-center gap-6">
                <!-- 搜尋框 -->
                <div class="relative w-full md:w-auto">
                    <input type="text" id="search-box" placeholder="搜尋科系、學校或關鍵字..." class="pl-10 pr-4 py-2 w-full md:w-64 border-2 border-gray-200 rounded-full focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i data-feather="search" class="text-gray-400 w-5 h-5"></i>
                    </div>
                </div>
                <!-- 分類篩選 -->
                <div id="category-filters" role="group" aria-label="依學群篩選" class="flex flex-wrap justify-center gap-2 md:gap-3">
                    <button class="filter-btn active px-4 py-2 font-semibold text-sm rounded-full transition-all duration-300" data-category="all" aria-pressed="true">全部</button>
                    <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition-all duration-300" data-category="工程學群" aria-pressed="false">工程</button>
                    <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition-all duration-300" data-category="資訊學群" aria-pressed="false">資訊</button>
                    <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition-all duration-300" data-category="管理學群" aria-pressed="false">管理</button>
                    <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition-all duration-300" data-category="財經學群" aria-pressed="false">財經</button>
                    <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition-all duration-300" data-category="社會與心理學群" aria-pressed="false">社會與心理</button>
                    <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition-all duration-300" data-category="大眾傳播學群" aria-pressed="false">傳播</button>
                    <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition-all duration-300" data-category="設計學群" aria-pressed="false">設計</button>
                    <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition-all duration-300" data-category="生命科學學群" aria-pressed="false">生命科學</button>
                    <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition-all duration-300" data-category="醫藥衛生學群" aria-pressed="false">醫藥衛生</button>
                    <button class="filter-btn px-4 py-2 font-semibold text-sm rounded-full transition-all duration-300" data-category="法政學群" aria-pressed="false">法政</button>
                </div>
            </div>
        </section>

        <!-- 訪談卡片網格 -->
        <section>
            <p id="result-status" role="status" class="sr-only"></p>
            <div id="interview-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- 訪談卡片由 renderInterviews() 填入 -->
            </div>
            <p id="no-results" class="text-center text-gray-600 py-16 hidden">找不到符合條件的訪談，試試看別的關鍵字吧！</p>
        </section>
    </main>

    <!-- 訪談詳情對話框 -->
    <dialog id="interviewModal" aria-labelledby="modal-title" class="modal-content bg-white text-inherit w-11/12 max-w-none md:max-w-3xl m-auto rounded-lg shadow-2xl overflow-y-auto outline outline-transparent open:flex flex-col">
        <!-- 對話框內容由 showModal() 填入 -->
    </dialog>

    {/* 複製連結後的提示。透明時文字仍會被螢幕閱讀器讀到，所以加 aria-hidden；複製成功改由對話框裡的 #copy-status 通知。 */}
    <div id="copy-notification" aria-hidden="true" class="fixed bottom-5 right-5 bg-gray-900 text-white px-4 py-2 rounded-lg shadow-lg opacity-0 transition-opacity duration-300">
        連結已複製！
    </div>

    <!-- 自架而非 CDN：第三方網域掛掉時本站功能會跟著失效，而且沒有任何建置期
         檢查會發現。版本由 package-lock.json 鎖定，檔案由 scripts/vendor-assets.mjs
         從 node_modules 複製；檔案缺少時 check:site 會在 CI 擋下。 -->
    <script is:inline src={`${vendorBase}/vendor/feather.min.js`}></script>
    <script is:inline src="../shared/detail-dialog.js"></script>

    <script is:inline>
        // 資料從同目錄的 senior-interviews.json 載入（見下方 loadData）。
        // 要新增或修改資料，請編輯 senior-interviews.json，不需要動這支 HTML。
        let interviewData = [];

        // 大學常見簡稱，讓使用者搜「台大」「政大」也能命中正式全名。
        const UNIVERSITY_ALIASES = {
            '國立臺灣大學': '台大 臺大 ntu',
            '國立政治大學': '政大 nccu',
            '國立成功大學': '成大 ncku',
            '國立清華大學': '清大 nthu',
            '國立陽明交通大學': '陽明交大 交大 nycu',
            '國立中正大學': '中正 ccu',
            '國立臺北科技大學': '北科 北科大 台北科大 ntut',
            '國立臺北商業大學': '北商 北商大 ntub',
            '國立勤益科技大學': '勤益 勤益科大 ncut',
            '國立屏東科技大學': '屏科 屏科大 npust',
            '國立臺灣藝術大學': '台藝大 臺藝大 台藝 ntua',
            '中山醫學大學': '中山醫 csmu',
            '高雄醫學大學': '高醫 高雄醫大 kmu',
            '中原大學': '中原 cycu',
            '輔仁大學': '輔大 fju',
            '嶺東科技大學': '嶺東 ltu',
        };

        // 將資料欄位安全地嵌入 innerHTML（避免含特殊字元的 JSON 破版或注入）。
        // content_html 是刻意保留的原始 HTML，不經過這個函式。
        function escapeHtml(value) {
            return String(value).replace(/[&<>"']/g, (c) => (
                { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
            ));
        }

        const interviewGrid = document.getElementById('interview-grid');
        const modal = document.getElementById('interviewModal');
        const detail = DetailDialog.setup(modal);
        const filters = document.getElementById('category-filters');
        const searchBox = document.getElementById('search-box');
        const noResults = document.getElementById('no-results');
        const resultStatus = document.getElementById('result-status');
        // 筆數只在使用者改了條件之後念，第一次載入不念；打字時停 400 毫秒再念。
        let shownCount = 0;
        let announceTimer;
        function announceCount(delay = 0) {
            clearTimeout(announceTimer);
            announceTimer = setTimeout(() => { resultStatus.textContent = `顯示 ${shownCount} 筆`; }, delay);
        }

        function renderInterviews(category = 'all', searchTerm = '') {
            interviewGrid.innerHTML = '';
            const lowerCaseSearchTerm = searchTerm.toLowerCase();

            const filteredData = interviewData.filter(p => {
                const inCategory = category === 'all' || p.category === category;
                const aliasText = UNIVERSITY_ALIASES[p.university] || '';
                const inSearch = !searchTerm ||
                                 p.name.toLowerCase().includes(lowerCaseSearchTerm) ||
                                 p.major.toLowerCase().includes(lowerCaseSearchTerm) ||
                                 p.university.toLowerCase().includes(lowerCaseSearchTerm) ||
                                 aliasText.includes(lowerCaseSearchTerm) ||
                                 p.quote.toLowerCase().includes(lowerCaseSearchTerm) ||
                                 p.category.toLowerCase().includes(lowerCaseSearchTerm);
                return inCategory && inSearch;
            });

            shownCount = filteredData.length;
            if (filteredData.length === 0) {
                noResults.classList.remove('hidden');
            } else {
                noResults.classList.add('hidden');
            }

            filteredData.forEach((item, index) => {
                const card = document.createElement('div');
                card.className = 'interview-card bg-white rounded-lg shadow-lg overflow-hidden cursor-pointer flex flex-col fade-in';
                card.style.animationDelay = `${index * 50}ms`;
                card.dataset.id = item.id;
                card.innerHTML = `
                    <div class="p-6 flex-grow flex flex-col">
                        <p class="text-sm font-bold text-purple-600 mb-2">${escapeHtml(item.category)}</p>
                        <blockquote class="text-lg font-semibold text-gray-800 flex-grow">“${escapeHtml(item.quote)}”</blockquote>
                    </div>
                    <div class="p-6 bg-gray-50 flex items-center border-t">
                        <img src="${encodeURI(item.photo_url)}" alt="${escapeHtml(item.name)}" class="w-12 h-12 rounded-full mr-4 object-cover bg-gray-200" onerror="this.onerror=null;this.src='https://api.dicebear.com/7.x/initials/svg?seed=${encodeURIComponent(item.name)}';">
                        <div>
                            <h2 class="font-bold text-gray-900"><button type="button" class="text-left cursor-pointer">${escapeHtml(item.name)}</button></h2>
                            <p class="text-sm text-gray-600">${escapeHtml(item.university)} ${escapeHtml(item.major)}</p>
                        </div>
                    </div>
                `;
                // 整張卡片都可以點；鍵盤和螢幕閱讀器用化名的按鈕，按下時一樣冒泡到這裡。
                const button = card.querySelector('h2 button');
                card.onclick = () => showModal(item.id, button);
                interviewGrid.appendChild(card);
            });
        }

        function showModal(id, opener) {
            const item = interviewData.find(p => p.id === id);
            if (!item) return;

            const tipsHtml = item.tips.map(tip => `
                <div class="flex items-start gap-3 p-3 bg-purple-50 rounded-lg">
                    <i data-feather="check-circle" class="w-5 h-5 text-purple-600 mt-1 flex-shrink-0"></i>
                    <div>
                        <h4 class="font-bold text-gray-800">${escapeHtml(tip.title)}</h4>
                        <p class="text-sm text-gray-600">${escapeHtml(tip.desc)}</p>
                    </div>
                </div>
            `).join('');

            modal.innerHTML = `
                <div class="p-6 border-b flex justify-between items-start">
                    <div class="flex items-center gap-4">
                        <img src="${encodeURI(item.photo_url)}" alt="${escapeHtml(item.name)}" class="w-20 h-20 rounded-full object-cover shadow-md bg-gray-200" onerror="this.onerror=null;this.src='https://api.dicebear.com/7.x/initials/svg?seed=${encodeURIComponent(item.name)}';">
                        <div>
                            <h3 id="modal-title" class="text-2xl font-bold">${escapeHtml(item.name)}</h3>
                            <p class="text-purple-600 font-semibold">${escapeHtml(item.university)} ${escapeHtml(item.major)}</p>
                        </div>
                    </div>
                    <button type="button" onclick="hideModal()" aria-label="關閉" class="text-gray-400 hover:text-gray-800 p-1 rounded-full transition-colors"><i data-feather="x" class="w-7 h-7"></i></button>
                </div>
                <div class="border-b border-gray-200">
                    <nav class="modal-tabs -mb-px flex space-x-6 px-6" role="tablist">
                        <button type="button" role="tab" id="tab-interview" aria-controls="panel-interview" aria-selected="true" class="tab-btn active border-b-2 font-semibold py-4 px-1 text-sm" onclick="showTabContent(this, 'interview')">訪談內容</button>
                        <button type="button" role="tab" id="tab-tips" aria-controls="panel-tips" aria-selected="false" tabindex="-1" class="tab-btn border-b-2 border-transparent font-semibold py-4 px-1 text-sm text-gray-500 hover:text-gray-700" onclick="showTabContent(this, 'tips')">探索TIPS</button>
                    </nav>
                </div>
                <div class="p-6 overflow-y-auto flex-grow">
                    <div id="panel-interview" role="tabpanel" aria-labelledby="tab-interview" tabindex="0" class="tab-content-interview">${item.content_html}</div>
                    <div id="panel-tips" role="tabpanel" aria-labelledby="tab-tips" tabindex="0" class="tab-content-tips hidden space-y-4">${tipsHtml}</div>
                </div>
                <div class="p-4 bg-gray-50 border-t flex justify-end">
                    <p id="copy-status" role="status" class="sr-only"></p>
                    <button type="button" onclick="copyLinkToClipboard('${id}')" class="flex items-center gap-2 bg-purple-600 text-white font-bold py-2 px-4 rounded-lg hover:bg-purple-700 transition-colors">
                        <i data-feather="copy" class="w-4 h-4"></i>
                        複製此訪談連結
                    </button>
                </div>
            `;

            detail.open(opener);
            feather.replace();
            showTabContent(modal.querySelector('.tab-btn.active'), 'interview');
        }

        function hideModal() {
            detail.close();
        }

        // 從 ?view= 開啟的訪談，關閉後把參數拿掉，重新整理才不會又打開。按 Esc 關閉時不會經過 hideModal。
        modal.addEventListener('close', () => {
            const url = new URL(window.location.href);
            if (!url.searchParams.has('view')) return;
            url.searchParams.delete('view');
            history.replaceState(history.state, '', url);
        });

        function showTabContent(btn, tabName) {
            const modalTabs = btn.closest('.modal-tabs');
            modalTabs.querySelectorAll('.tab-btn').forEach(b => {
                b.classList.remove('active');
                b.setAttribute('aria-selected', 'false');
                b.tabIndex = -1;
            });
            btn.classList.add('active');
            btn.setAttribute('aria-selected', 'true');
            btn.tabIndex = 0;

            const contentArea = modal.querySelector('.overflow-y-auto');
            contentArea.querySelectorAll('[class^="tab-content-"]').forEach(c => c.classList.add('hidden'));
            contentArea.querySelector(`.tab-content-${tabName}`).classList.remove('hidden');
        }

        async function copyLinkToClipboard(id) {
            const url = new URL(window.location.href);
            url.searchParams.set('view', id);

            try {
                await navigator.clipboard.writeText(url.href);
            } catch {
                // 沒有 Clipboard API（例如非 HTTPS）時才用 textarea。對話框開著時，對話框外的元素都不能
                // 操作，textarea 要放在對話框裡。選取會移走焦點，複製完要放回去。
                const focused = document.activeElement;
                const textarea = document.createElement('textarea');
                textarea.value = url.href;
                modal.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                modal.removeChild(textarea);
                focused.focus();
            }

            const notification = document.getElementById('copy-notification');
            const status = document.getElementById('copy-status');
            notification.style.opacity = 1;
            status.textContent = notification.textContent.trim();
            setTimeout(() => {
                notification.style.opacity = 0;
                status.textContent = '';
            }, 2000);
        }

        function handleFilterAndSearch() {
            const activeCategory = filters.querySelector('.active').dataset.category;
            const searchTerm = searchBox.value;
            renderInterviews(activeCategory, searchTerm);
        }

        filters.addEventListener('click', (e) => {
            if (e.target.tagName === 'BUTTON') {
                const current = filters.querySelector('.active');
                current.classList.remove('active');
                current.setAttribute('aria-pressed', 'false');
                e.target.classList.add('active');
                e.target.setAttribute('aria-pressed', 'true');
                handleFilterAndSearch();
                announceCount();
            }
        });

        searchBox.addEventListener('input', () => { handleFilterAndSearch(); announceCount(400); });

        function checkUrlForModal() {
            const urlParams = new URLSearchParams(window.location.search);
            const viewId = urlParams.get('view');
            if (viewId && interviewData.some(p => p.id === viewId)) {
                showModal(viewId, interviewGrid.querySelector(`[data-id="${CSS.escape(viewId)}"] h2 button`));
            }
        }

        // 從 senior-interviews.json 載入資料後再渲染
        async function loadData() {
            try {
                const response = await fetch('senior-interviews.json', { cache: 'no-cache' });
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }
                const data = await response.json();
                interviewData = Array.isArray(data.interviews) ? data.interviews : [];
                renderInterviews();
                // 深連結（?view=<id>）需在資料載入後才能比對，故移到此處呼叫
                checkUrlForModal();
            } catch (error) {
                console.error('資料載入失敗：', error);
                const grid = document.getElementById('interview-grid');
                if (grid) {
                    grid.innerHTML = '<p class="col-span-full text-center text-gray-500 py-16">資料載入失敗，請稍後重新整理頁面。</p>';
                }
            }
        }
        loadData();
        feather.replace();
    </script>

    <style is:global>
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
            background-color: #f9f9fb;
        }
        .filter-btn.active {
            background-color: #9333ea;
            color: white;
            box-shadow: 0 4px 14px 0 rgb(147 51 234 / 38%);
        }
        .modal-content::backdrop {
            background-color: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(4px);
        }
        .modal-content {
            max-height: 90vh;
        }
        .interview-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .interview-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
        }
        .tab-btn.active {
            border-bottom-color: #a855f7;
            color: #a855f7;
            font-weight: 700;
        }
        .prose {
             --tw-prose-body: #374151;
             --tw-prose-headings: #111827;
             --tw-prose-links: #9333ea;
             --tw-prose-bold: #111827;
        }
        .fade-in {
            animation: fadeIn 0.5s ease-in-out forwards;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</BaseLayout>
