---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCluster, TOPICS } from '../../../../data/clusters';

// 60 個學群主題子頁，10 學群 × 6 主題，內容來自 clusters 集合。
export async function getStaticPaths() {
  const entries = await getCollection('clusters');
  return entries.map((entry) => {
    const [cluster, topic] = entry.id.split('/');
    return { params: { cluster, topic }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { cluster: clusterSlug, topic: topicSlug } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const cluster = getCluster(clusterSlug);
if (!cluster) {
  // 內容目錄存在但未在 src/data/clusters.ts 的 CLUSTERS 註冊時，建置期就明確失敗，
  // 免得安靜地產出麵包屑空白、連結失效的壞頁。
  throw new Error(`[topic].astro:未知學群 "${clusterSlug}",請在 src/data/clusters.ts 的 CLUSTERS 註冊`);
}
const { Content } = await render(entry);

const order = entry.data.order;
const prevTopic = TOPICS.find((t) => t.order === order - 1);
const nextTopic = TOPICS.find((t) => t.order === order + 1);
const hubHref = `${base}/career-exploration/clusters/${clusterSlug}/index.html`;
---

<BaseLayout
  title={`${entry.data.title} - ${cluster.name} - 台灣教育處方籤`}
  description={entry.data.description}
  keywords={`${cluster.name}, ${entry.data.topic}, 升學, 備審, 學習歷程`}
  currentSection="career-exploration"
>
  <main id="main-content" class="container mx-auto px-6 py-12">
    <!-- 麵包屑 -->
    <nav class="text-sm text-gray-500 mb-6" aria-label="麵包屑">
      <a href={`${base}/career-exploration/clusters/index.html`} class="underline hover:text-blue-600">十大學群探索</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <a href={hubHref} class="underline hover:text-blue-600">{cluster.name}</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-gray-700" aria-current="page">{entry.data.topic}</span>
    </nav>

    <article class="max-w-3xl mx-auto">
      <header class="mb-8 border-b border-gray-200 pb-6">
        <p class="text-sm font-semibold text-blue-600 mb-2">{cluster.name} · 主題 {order}/6</p>
        <h1 class="text-3xl md:text-4xl font-black text-gray-800">{entry.data.title}</h1>
      </header>

      <div class="prose prose-lg max-w-none md-content">
        <Content />
      </div>

      <!-- 同學群主題快速跳轉 -->
      <nav class="mt-12 pt-6 border-t border-gray-200" aria-label="同學群主題">
        <p class="text-sm font-semibold text-gray-500 mb-3">{cluster.name}的其他主題</p>
        <div class="flex flex-wrap gap-2">
          {
            TOPICS.map((t) => (
              <a
                href={`${base}/career-exploration/clusters/${clusterSlug}/${t.slug}.html`}
                class:list={[
                  'inline-block text-sm font-medium px-3 py-1 rounded-full',
                  t.slug === topicSlug
                    ? 'bg-blue-600 text-white'
                    : 'bg-gray-100 text-gray-700 hover:bg-blue-100',
                ]}
                aria-current={t.slug === topicSlug ? 'page' : undefined}
              >
                {t.name}
              </a>
            ))
          }
        </div>
      </nav>

      <!-- 上一篇 / 下一篇 -->
      <div class="mt-8 flex justify-between gap-4 text-sm">
        {
          prevTopic ? (
            <a
              href={`${base}/career-exploration/clusters/${clusterSlug}/${prevTopic.slug}.html`}
              class="text-blue-600 font-semibold hover:underline"
            >
              <span aria-hidden="true">&larr;</span> <span class="sr-only">上一篇：</span>{prevTopic.name}
            </a>
          ) : (
            <span />
          )
        }
        {
          nextTopic ? (
            <a
              href={`${base}/career-exploration/clusters/${clusterSlug}/${nextTopic.slug}.html`}
              class="text-blue-600 font-semibold hover:underline text-right"
            >
              <span class="sr-only">下一篇：</span>{nextTopic.name} <span aria-hidden="true">&rarr;</span>
            </a>
          ) : (
            <span />
          )
        }
      </div>

      <div class="mt-8 text-center">
        <a href={hubHref} class="text-gray-500 hover:text-blue-600">返回{cluster.name}指南目錄</a>
      </div>
    </article>
  </main>

  <style is:global>
    /* Markdown 表格在窄視窗會把整頁撐寬（實測 360px 視窗下溢出 27px，手機上會
       左右晃）。內容來自 src/content/clusters 底下的 Markdown，作者無法逐一控制欄寬，
       所以在渲染層讓表格自己橫向捲動，而不是讓它撐破版面。
       捲動的是 src/markdown/a11y-plugins.mjs 包在表格外面的 .table-scroll，表格維持 display: table。
       寬度用 fit-content 加 margin auto，比內文欄窄的表格才會置中；寬的表格仍以 100% 為上限。
       prose-lg 給表格的字級、行高和上下邊距搬到外框，表格內的字和間距才跟原本一樣。 */
    .md-content .table-scroll {
      width: fit-content;
      max-width: 100%;
      margin-inline: auto;
      margin-block: 2em;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      font-size: 0.8888889em;
      line-height: 1.5;
    }
    .md-content .table-scroll > table {
      margin-block: 0;
      font-size: inherit;
      line-height: inherit;
    }
    /* 還能捲的那一側顯示陰影，讀者才知道表格可以橫滑。data-more-left／right 由下方的 script 依捲動位置標上。 */
    .md-content .table-scroll[data-more-left] {
      background: radial-gradient(farthest-side at 0 50%, rgb(0 0 0 / 0.18), transparent) left / 0.75rem 100% no-repeat;
    }
    .md-content .table-scroll[data-more-right] {
      background: radial-gradient(farthest-side at 100% 50%, rgb(0 0 0 / 0.18), transparent) right / 0.75rem 100% no-repeat;
    }
    .md-content .table-scroll[data-more-left][data-more-right] {
      background:
        radial-gradient(farthest-side at 0 50%, rgb(0 0 0 / 0.18), transparent) left / 0.75rem 100% no-repeat,
        radial-gradient(farthest-side at 100% 50%, rgb(0 0 0 / 0.18), transparent) right / 0.75rem 100% no-repeat;
    }
    /* prose 的儲存格垂直對齊是 baseline，同一列有一格換行時短的那格會貼在上緣。
       窄視窗下欄位會先被壓到一字一行才輪到表格捲動，最小寬度讓放不下的表格改成捲動；
       4.875em 讓四欄表在 360px 的內文欄（312px）剛好放得下，不會只超出幾 px。 */
    .md-content th,
    .md-content td {
      min-width: 4.875em;
      text-align: start;
      vertical-align: middle;
    }
  </style>
  <script is:inline>
    // 表格外框沒露出的那一側標上 data-more-left／right。載入、視窗改寬、字型變寬都由 ResizeObserver 觸發，
    // 外框寬度被限制在 100% 時只有表格變寬，所以兩者都觀察。不支援的瀏覽器維持沒有陰影。
    // 要捲的外框才是有名稱、可以用 Tab 移到的區塊，報讀器使用者靠它用方向鍵捲動。
    if (window.ResizeObserver) {
      document.querySelectorAll('.md-content .table-scroll').forEach(function (box) {
        function update() {
          var rest = box.scrollWidth - box.clientWidth - box.scrollLeft;
          box.toggleAttribute('data-more-left', box.scrollLeft > 1);
          box.toggleAttribute('data-more-right', rest > 1);
          var scrolls = box.scrollWidth - box.clientWidth > 1;
          if (scrolls === box.hasAttribute('tabindex')) return;
          if (scrolls) {
            box.setAttribute('role', 'region');
            box.setAttribute('aria-label', box.dataset.label);
            box.tabIndex = 0;
          } else {
            box.removeAttribute('role');
            box.removeAttribute('aria-label');
            box.removeAttribute('tabindex');
          }
        }
        box.addEventListener('scroll', update, { passive: true });
        var observer = new ResizeObserver(update);
        observer.observe(box);
        if (box.firstElementChild) observer.observe(box.firstElementChild);
      });
    }
  </script>
</BaseLayout>
