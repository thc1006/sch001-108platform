---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { CLUSTERS, TOPICS } from '../../../../data/clusters';

// 學群中心頁 —— 每頁列出該學群的 6 個主題。
export async function getStaticPaths() {
  return CLUSTERS.map((c) => ({ params: { cluster: c.slug }, props: { cluster: c } }));
}

const { cluster } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const entries = (
  await getCollection('clusters', (e) => e.id.startsWith(`${cluster.slug}/`))
).sort((a, b) => a.data.order - b.data.order);

// 建置期一致性檢查:每個註冊的學群都必須備齊 6 個主題內容檔。
if (entries.length !== TOPICS.length) {
  throw new Error(
    `[cluster]/index.astro:學群「${cluster.name}」應有 ${TOPICS.length} 個主題,實際載入 ${entries.length} 個 —— 請檢查 src/content/clusters/${cluster.slug}/`,
  );
}
---

<BaseLayout
  title={`${cluster.name}升學指南 - 台灣教育處方籤`}
  description={`${cluster.name}完整升學指南:涵蓋科系定位、教授選才特質、多元表現策略、自主學習方向、常見迷思與備審面試要點。`}
  keywords={`${cluster.name}, ${cluster.shortName}, 升學, 選系, 備審, 學習歷程`}
  currentSection="career-exploration"
  isSectionIndex
>
  <main id="main-content" class="container mx-auto px-6 py-12">
    <!-- 麵包屑 -->
    <nav class="text-sm text-gray-500 mb-6" aria-label="麵包屑">
      <a href={`${base}/career-exploration/clusters/index.html`} class="hover:text-blue-600">十大學群探索</a>
      <span class="mx-2">/</span>
      <span class="text-gray-700">{cluster.name}</span>
    </nav>

    <!-- Hero -->
    <section class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-black text-gray-800 mb-4">
        {cluster.name}<span class="gradient-text">升學指南</span>
      </h1>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">{cluster.description}</p>
    </section>

    <!-- 6 主題卡片 -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        entries.map((entry) => {
          const topicSlug = entry.id.split('/')[1];
          return (
            <a
              href={`${base}/career-exploration/clusters/${cluster.slug}/${topicSlug}.html`}
              class="feature-card block bg-white p-6 rounded-xl shadow-md border border-gray-100 hover:border-blue-300"
            >
              <div class="flex items-center gap-3 mb-2">
                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center text-sm">
                  {entry.data.order}
                </span>
                <h2 class="text-xl font-bold text-gray-800">{entry.data.topic}</h2>
              </div>
              <p class="text-gray-600 leading-relaxed">{entry.data.description}</p>
            </a>
          );
        })
      }
    </section>

    <div class="mt-12 text-center">
      <a
        href={`${base}/career-exploration/clusters/index.html`}
        class="text-blue-600 font-semibold hover:underline"
      >
        &larr; 返回十大學群探索
      </a>
    </div>
  </main>
</BaseLayout>
