# Only ignore these files in root directory (not in docs/)
/IMPLEMENTATION_SUMMARY.md
/gemini-api.md
/GEMINI_API_FIX_PLAN.md
/TESTING_GUIDE.md

# CLAUDE.md should always stay in root
CLAUDE.md

# Ignore agent files
.claude/agents/*

# Node.js dependencies
node_modules/
.npm/
.node_repl_history

# Playwright test results and reports
test-results/
playwright-report/
playwright/.cache/
# playwright.config.js 必須入版控：CI 靠它啟動 webServer 與指定 testDir。
# 先前被 ignore，導致設定檔只存在於本地——測試因此從來沒進過 CI，說明文件
# 也只好要求人工另開 npm run serve。

# Playwright MCP 瀏覽器工作階段的暫存輸出
/.playwright-mcp/

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp
.cache/

# 競賽資料看門狗產生的報告（CI 與本機執行 check-competitions.mjs 時產生）
/competition-report.md

# 公民科技專案地圖看門狗產生的報告（CI 與本機執行 check-civic-tech.mjs 時產生）
/civic-tech-report.md

# Astro 建置產物與快取
dist/
.astro/

# 故障注入用的暫存副本（腳本跑完會自己刪掉；崩在中途時不該被誤 commit）
/dist-faultcheck/
/.taxonomy-faultcheck/
/.deptree-faultcheck/

# 工作過程文件與本地研究資料：保留於本地、不納入版控
# （docs/ 為一次性工作文件、school/ 為本地研究資料,均不入版控）
docs/
school/

# lychee 內部連結檢查用的 GitHub Pages 路徑命名空間（CI 產生）
/.link-root/

# check-built-site 產出的外部網址 inventory（供排程健康檢查使用）
/.reports/

# 全站外部連結健檢產生的報告（CI 與本機執行 check-external-links.mjs 時產生）
/external-links-report.md

# 故障注入用的暫存副本（link-health.faults.mjs 產生，跑完就刪；
# 中途被中斷時留下的殘骸不該進版控）
/.faultcheck/
/scripts-faultcheck/

# 自架的第三方前端函式庫（scripts/vendor-assets.mjs 從 node_modules 複製）。
# 完全由 package-lock.json 推導得出，入版控只會造成「lockfile 更新了但 vendor
# 忘了重跑」的漂移；缺檔時 check:site 會在 CI 擋下。
/public/vendor/
