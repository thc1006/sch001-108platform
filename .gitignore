# 開頭的 / 讓這幾條只比對根目錄的檔案。
/IMPLEMENTATION_SUMMARY.md
/gemini-api.md
/GEMINI_API_FIX_PLAN.md
/TESTING_GUIDE.md

# CLAUDE.md 只留在本機，不進版控。
CLAUDE.md

# Claude Code 的 agent 定義檔
.claude/agents/*

# Claude Code 在 repo 內開的 git worktree。每個都是整份 repo 的 checkout，git 會把它們
# 當成未追蹤目錄列出來，淹掉真正該看的 git status。worktree 的存在本身由
# .git/worktrees 追蹤，不需要也不應該入版控。
.claude/worktrees/

# Playwright MCP 的頁面快照。除錯時每次操作都會落一個 .yml，是過程產物不是資產。
.playwright-mcp/

# Node.js 相依套件
node_modules/
.npm/
.node_repl_history

# Playwright 測試結果與報告
test-results/
playwright-report/
playwright/.cache/
# playwright.config.js 必須入版控：CI 靠它啟動 webServer 與指定 testDir。

# Playwright MCP 瀏覽器工作階段的暫存輸出
/.playwright-mcp/

# 作業系統和編輯器自動產生的檔案
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# 編輯器的專案設定
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 記錄檔
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 環境變數檔
# Vite／Astro 建置時會讀 .env.[mode]（例如 .env.production）；閘道網址這類設定一律走環境變數
# 或 repository variable，不進 repo
.env
.env.*

# 暫存檔
*.tmp
*.temp
.cache/

# 競賽資料看門狗產生的報告（CI 與本機執行 check-competitions.mjs 時產生）
/competition-report.md

# 公民科技專案地圖看門狗產生的報告（CI 與本機執行 check-civic-tech.mjs 時產生）
/civic-tech-report.md

# Astro 建置產物與快取
dist/
.astro/

# 故障注入用的暫存副本（腳本跑完會自己刪掉；崩在中途時不該被誤 commit）
/dist-faultcheck/
/.taxonomy-faultcheck/
/.deptree-faultcheck/
/.vendorsize-faultcheck/
/.activity-faultcheck/

# 工作過程文件與本地研究資料：保留於本地、不納入版控
# （docs/ 為一次性工作文件、school/ 為本地研究資料,均不入版控）
docs/
school/

# lychee 內部連結檢查用的 GitHub Pages 路徑命名空間（CI 產生）
/.link-root/

# check-built-site 產出的外部網址 inventory（供排程健康檢查使用）
/.reports/

# 全站外部連結健檢產生的報告（CI 與本機執行 check-external-links.mjs 時產生）
/external-links-report.md

# 故障注入用的暫存副本（link-health.faults.mjs 產生，跑完就刪；
# 中途被中斷時留下的殘骸不該進版控）
/.faultcheck/
/scripts-faultcheck/

# 自架的第三方前端函式庫（scripts/vendor-assets.mjs 從 node_modules 複製）。
# 完全由 package-lock.json 推導得出，入版控只會造成「lockfile 更新了但 vendor
# 忘了重跑」的漂移；缺檔時 check:site 會在 CI 擋下。
/public/vendor/
# audit-quote-freshness.mjs 的 PDF 暫存目錄（跑完自刪，中斷時可能殘留）
/.quote-audit-tmp/

# 故障注入矩陣的工作副本。腳本結束時會自己刪掉，這裡是為了中途失敗的情況。
.deptree-faultcheck/
.installgate-faultcheck/
